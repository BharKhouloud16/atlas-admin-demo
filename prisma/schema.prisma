// Base de données Atlas Quality Partners
// Deux modules publics : Connexion (/connexion) et Inscription (/inscription)
// 3 rôles : ADMIN (créé manuellement, jamais par inscription publique),
// INGENIEUR (s'inscrit lui-même, compte en attente jusqu'à validation admin),
// CLIENT (s'inscrit lui-même, espace suivi + documents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  SALARIE
  FREELANCE
  PORTAGE
}

enum Role {
  ADMIN // accès complet : clients, profils, hypothèses, tous les contrats, coûts internes, validation des inscriptions
  INGENIEUR // s'inscrit lui-même ; voit uniquement ses propres missions, aucune donnée tarifaire
  CLIENT // s'inscrit lui-même ; voit le suivi et les documents de ses propres missions uniquement
}

enum StatutDocument {
  RAPPORT_AUDIT
  CONTRAT
  FACTURE
  AUTRE
}

// Compte de connexion — un seul par email, quel que soit le rôle.
// Un compte auto-inscrit (INGENIEUR ou CLIENT) démarre avec actif=false :
// il ne peut pas se connecter tant qu'un ADMIN ne l'a pas validé.
model User {
  id       String @id @default(cuid())
  email    String @unique
  passwordHash String
  role     Role
  actif    Boolean @default(true) // false pour tout compte auto-inscrit, en attente de validation
  createdAt DateTime @default(now())

  // Traçabilité pour la nouvelle rubrique Admin "Ingénieurs" (liste des
  // comptes validés, voir /admin/ingenieurs) : quand le compte a été validé
  // par un Admin, et sa toute première connexion réussie.
  valideLe DateTime?
  premiereConnexionLe DateTime?

  // Vérification de l'adresse email à l'inscription (voir lib/email.ts,
  // app/api/auth/verifier-email/route.ts). Par défaut true pour ne jamais
  // bloquer un compte déjà existant (ADMIN créé en base, ou comptes créés
  // avant l'ajout de cette fonctionnalité) : seule l'inscription publique
  // (/api/auth/signup) le met explicitement à false pour un nouveau compte
  // INGENIEUR/CLIENT, le temps que le lien envoyé par email soit cliqué.
  emailVerifie Boolean @default(true)
  emailVerificationToken String? @unique
  emailVerificationExpire DateTime?

  // Reinitialisation de mot de passe oublie (B14). Colonnes nullables, jamais renseignees par defaut, a usage unique.
  resetPasswordToken String? @unique
  resetPasswordExpire DateTime?

  // Désactivation temporaire du compte par l'ingénieur lui-même (voir
  // /ingenieur -> "Mon compte"). Un compte désactivé peut toujours se
  // reconnecter (contrairement à actif=false) mais est redirigé vers
  // /ingenieur/compte-desactive tant qu'il ne s'est pas réactivé.
  desactive Boolean @default(false)
  desactiveLe DateTime?

  // Consentement RGPD au traitement des données (voir /confidentialite),
  // recueilli obligatoirement à l'inscription pour un compte INGENIEUR ou
  // CLIENT (case à cocher, voir /inscription). Sert de preuve de
  // consentement (horodatage) — n'affecte pas les comptes ADMIN, créés
  // manuellement en base.
  consentementRgpd Boolean @default(false)
  consentementRgpdLe DateTime?

  profilId String? @unique // renseigné pour un compte INGENIEUR : relie à sa fiche Profil (tarifs)
  profil   Profil? @relation(fields: [profilId], references: [id])

  clientId String? @unique // renseigné pour un compte CLIENT : relie à sa fiche Client
  client   Client? @relation(fields: [clientId], references: [id])

  // Verrouillage progressif après échecs de connexion successifs (voir
  // app/api/auth/login/route.ts, lib/rate-limit.ts) : ralentit un bruteforce
  // ciblé sur un compte précis sans dépendre d'un service externe type
  // Redis. Remis à zéro dès qu'une connexion réussit.
  echecsConnexion Int @default(0)
  verrouilleJusqua DateTime?

  // Authentification à deux facteurs (TOTP) — pour l'instant réservée au
  // rôle ADMIN (le compte le plus sensible, accès aux coûts/marges
  // internes). totpSecret reste vide tant que la configuration n'est pas
  // terminée (voir /admin -> "Sécurité", app/api/auth/2fa).
  totpSecret String?
  totpActif Boolean @default(false)
  totpCodesSecours String? // JSON string[] de codes à usage unique (hashés bcrypt)
}

// Throttle par IP sur les endpoints sensibles (connexion, inscription) —
// complète le verrouillage par compte ci-dessus : protège aussi contre un
// bruteforce réparti sur plusieurs emails (y compris des emails qui
// n'existent pas, contre lesquels le verrouillage par compte ne peut rien).
// Fenêtre glissante simple en base plutôt qu'un service externe (Redis...),
// suffisant pour le volume de cette démo — voir lib/rate-limit.ts.
model TentativeIp {
  id String @id @default(cuid())
  cle String @unique // ex. "login:1.2.3.4"
  compteur Int @default(0)
  fenetreDebut DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Journal d'audit des actions administratives sensibles (validation de
// compte, création d'un profil avec son TJM initial, rejet d'un CRA...) —
// voir lib/audit.ts. Attendu par tout client ESN/staffing sérieux : qui a
// fait quoi, et quand. Consultable dans /admin/journal.
model JournalActivite {
  id String @id @default(cuid())
  acteurEmail String
  acteurRole Role
  action String // ex. "validation_compte", "creation_profil", "rejet_cra"
  cible String? // id de l'entité concernée (userId, profilId, feuilleId...)
  detail String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// ATLAS OS — TRUST & SECURITY INTELLIGENCE FOUNDATION (Batch 16, 08/09/2026)
// Événement de sécurité TRANSVERSE (runtime), distinct de JournalActivite
// ci-dessus : JournalActivite trace des actions MÉTIER déjà accomplies
// (validation de compte, rejet CRA...) et reste inchangé (aucune
// modification, aucune duplication). EvenementSecurite trace tout
// événement PERTINENT POUR LA SÉCURITÉ, y compris les échecs et refus
// (échec de connexion, verrouillage, refus RBAC, génération de contrat) —
// ce que JournalActivite ne capture pas aujourd'hui (il n'écrit qu'en cas
// de succès d'une action métier). Voir lib/security/events.ts.
//
// Champ par champ, respecte le modèle transverse demandé : acteur
// (acteurEmail/acteurRole/acteurId), action, ressource
// (ressourceType/ressourceId), contexte (contexteIp/contexteRoute),
// résultat, timestamp (createdAt), severite, correlationId (regroupe
// plusieurs événements liés à une même requête/tentative).
//
// Aucune donnée sensible : jamais de mot de passe, token, secret, hash —
// voir lib/security/events.ts, detail est plafonné et jamais une stack
// trace. Écriture best-effort (même discipline que journaliser() /
// lib/audit.ts) : un échec d'écriture ne bloque jamais l'action réelle.
enum ResultatEvenementSecurite {
  SUCCES
  REFUSE
  ERREUR
}

enum SeveriteEvenementSecurite {
  INFO
  ATTENTION
  ALERTE
}

model EvenementSecurite {
  id String @id @default(cuid())
  correlationId String // regroupe les événements d'une même requête/tentative

  acteurEmail String?
  acteurRole Role?
  acteurId String?

  action String // vocabulaire fermé côté lib/security/events.ts, ex. "auth.login.echec"
  ressourceType String?
  ressourceId String?

  contexteIp String?
  contexteRoute String?

  resultat ResultatEvenementSecurite
  severite SeveriteEvenementSecurite @default(INFO)
  detail String? // texte court, jamais de secret/stack trace (plafonné en code)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([acteurEmail])
  @@index([correlationId])
}

// Interface de la boucle d'amélioration continue demandée (OBSERVE ->
// ANALYSE -> PROPOSE -> SIMULE -> VALIDATION HUMAINE -> CHANGE -> MESURE) :
// seuls OBSERVE (EvenementSecurite), ANALYSE (lib/security/runtime-signals.ts)
// et PROPOSE/VALIDATION HUMAINE (ce modèle + ses routes) existent à ce
// stade. AUCUN mécanisme d'application automatique (CHANGE) n'existe dans
// ce lot, et c'est volontaire — voir lib/security/runtime-risk.ts et
// app/api/security/propositions : une proposition ne modifie jamais seule
// une permission, une règle de sécurité ou une donnée. Elle reste à l'état
// PROPOSEE jusqu'à une décision humaine explicite (APPROUVEE/REJETEE),
// tracée (decideParEmail/decideLe/motifDecision) — et même APPROUVEE ne
// déclenche aujourd'hui aucune action automatique : la mise en œuvre reste
// manuelle, hors périmètre de ce lot (voir rapport final, limites).
enum StatutPropositionSecurite {
  PROPOSEE
  APPROUVEE
  REJETEE
}

model PropositionSecurite {
  id String @id @default(cuid())
  origine String // ex. "SIGNAL:acces_refuses_repetes" ou "MANUEL:admin-demo@example.com" — traçabilité de la source
  titre String
  description String
  statut StatutPropositionSecurite @default(PROPOSEE)
  proposeParEmail String? // null si générée depuis un signal plutôt que saisie par un humain
  proposeLe DateTime @default(now())
  decideParEmail String?
  decideLe DateTime?
  motifDecision String?

  @@index([statut])
  @@index([proposeLe])
}

// ============================================================================
// COMPANY ATLAS — B19 (08/09/2026) : AGENT IDENTITY FOUNDATION.
// Première fondation technique du Control Plane (Master Architecture V1,
// section D) : donner à COMPANY ATLAS un registre d'identités techniques
// pour ses 4 agents officiels, distinctes des comptes User humains
// (ADMIN/INGENIEUR/CLIENT). Périmètre strictement limité à B19 : un
// REGISTRE, rien d'autre — pas de permissions, pas de capabilities, pas
// d'authentification agent complète (voir lib/agents/identity.ts pour la
// limite documentée). Les 4 lignes sont créées de façon déterministe par
// la migration elle-même (voir migration.sql) : AUCUNE route de création
// n'existe (pas de POST), pour garantir qu'un 5e agent ne peut jamais être
// introduit, même par erreur applicative.
enum AgentOfficiel {
  PRINCIPAL
  ATLAS_TALENT
  ATLAS_OS_SERVICES
  COMPANY_OS
}

enum AgentIdentityStatut {
  ACTIVE
  DISABLED
}

model AgentIdentity {
  id String @id // volontairement PAS @default(cuid()) : les 4 lignes sont seedées avec un identifiant déterministe fixe par la migration (voir migration.sql), jamais généré à la volée — cohérent avec le caractère fermé et non créable de ce registre.

  agent AgentOfficiel @unique // vocabulaire fermé, exactement les 4 agents officiels — @unique interdit toute deuxième ligne pour le même agent
  nomTechnique String // nom technique stable, ex. "atlas-talent" — usage interne/documentation, ne sert pas encore de mécanisme d'authentification (voir limite ci-dessus)
  statut AgentIdentityStatut @default(ACTIVE)
  description String?
  version String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

model Client {
  id String @id @default(cuid())
  nom String // raison sociale
  pays String? // pays d'implantation du client (affiché dans l'historique de mission ingénieur, et sert à terme au calendrier de jours fériés des feuilles de temps)
  secteur String?
  contactReferent String? // nom de la personne de contact côté client
  email String?
  telephone String?
  identifiantEntreprise String? // RC / RNE selon le pays
  formeJuridique String? // SARL, SA, EURL, Auto-entrepreneur, etc.
  statutPreferere TypeContrat?
  dateDebutPrevue DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  missions Mission[]
  documents Document[]
  compte User? // le compte de connexion du client, une fois inscrit
  demandesTalent DemandeTalent[] // ATLAS TALENT (fondations, 06/09) — voir DemandeTalent
}

// Fiche interne d'un profil d'ingénieur. Créée automatiquement, vide de
// tarif, quand un ingénieur s'inscrit. Le type de contrat, le montant et le
// TJM ne sont plus fixés manuellement par l'Admin à la validation : ils sont
// déterminés après import + validation du CV (voir InfoCV), sur la base de
// l'analyse du profil (séniorité, compétences) — voir lib/analyse-profil.ts.
model Profil {
  id String @id @default(cuid())
  nom String // nom de famille (avant la refonte, contenait le nom complet — voir prenom)
  prenom String? // prénom, saisi séparément à l'inscription depuis la refonte du 4 sept.
  type TypeContrat?
  montantSaisi Float? // laissé vide jusqu'à ce qu'un contrat soit négocié

  cvUrl String?
  cvNomFichier String?
  cvImporteLe DateTime?
  cvValide Boolean @default(false)

  anneesExperience Int?
  seniorite String?
  pointsForts String?
  tjmEstime Float?
  typeContratSuggere TypeContrat?

  disponibilite String?
  disponibilitePrevue String?
  changerMissionActuelle Boolean?
  missionApres String?
  preavis String?
  preavisPrecision String?
  disponibiliteRenseigneeLe DateTime?
  questionnaireValide Boolean @default(false)

  nationalite String?
  nationalitePrecision String?
  paysResidence String?
  paysResidencePrecision String?
  regimeSuggere String?

  tjmSouhaite Float?
  tjmSouhaiteDevise String?

  competences String[] @default([])

  entretiensRealises Int @default(0)

  realisations Json?

  videoUrl String?
  videoNomFichier String?
  videoImporteLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  missions Mission[]
  infosCv InfoCV[]
  versionsCv VersionCv[]
  compte User?
  shortlistEntrees ShortlistEntree[]
  competencesGraph ProfilCompetence[]
}

model VersionCv {
  id String @id @default(cuid())
  profil Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId String
  cvUrl String
  cvNomFichier String?
  importeLe DateTime
  createdAt DateTime @default(now())

  @@index([profilId])
}

model InfoCV {
  id String @id @default(cuid())
  profil Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId String
  categorie String
  libelle String
  valeur String
  ordre Int @default(0)
  valide Boolean @default(false)
  createdAt DateTime @default(now())
}

model Mission {
  id String @id @default(cuid())
  repere String?
  client Client @relation(fields: [clientId], references: [id])
  clientId String
  profil Profil @relation(fields: [profilId], references: [id])
  profilId String
  nbJours Int
  margeCible Float @default(0.30)
  tjmVente Float
  deviseVente String @default("EUR")
  statut String @default("En cours") // En cours / Terminée / Annulée
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  feuillesDeTemps FeuilleDeTemps[]
  evaluation Evaluation?
}

model FeuilleDeTemps {
  id String @id @default(cuid())
  mission Mission @relation(fields: [missionId], references: [id])
  missionId String
  mois String // format "AAAA-MM"
  joursTravailles Float @default(0)
  heuresSupplementaires Float @default(0)
  commentaire String?
  detailJours Json?
  statut String @default("Brouillon")
  motifRejet String?
  soumiseLe DateTime?
  valideeAdminLe DateTime?
  valideeClientLe DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, mois])
}

model Evaluation {
  id String @id @default(cuid())
  mission Mission @relation(fields: [missionId], references: [id])
  missionId String @unique
  note Int
  commentaire String?
  createdAt DateTime @default(now())
}

model Document {
  id String @id @default(cuid())
  titre String
  type StatutDocument @default(AUTRE)
  fileUrl String
  mission Mission? @relation(fields: [missionId], references: [id])
  missionId String?
  client Client @relation(fields: [clientId], references: [id])
  clientId String
  createdAt DateTime @default(now())
}

model DemandeContact {
  id String @id @default(cuid())
  nom String
  email String
  entreprise String?
  telephone String?
  message String?
  creneauSouhaite String?
  traite Boolean @default(false)
  createdAt DateTime @default(now())
}

model Hypotheses {
  id String @id @default("singleton")
  joursAn Int @default(218)
  chargesSalarie Float @default(0.42)
  fraisFreelance Float @default(0.08)
  overhead Float @default(0.15)
  margeDefaut Float @default(0.30)
}

// ============================================================================
// ATLAS TALENT V1 — fondations (06/09/2026)
// ============================================================================

enum StatutDemandeTalent {
  SOUMISE
  ANALYSEE
  EN_MATCHING
  SHORTLIST_ENVOYEE
  CLOTUREE
}

model DemandeTalent {
  id String @id @default(cuid())
  client Client @relation(fields: [clientId], references: [id])
  clientId String
  titre String?
  description String
  statut StatutDemandeTalent @default(SOUMISE)

  competencesExtraites String[] @default([])
  senioriteSouhaitee String?
  anneesExperienceMin Int?
  secteurActivite String?
  localisation String?
  mobilite String?
  disponibiliteSouhaitee String?
  budgetTjmMax Float?
  budgetDevise String @default("EUR")
  dateDebutSouhaitee DateTime?
  analyseProvider String?
  analyseConfiance Float?
  analyseeLe DateTime?

  criteresModifiesParEmail String?
  criteresModifiesLe DateTime?

  shortlist ShortlistEntree[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum StatutShortlist {
  SUGGEREE
  VALIDEE
  REJETEE
}

model ShortlistEntree {
  id String @id @default(cuid())
  demande DemandeTalent @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String
  profil Profil @relation(fields: [profilId], references: [id])
  profilId String
  score Float
  confiance Float
  motifs Json
  statut StatutShortlist @default(SUGGEREE)
  valideParEmail String?
  valideLe DateTime?
  createdAt DateTime @default(now())

  @@unique([demandeId, profilId])
}

enum StatutPreuveCompetence {
  VERIFIE
  DECLARE
  INFERE
  INCONNU
}

enum NiveauConfiance {
  HAUTE
  MOYENNE
  BASSE
}

enum SourcePreuveCompetence {
  CV
  PROFIL
  CERTIFICATION
  MISSION
  EVALUATION
  ASSESSMENT
  ADMIN
}

model ProfilCompetence {
  id String @id @default(cuid())
  profil Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId String
  competence String
  niveau Int?
  anneesExperience Int?
  contexte String?
  secteur String?
  statut StatutPreuveCompetence @default(INCONNU)
  confiance NiveauConfiance @default(BASSE)
  preuves SkillEvidence[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profilId, competence])
  @@index([profilId])
}

model SkillEvidence {
  id String @id @default(cuid())
  profilCompetence ProfilCompetence @relation(fields: [profilCompetenceId], references: [id], onDelete: Cascade)
  profilCompetenceId String
  source SourcePreuveCompetence
  detail String?
  niveau Int?
  createdAt DateTime @default(now())

  @@index([profilCompetenceId])
}
