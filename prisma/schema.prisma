// Base de données Atlas Quality Partners
// Deux modules publics : Connexion (/connexion) et Inscription (/inscription)
// 3 rôles : ADMIN (créé manuellement, jamais par inscription publique),
// INGENIEUR (s'inscrit lui-même, compte en attente jusqu'à validation admin),
// CLIENT (s'inscrit lui-même, espace suivi + documents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  SALARIE
  FREELANCE
  PORTAGE
}

enum Role {
  ADMIN       // accès complet : clients, profils, hypothèses, tous les contrats, coûts internes, validation des inscriptions
  INGENIEUR   // s'inscrit lui-même ; voit uniquement ses propres missions, aucune donnée tarifaire
  CLIENT      // s'inscrit lui-même ; voit le suivi et les documents de ses propres missions uniquement
}

enum StatutDocument {
  RAPPORT_AUDIT
  CONTRAT
  FACTURE
  AUTRE
}

// Compte de connexion — un seul par email, quel que soit le rôle.
// Un compte auto-inscrit (INGENIEUR ou CLIENT) démarre avec actif=false :
// il ne peut pas se connecter tant qu'un ADMIN ne l'a pas validé.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  actif        Boolean  @default(true) // false pour tout compte auto-inscrit, en attente de validation
  createdAt    DateTime @default(now())

  // Traçabilité pour la nouvelle rubrique Admin "Ingénieurs" (liste des
  // comptes validés, voir /admin/ingenieurs) : quand le compte a été validé
  // par un Admin, et sa toute première connexion réussie.
  valideLe            DateTime?
  premiereConnexionLe DateTime?

  // Vérification de l'adresse email à l'inscription (voir lib/email.ts,
  // app/api/auth/verifier-email/route.ts). Par défaut true pour ne jamais
  // bloquer un compte déjà existant (ADMIN créé en base, ou comptes créés
  // avant l'ajout de cette fonctionnalité) : seule l'inscription publique
  // (/api/auth/signup) le met explicitement à false pour un nouveau compte
  // INGENIEUR/CLIENT, le temps que le lien envoyé par email soit cliqué.
  emailVerifie             Boolean   @default(true)
  emailVerificationToken   String?   @unique
  emailVerificationExpire  DateTime?

  // Désactivation temporaire du compte par l'ingénieur lui-même (voir
  // /ingenieur -> "Mon compte"). Un compte désactivé peut toujours se
  // reconnecter (contrairement à actif=false) mais est redirigé vers
  // /ingenieur/compte-desactive tant qu'il ne s'est pas réactivé.
  desactive    Boolean   @default(false)
  desactiveLe  DateTime?

  // Consentement RGPD au traitement des données (voir /confidentialite),
  // recueilli obligatoirement à l'inscription pour un compte INGENIEUR ou
  // CLIENT (case à cocher, voir /inscription). Sert de preuve de
  // consentement (horodatage) — n'affecte pas les comptes ADMIN, créés
  // manuellement en base.
  consentementRgpd    Boolean   @default(false)
  consentementRgpdLe  DateTime?

  profilId     String?  @unique // renseigné pour un compte INGENIEUR : relie à sa fiche Profil (tarifs)
  profil       Profil?  @relation(fields: [profilId], references: [id])

  clientId     String?  @unique // renseigné pour un compte CLIENT : relie à sa fiche Client
  client       Client?  @relation(fields: [clientId], references: [id])

  // Verrouillage progressif après échecs de connexion successifs (voir
  // app/api/auth/login/route.ts, lib/rate-limit.ts) : ralentit un bruteforce
  // ciblé sur un compte précis sans dépendre d'un service externe type
  // Redis. Remis à zéro dès qu'une connexion réussit.
  echecsConnexion  Int       @default(0)
  verrouilleJusqua DateTime?

  // Authentification à deux facteurs (TOTP) — pour l'instant réservée au
  // rôle ADMIN (le compte le plus sensible, accès aux coûts/marges
  // internes). totpSecret reste vide tant que la configuration n'est pas
  // terminée (voir /admin -> "Sécurité", app/api/auth/2fa).
  totpSecret       String?
  totpActif        Boolean  @default(false)
  totpCodesSecours String? // JSON string[] de codes à usage unique (hashés bcrypt)
}

// Throttle par IP sur les endpoints sensibles (connexion, inscription) —
// complète le verrouillage par compte ci-dessus : protège aussi contre un
// bruteforce réparti sur plusieurs emails (y compris des emails qui
// n'existent pas, contre lesquels le verrouillage par compte ne peut rien).
// Fenêtre glissante simple en base plutôt qu'un service externe (Redis...),
// suffisant pour le volume de cette démo — voir lib/rate-limit.ts.
model TentativeIp {
  id           String   @id @default(cuid())
  cle          String   @unique // ex. "login:1.2.3.4"
  compteur     Int      @default(0)
  fenetreDebut DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Journal d'audit des actions administratives sensibles (validation de
// compte, création d'un profil avec son TJM initial, rejet d'un CRA...) —
// voir lib/audit.ts. Attendu par tout client ESN/staffing sérieux : qui a
// fait quoi, et quand. Consultable dans /admin/journal.
model JournalActivite {
  id          String   @id @default(cuid())
  acteurEmail String
  acteurRole  Role
  action      String // ex. "validation_compte", "creation_profil", "rejet_cra"
  cible       String? // id de l'entité concernée (userId, profilId, feuilleId...)
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Client {
  id                  String    @id @default(cuid())
  nom                 String    // raison sociale
  pays                String?   // pays d'implantation du client (affiché dans l'historique de mission ingénieur, et sert à terme au calendrier de jours fériés des feuilles de temps)
  secteur             String?
  contactReferent     String?   // nom de la personne de contact côté client
  email               String?
  telephone           String?
  identifiantEntreprise String? // RC / RNE selon le pays
  formeJuridique      String?   // SARL, SA, EURL, Auto-entrepreneur, etc.
  statutPreferere     TypeContrat?
  dateDebutPrevue     DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  missions            Mission[]
  documents           Document[]
  compte              User?     // le compte de connexion du client, une fois inscrit
}

// Fiche interne d'un profil d'ingénieur. Créée automatiquement, vide de
// tarif, quand un ingénieur s'inscrit. Le type de contrat, le montant et le
// TJM ne sont plus fixés manuellement par l'Admin à la validation : ils sont
// déterminés après import + validation du CV (voir InfoCV), sur la base de
// l'analyse du profil (séniorité, compétences) — voir lib/analyse-profil.ts.
model Profil {
  id                  String       @id @default(cuid())
  nom                 String       // nom de famille (avant la refonte, contenait le nom complet — voir prenom)
  prenom              String?      // prénom, saisi séparément à l'inscription depuis la refonte du 4 sept.
  type                TypeContrat?
  montantSaisi        Float?       // laissé vide jusqu'à ce qu'un contrat soit négocié

  // Import & validation du CV (voir /ingenieur/cv et /ingenieur/cv/verifier)
  cvUrl               String?      // URL du fichier CV stocké (Vercel Blob)
  cvNomFichier        String?
  cvImporteLe         DateTime?
  cvValide            Boolean      @default(false) // true une fois toutes les InfoCV validées

  // Résultat de l'analyse du profil (déduit des InfoCV validées) — voir
  // lib/analyse-profil.ts. Champs laissés vides tant que l'analyse
  // automatique (IA) n'est pas branchée ; alimentables manuellement par
  // l'Admin en attendant.
  anneesExperience    Int?
  seniorite           String?      // "Junior" | "Confirmé" | "Senior" | "Expert"
  pointsForts         String?
  tjmEstime           Float?
  typeContratSuggere  TypeContrat?

  // Questionnaire de disponibilité (voir /ingenieur/disponibilite), rempli
  // juste après la validation du CV, avant l'accès à l'espace ingénieur
  // (voir app/ingenieur/page.tsx). Réponses à choix prédéfinis.
  disponibilite              String?   // "Disponible immédiatement" | "En mission actuellement chez Atlas" | "En mission actuellement chez un autre client" | "Non disponible immédiatement"
  disponibilitePrevue        String?   // prévision (date/période) donnée par l'ingénieur si disponibilite = "Non disponible immédiatement"
  changerMissionActuelle     Boolean?  // souhaite changer de mission actuelle (si en mission, Atlas ou autre client)
  missionApres               String?   // "Nouvelle mission anticipée" | "Libre juste après" | "Non concerné"
  preavis                    String?   // ex: "Aucun / immédiat", "1 mois"...
  preavisPrecision           String?   // précision libre si preavis = "Autre"
  disponibiliteRenseigneeLe  DateTime?
  questionnaireValide        Boolean   @default(false) // true une fois le questionnaire soumis

  // Localisation & régime adapté (voir lib/localisation.ts) — permet de
  // proposer un profil/contrat adapté à la situation de l'ingénieur
  // (France, Maghreb, Golfe, etc.). regimeSuggere est calculé
  // automatiquement à partir de paysResidence, à titre indicatif.
  nationalite                String?   // choisie dans une liste fermée (voir lib/localisation.ts, NATIONALITES)
  nationalitePrecision       String?   // précision libre si nationalite = "Autre"
  paysResidence              String?
  paysResidencePrecision     String?   // précision libre si paysResidence = "Autre"
  regimeSuggere              String?

  // Prétention salariale (TJM souhaité) déclarée par l'ingénieur, dans la
  // devise de son choix (internationale ou locale à son pays de
  // résidence) — voir lib/localisation.ts (DEVISES, convertirEnEur).
  // Permet à l'Admin de comparer avec tjmEstime et de proposer, à budget
  // client égal, le profil le plus compétitif selon la localisation.
  tjmSouhaite                Float?
  tjmSouhaiteDevise          String?

  // Compétences techniques structurées, choisies dans une liste fermée
  // groupée par catégorie (voir lib/competences.ts) — renseignées par
  // l'ingénieur lui-même (voir /ingenieur/disponibilite et
  // EspaceIngenieur.tsx), utilisées côté Admin pour filtrer/rechercher les
  // profils par compétence dans le tableau de matching (/admin/profils).
  competences                String[]  @default([])

  // Nombre d'entretiens clients réalisés par l'ingénieur via Atlas — saisi
  // manuellement par l'Admin (voir /admin/profils, pas de module
  // d'entretiens dédié pour l'instant) et affiché à l'ingénieur dans ses
  // statistiques personnelles (voir EspaceIngenieur.tsx).
  entretiensRealises         Int          @default(0)

  // Portfolio de réalisations concrètes, façon Malt : distinct de
  // l'expérience déclarative extraite du CV (InfoCV, catégorie
  // "experience") — ici l'ingénieur met en avant jusqu'à 10 réalisations
  // (titre, description, lien optionnel) visibles par l'Admin et servant
  // à convaincre un client. Voir app/api/ingenieur/realisations/route.ts.
  // Stocké en JSON plutôt qu'un modèle dédié pour rester simple (pas de
  // relation, pas de tri serveur nécessaire) : [{id, titre, description,
  // lien}, ...].
  realisations               Json?

  // Courte vidéo de présentation (60-90s conseillé), façon "CV vidéo" —
  // tendance recrutement 2026, humanise le profil avant l'appel client.
  // Même mécanisme de stockage privé que le CV (voir lib/storage.ts,
  // app/api/ingenieur/video/route.ts) : jamais d'URL publique, servi via
  // une route authentifiée (Ingénieur propriétaire, Admin, ou Client ayant
  // une mission avec ce profil — voir app/api/ingenieur/video/fichier).
  videoUrl                   String?
  videoNomFichier             String?
  videoImporteLe              DateTime?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  missions            Mission[]
  infosCv             InfoCV[]
  versionsCv          VersionCv[]
  compte              User?
}

// Historique des versions du CV — "gap technique" demandé le 4 sept. À
// chaque nouvel import (voir POST /api/ingenieur/cv), la version PRÉCÉDENTE
// (cvUrl/cvNomFichier/cvImporteLe encore en place à ce moment-là) est
// archivée ici avant d'être écrasée sur Profil, plutôt que perdue. Le
// fichier Blob de chaque ancienne version reste stocké (jamais supprimé) :
// consultable par l'Admin sur /admin/profils, ou par l'ingénieur lui-même,
// voir GET /api/ingenieur/cv/historique et
// GET /api/ingenieur/cv/fichier?versionId=...
model VersionCv {
  id            String   @id @default(cuid())
  profil        Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId      String
  cvUrl         String
  cvNomFichier  String?
  importeLe     DateTime // date d'import d'ORIGINE de cette version (pas la date d'archivage)
  createdAt     DateTime @default(now())

  @@index([profilId])
}

// Une information extraite (ou saisie) du CV d'un ingénieur, validée
// individuellement (bouton "OK") avant d'alimenter son profil. Aujourd'hui
// pré-remplie à vide (saisie manuelle guidée) ; conçue pour être pré-remplie
// automatiquement dès qu'un service d'extraction IA est branché (voir
// lib/cv-extraction.ts).
model InfoCV {
  id         String   @id @default(cuid())
  profil     Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId   String
  categorie  String   // "identite" | "contact" | "profil" | "competence" | "experience" | "formation"
  libelle    String   // ex: "Nom complet", "Compétences principales"
  valeur     String
  ordre      Int      @default(0)
  valide     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Mission {
  id            String     @id @default(cuid())
  repere        String?
  client        Client     @relation(fields: [clientId], references: [id])
  clientId      String
  profil        Profil     @relation(fields: [profilId], references: [id])
  profilId      String
  nbJours       Int
  margeCible    Float      @default(0.30)
  tjmVente      Float
  statut        String     @default("En cours") // En cours / Terminée / Annulée
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
  feuillesDeTemps FeuilleDeTemps[]
  evaluation      Evaluation?
}

// Compte-rendu d'activité (CRA) mensuel, façon BoondManager/portage salarial :
// l'ingénieur déclare ses jours travaillés + heures sup pour une mission et
// un mois donnés, puis le CRA suit un circuit de double validation avant
// facturation — Admin d'abord, Client ensuite (voir app/api/feuilles-de-temps
// et EspaceIngenieur.tsx, /admin/feuilles-de-temps, /client). Un seul CRA par
// mission et par mois (@@unique).
model FeuilleDeTemps {
  id                     String    @id @default(cuid())
  mission                Mission   @relation(fields: [missionId], references: [id])
  missionId              String
  mois                   String    // format "AAAA-MM"
  joursTravailles        Float     @default(0)
  heuresSupplementaires  Float     @default(0)
  commentaire            String?
  // Détail jour par jour saisi via le calendrier façon Boond (voir
  // components/CalendrierCra.tsx) : [{date:"2026-09-01", travaille:true,
  // heures:8, commentaire:null}, ...]. joursTravailles/heuresSupplementaires
  // ci-dessus restent les totaux dérivés (utilisés par l'Admin/Client et les
  // anciennes feuilles saisies avant ce calendrier, qui n'ont pas ce détail).
  detailJours            Json?
  // Brouillon (édition libre par l'ingénieur) -> Soumise (verrouillée, en
  // attente Admin) -> ValideeAdmin (en attente Client) -> ValideeClient
  // (définitive, facturable) ; Rejetee renvoie à l'ingénieur avec motifRejet,
  // ré-éditable comme un Brouillon.
  statut                 String    @default("Brouillon")
  motifRejet             String?
  soumiseLe              DateTime?
  valideeAdminLe         DateTime?
  valideeClientLe        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([missionId, mois])
}

// Évaluation du client sur une mission terminée — preuve sociale simple pour
// l'ingénieur (façon avis client Malt), affichée dans ses statistiques
// personnelles (voir EspaceIngenieur.tsx) et consultable par l'Admin. Une
// seule évaluation par mission (relation 1-1 côté Mission).
model Evaluation {
  id           String   @id @default(cuid())
  mission      Mission  @relation(fields: [missionId], references: [id])
  missionId    String   @unique
  note         Int      // 1 à 5
  commentaire  String?
  createdAt    DateTime @default(now())
}

// Document consultable par le client dans son espace (rapport d'audit,
// contrat signé, facture...). fileUrl pointe vers un stockage externe
// (Supabase Storage, S3...) — voir lib/storage.ts.
model Document {
  id         String         @id @default(cuid())
  titre      String
  type       StatutDocument @default(AUTRE)
  fileUrl    String
  mission    Mission?       @relation(fields: [missionId], references: [id])
  missionId  String?
  client     Client         @relation(fields: [clientId], references: [id])
  clientId   String
  createdAt  DateTime       @default(now())
}

// Demande de contact / prise de rendez-vous depuis le site public (page
// d'accueil, bouton "Reserver un appel de 30 minutes" et formulaire de
// contact -- voir app/reserver-appel/page.tsx). Volontairement en acces
// libre, SANS creation de compte : on ne recupere qu'un minimum
// d'informations, l'equipe Atlas recontacte ensuite pour caler l'appel.
// Consultee et traitee cote Admin (voir app/admin/demandes/page.tsx).
model DemandeContact {
id              String   @id @default(cuid())
nom             String
email           String
entreprise      String?
telephone       String?
message         String?
creneauSouhaite String?
traite          Boolean  @default(false)
createdAt       DateTime @default(now())
}

model Hypotheses {
  id                 String @id @default("singleton")
  joursAn            Int    @default(218)
  chargesSalarie     Float  @default(0.42)
  fraisFreelance     Float  @default(0.08)
  overhead           Float  @default(0.15)
  margeDefaut        Float  @default(0.30)
}
