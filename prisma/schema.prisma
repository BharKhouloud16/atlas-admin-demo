  // directe ne le renseignant pas explicitement (fixé par la migration de
  // suivi 20260930193500 — la seule route applicative qui crée un
  // ClientNeed, app/api/client/besoins/route.ts, le renseigne déjà
  // explicitement et n'est pas affectée par ce défaut).
  lifecycleStatut    NeedLifecycleStatut       @default(UNDERSTANDING)
  // LOT A — gate A0 §5 : marqueur de traçabilité historique UNIQUEMENT.
  // Ne constitue PAS un état de lifecycle. Posé au backfill sur les Need
  // dont le statut historique n'est pas BROUILLON/DRAFT mais qui ne
  // possèdent aucun ClientNeedFait (334 lignes identifiées par le gate A0) —
  // jamais réinterprété, jamais utilisé pour forcer un retour à DRAFT.
  legacyPreInvariant Boolean                   @default(false)
  // LOT A — A5 Need versioning. `version`=1 pour toute ligne créée avant ce
  // lot ou directement (pas encore de modification post-VALIDATED déclenchée
  // dans ce lot — voir rapport final, point STOP). `needParentId` pointe
  // vers la version précédente de la même lignée ; `needSuivantId` (posé sur
  // l'ancienne version) pointe vers la version qui la remplace. Version
  // courante d'une lignée = celle dont needSuivantId est NULL. Jamais de
  // réécriture d'une version existante.
  version            Int                       @default(1)
  // A5.2 — contrainte anti-bifurcation (gate A5.1 §18/§20) : un parent ne
  // peut avoir qu'un seul enfant. NULL reste autorisé et non contraint par
  // Postgres (plusieurs Need racines indépendants restent possibles) ;
  // seule une deuxième ligne non-NULL portant la MÊME valeur est rejetée.
  needParentId       String?                   @unique
  needParent         ClientNeed?               @relation("ClientNeedVersionChain", fields: [needParentId], references: [id])
  needVersionsFilles ClientNeed[]              @relation("ClientNeedVersionChain")
  needSuivantId      String?
  coherenceStatut    ClientNeedCoherenceStatut @default(UNKNOWN)
  // Liste de {regle, statut, explication} — voir lib/client-need/coherence.ts.
  coherenceDetail    Json?
  analyseProvider    String?
  analyseeLe         DateTime?
  faits              ClientNeedFait[]
