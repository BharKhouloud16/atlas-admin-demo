  // toujours écrite avec statut INFERE, jamais consommée par une décision
  // ou une règle de cohérence dans ce lot. Le nom porte "HYPOTHESE"
  // explicitement pour ne jamais être confondue avec une décision de
  // routage réelle.
  HYPOTHESE_DOMAINE_SOLUTION
