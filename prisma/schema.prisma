//
// V2.1-A ne crée que le socle : aucune logique de calcul, de comparaison,
// d'adaptation Talent→Client ni de décision n'est implémentée ici (voir
// V2.1-B/C/D). FAIT et SIGNAL ne sont volontairement jamais persistés comme
// SolutionOption (calculés à la volée en amont, même principe que le signal
// de récurrence de ClientProfile) — seules HYPOTHESE et les niveaux
// suivants donnent lieu à une ligne.
model SolutionOption {
  id              String                  @id @default(cuid())
  need            ClientNeed              @relation(fields: [needId], references: [id], onDelete: Cascade)
  needId          String
  // Dénormalisé depuis need.clientId — vérification d'ownership directe en
  // une seule lecture, même patron que Document/Message ; ne provient et ne
  // doit jamais provenir d'une entrée utilisateur (session uniquement, côté
  // API — aucune API n'est créée dans cette étape).
  client          Client                  @relation(fields: [clientId], references: [id])
  clientId        String
  niveau          NiveauCertitudeSolution
  typeSolution    TypeSolution
  titre           String
  justification   String
  // Evidence structurée (compétences correspondantes, contraintes
  // satisfaites/non satisfaites, etc.) — jamais une copie des données
  // sources (ClientNeedFait/DemandeTalent), même rôle que
  // ShortlistEntree.motifs côté staffing interne.
  donnees         Json
  // Auto-référence traçant la chaîne (RECOMMANDATION pointe vers la ou les
  // OPTION dont elle dérive, DECISION pointe vers la RECOMMANDATION
  // décidée) — volontairement une simple colonne, pas une relation Prisma,
  // même mécanisme que ClientProfileFact.confirmeDepuis : aucune contrainte
  // FK, résolue en code applicatif (V2.1-B/D), jamais de mutation en place.
  sourceOptionId  String?
  // Référence de traçabilité pure vers une DemandeTalent existante, jamais
  // une relation Prisma complète : une relation forcerait un champ inverse
  // sur DemandeTalent, donc une modification de ce modèle, explicitement
  // exclue de ce lot. Renseigné uniquement quand typeSolution=TALENT et
  // qu'une DemandeTalent a déjà été créée par un Admin (LOT 5, inchangé) —
  // jamais créée automatiquement depuis C3.
  demandeTalentId String?
  // Renseignés uniquement quand niveau=DECISION — aucune logique de
  // décision n'est implémentée dans cette étape (voir V2.1-D).
  decideParEmail  String?
  decideLe        DateTime?
  // LOT A — A5, gate A0 §7/§9 : identifiant de la version du Need à
  // l'origine de cette ligne. Rempli depuis `signatureSource` (déjà calculé
  // par calculerSignatureSource, lib/client-solution/signature.ts) quand
  // disponible ; sinon la chaîne littérale "INCONNU" — jamais la date, la
  // version courante, le dernier Need ou toute autre heuristique de
  // substitution (interdiction explicite du gate A0, notamment pour les 24
  // lignes DECISION historiques sans signature exploitable).
  versionLien     String?
  createdAt       DateTime                @default(now())

  @@index([needId])
  @@index([clientId])
  @@index([versionLien])
}

enum NiveauCertitudeSolution {
  FAIT
  SIGNAL
  HYPOTHESE
  OPTION
  RECOMMANDATION
  DECISION
}

// Un seul type pour cette étape — SERVICE/AUTRE seront ajoutés uniquement
// si un besoin réel (ex. ATLAS APPLICATION) le justifie, jamais par
// anticipation (voir revue architecturale, point ouvert de la conception).
enum TypeSolution {
  TALENT
}

// COMPANY ATLAS — LOT 4 : Profil Client Intelligence Foundation (15/09/2026).
//
// ClientProfile / ClientProfileFact : représentation DURABLE du client
// ("qui est ce client et comment fonctionne-t-il"), distincte de ClientNeed
// ("de quoi a-t-il besoin maintenant", LOT 2/3, jamais copié ici — les
// rubriques Besoins/Résultats du Profil lisent ClientNeed/Mission
// directement, aucune duplication). Même philosophie que ClientNeedFait :
// historique intégralement ADDITIF, jamais d'écrasement.
//
// Différence structurante avec ClientNeedFait (LOT 3) : la quasi-totalité
// des clés du Profil sont RÉPÉTABLES (plusieurs contraintes/objectifs
// valides simultanément) — "dernière valeur par clé gagne"
// (lib/client-need/faits.ts) ne s'applique donc PAS ici, sauf pour l'unique
// clé singleton CONTEXTE_ACTIVITE. Pour les clés répétables, l'état actif
// est déterminé par SUPERSESSION LOGIQUE via `confirmeDepuis` (voir
// lib/client-profile/faits.ts, instancesActivesParCle) : une ligne
// confirmée devient logiquement inactive dès qu'une ligne ultérieure la
// référence par `confirmeDepuis`, sans jamais être supprimée ni modifiée.
model ClientProfile {
  id        String              @id @default(cuid())
  client    Client              @relation(fields: [clientId], references: [id])
  clientId  String              @unique
  faits     ClientProfileFact[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// Vocabulaire FERMÉ — un nouvel attribut s'ajoute comme une nouvelle valeur
// d'enum, jamais une nouvelle colonne (même principe que ClientNeedFaitCle).
// CONTEXTE_ACTIVITE est la seule clé singleton ; les 8 autres sont
// répétables par nature.
enum ClientProfileFaitCle {
  CONTEXTE_ACTIVITE
  ENJEU
  OBJECTIF_DURABLE
  PRIORITE_DURABLE
  CONTRAINTE_DURABLE
  PREFERENCE_DURABLE
  CRITERE_REUSSITE_DURABLE
  RISQUE_DURABLE
  BESOIN_RECURRENT_CONFIRME
}

// Une ligne par information individuelle du profil — jamais un formulaire
// obligatoire. `statut` réutilise StatutPreuveCompetence tel quel (aucun
// second vocabulaire de provenance créé). `confirmeDepuis` : id de la ligne
// que CETTE ligne confirme/supersède (nullable, auto-référence) — c'est le
// seul mécanisme nécessaire pour déterminer la supersession logique (voir
// commentaire du modèle ci-dessus) ; aucune colonne de suppression/statut
// "actif" séparée. Pas de contrainte d'unicité sur (profileId, cle) :
// plusieurs instances valides simultanément pour les clés répétables.
model ClientProfileFact {
  id             String               @id @default(cuid())
  profile        ClientProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  cle            ClientProfileFaitCle
  valeur         String
  statut         StatutProfilFait     @default(INCONNU)
  source         String?
  confirmeDepuis String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([profileId])
}

enum StatutPreuveCompetence {
  VERIFIE
  DECLARE
  INFERE
  INCONNU
}

// COMPANY ATLAS — LOT 4 : Profil Client Intelligence Foundation (15/09/2026).
//
// Vocabulaire de provenance dédié à ClientProfileFact — PAS une extension
// de StatutPreuveCompetence. Écart documenté par rapport au plan de
// conception (Phase 2/consolidation prévoyait d'ajouter OBSERVE à l'enum
// partagé) : vérifié concrètement à l'implémentation (tsc) que plusieurs
// routes Talent (app/api/profils/[id]/competences/*, .../matching*,
// .../recommandations, .../talent-intelligence, .../talent-trust)
// transmettent le type Prisma de StatutPreuveCompetence à des fonctions de
// lib/talent/skill-graph.ts typées avec un alias LOCAL à 4 valeurs — un
// ajout d'OBSERVE au type partagé casse leur compilation. Plutôt que de
// modifier des fichiers du Matching Engine Talent (hors périmètre de ce
// lot, jamais touché sans nécessité absolue), un vocabulaire séparé isole
// entièrement ce lot : zéro fichier Talent modifié, zéro risque de
// régression sur le Matching Engine/Skill Graph.
enum StatutProfilFait {
  VERIFIE
  DECLARE
  INFERE
  OBSERVE
  INCONNU
}

enum NiveauConfiance {
  HAUTE
  MOYENNE
  BASSE
}

enum SourcePreuveCompetence {
  CV
  PROFIL
  CERTIFICATION
  MISSION
  EVALUATION
  ASSESSMENT
  ADMIN
}

model ProfilCompetence {
  id               String                 @id @default(cuid())
  profil           Profil                 @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId         String
  competence       String
  niveau           Int?
  anneesExperience Int?
  contexte         String?
  secteur          String?
  statut           StatutPreuveCompetence @default(INCONNU)
  confiance        NiveauConfiance        @default(BASSE)
  preuves          SkillEvidence[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([profilId, competence])
  @@index([profilId])
}

model SkillEvidence {
  id                 String                 @id @default(cuid())
  profilCompetence   ProfilCompetence       @relation(fields: [profilCompetenceId], references: [id], onDelete: Cascade)
  profilCompetenceId String
  source             SourcePreuveCompetence
  detail             String?
  niveau             Int?
  createdAt          DateTime               @default(now())

  @@index([profilCompetenceId])
}

// ATLAS — PHASE 2B-1 : MISSION SKILL PROPOSAL (28/09/2026).
//
// Pont MISSION -> PROPOSITION -> DÉCISION HUMAINE -> SkillEvidence. Une
// Mission ne prouve jamais automatiquement qu'une compétence est maîtrisée
// (voir mandat Phase 2B-1) : elle peut seulement produire une PROPOSITION
// (Ingénieur ou Admin), qui reste un objet de WORKFLOW MUTABLE tant qu'elle
// est EN_ATTENTE. Seule une décision Admin explicite (voir
// app/api/profils/[id]/skill-proposals/[proposalId]/route.ts) peut la faire
// passer à VALIDEE et créer, à cette occasion, une SkillEvidence(source:
// MISSION) réelle — via le même helper que POST .../competences/
// [competenceId]/preuves (voir lib/talent/skill-graph.ts,
// creerPreuveCompetence()), jamais une seconde logique de création de
// preuve.
//
// skillEvidenceId est une RÉFÉRENCE DE TRAÇABILITÉ, pas une relation Prisma
// (pas de @relation) : ajouter une relation forcerait SkillEvidence — une
// donnée historique immuable consommée telle quelle par tout lib/talent/*
// — à porter un champ inverse dont elle n'a structurellement aucun besoin
// (aucun code ne "remonte" d'une SkillEvidence vers la proposition qui l'a
// produite ; la traçabilité complète existe déjà via journaliser(), voir
// mission.skill_proposal.validated). Un simple String? évite ce couplage
// inutile, documenté explicitement ici (voir audit Phase 2B-1, section C).
//
// StatutPropositionCompetence est un vocabulaire VOLONTAIREMENT séparé de
// StatutPreuveCompetence — même principe déjà appliqué à StatutProfilFait
// (voir plus haut, LOT 4) : un EN_ATTENTE/VALIDEE/REFUSEE de workflow n'a
// rien à voir avec un VERIFIE/DECLARE/INFERE/INCONNU de preuve, et les
// mélanger romprait le typage de lib/talent/skill-graph.ts sans aucun
// bénéfice.
enum StatutPropositionCompetence {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

model MissionSkillProposal {
  id        String  @id @default(cuid())
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String
  // Toujours dérivé de mission.profilId côté serveur — jamais accepté depuis
  // le body d'une requête (voir routes) : élimine structurellement tout IDOR
  // par profilId falsifié.
  profil    Profil  @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId  String

  competence    String // valeur du vocabulaire fermé lib/competences.ts::TOUTES_COMPETENCES, jamais du texte libre non validé
  niveauPropose Int? // déclaration de l'Ingénieur — jamais utilisé tel quel comme niveau de preuve (voir D3)
  contexte      String?

  proposeParEmail String
  proposeParRole  Role // ADMIN ou INGENIEUR — jamais CLIENT (voir H8, aucune route Client sur ce modèle)

  statut     StatutPropositionCompetence @default(EN_ATTENTE)
  decidePar  String?
  decideLe   DateTime?
  motifRefus String?

  // Renseigné uniquement à la validation — le niveau RÉELLEMENT retenu par
  // l'Admin peut différer de niveauPropose (D3) ; jamais l'inverse.
  skillEvidenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([profilId, statut])
}

// ==========================================================================
// COMPANY ATLAS — V2.2-B : BILLING + FISCAL & REGULATORY COMPLIANCE
// FOUNDATION (17/09/2026)
// ==========================================================================
//
// Sépare conceptuellement la transaction commerciale (Facture, Paiement) de
// la règle réglementaire qui s'y applique (RegleFiscale) — jamais un
// `if France...`/`if 2027...` dispersé dans le code applicatif (voir
// lib/billing/regle-fiscale.ts). Chaque Facture fige, à son émission, une
// copie non réévaluable de la règle réellement appliquée
// (Facture.complianceSnapshot) : une évolution ultérieure de RegleFiscale
// (nouvelle version, nouveau régime) ne réécrit jamais l'histoire d'une
// facture déjà émise — même principe déjà éprouvé dans ce dépôt pour
// SolutionOption (V2.1) et ClientProfileFact (LOT 4) : append-only, jamais
// de mutation rétroactive silencieuse.
//
// 100% additif : aucun champ existant modifié/supprimé sur Mission,
// FeuilleDeTemps, Document, Client — Facture réutilise ces entités par
// relation, ne les duplique jamais (source unique de vérité : le TJM/la
// devise restent sur Mission, jamais recopiés ailleurs que dans le
// complianceSnapshot figé, dont c'est justement la fonction).
//
// Montants en Decimal (pas Float, contrairement à Mission.tjmVente/
// montantSaisi) : décision délibérée et documentée pour ce lot — un montant
// FACTURÉ/PAYÉ, contrairement à un TJM négocié, doit pouvoir être comparé à
// zéro (solde == 0) sans dérive d'arrondi binaire. Voir rapport V2.2-B,
// section Architecture retenue.

// Statut de Facture — ÉCHUE est volontairement absent de cette liste :
// c'est un état DÉRIVÉ (ENVOYEE ou PARTIELLEMENT_PAYEE + dateEcheance
// dépassée), jamais stocké ni muté par une tâche planifiée (aucune
// infrastructure de notification/cron n'existe dans ce dépôt à ce stade,
// voir audit V2.2-A/B) — calculé à la lecture par
// lib/billing/etat-facture.ts (statutAffiche()), jamais une vérité de plus
// à faire dériver deux fois.
enum StatutFacture {
  BROUILLON
  VALIDEE
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

// PARTIELLEMENT_PAYEE/PAYEE ne sont jamais positionnés directement par un
// appelant : ils sont toujours le résultat déterministe du solde après
// enregistrement d'un Paiement (lib/billing/etat-facture.ts) — jamais une
// action Admin indépendante qui pourrait diverger du solde réel.
enum StatutPaiement {
  CONFIRME
  ANNULE
}

// Statut du cycle de vie d'une RegleFiscale elle-même (pas de la Facture) —
// permet de préparer une future version (BROUILLON) avant activation, et de
// retirer une règle obsolète sans jamais la supprimer (RETIREE, jamais un
// DELETE : une Facture historique doit toujours pouvoir résoudre la règle
// qui lui a été appliquée à l'époque).
enum StatutRegleFiscale {
  BROUILLON
  ACTIVE
  RETIREE
}

// Consolide en UNE SEULE entité versionnée et time-bound ce que le mandat
// CEO décrit comme Jurisdiction + TaxRegime + VATRule + InvoiceRule +
// RegulatoryVersion : une même juridiction/un même régime ont besoin d'un
// ensemble cohérent de paramètres qui évoluent ENSEMBLE dans le temps (taux
// de TVA, mentions obligatoires, référence légale) — les séparer en
// plusieurs tables aurait exigé de les revalider mutuellement à chaque
// lecture sans bénéfice réel, l'exact anti-pattern que le mandat CEO
// dénonce. `parametres` (Json) porte les données propres à chaque règle
// (taux, mentions...) — jamais une colonne dédiée par futur paramètre
// fiscal, même principe que SolutionOption.donnees (V2.1).
//
// Aucune règle fiscale n'est inventée ici : la seule ligne réellement
// activée par ce lot (voir migration de données de ce lot) reprend le
// régime DÉJÀ appliqué et affiché par lib/pdf-facture.ts avant ce lot
// (franchise en base, art. 293B du CGI, aucune TVA) — jamais une nouvelle
// affirmation juridique. Toute autre juridiction/régime reste UNKNOWN tant
// qu'il n'est pas explicitement sourcé et validé (voir rapport V2.2-B,
// section Risques / UNKNOWN).
model RegleFiscale {
  id            String             @id @default(cuid())
  // Code libre (jamais un enum fermé : les juridictions futures ne sont
  // pas connues à l'avance) — ex. "FR", "EU", "INTERNATIONAL".
  juridiction   String
  // Identifiant de version lisible, ex. "FR_FRANCHISE_BASE_V1" — jamais
  // réutilisé une fois une version ACTIVE ou RETIREE (immuable une fois
  // sortie de BROUILLON).
  version       String             @unique
  statut        StatutRegleFiscale @default(BROUILLON)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  // Référence de la source réglementaire (texte de loi, article, lien) —
  // jamais une règle sans provenance vérifiable.
  source        String
  parametres    Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  factures      Facture[]

  @@index([juridiction, statut])
}

// Entité persistante et append-only sur ses montants : une fois `statut`
// sorti de BROUILLON, montantHT/montantTVA/montantTTC/devise ne sont plus
// jamais recalculés depuis Mission/FeuilleDeTemps (contrairement au PDF à
// la volée existant avant ce lot) — une évolution ultérieure de
// Mission.tjmVente ne modifie jamais rétroactivement une Facture déjà
// créée. `complianceSnapshot` fige la règle fiscale réellement appliquée à
// la validation (voir RegleFiscale ci-dessus) : une Facture historique
// reste interprétable même si `regleFiscale` évolue ou est retirée ensuite.
//
// Une Facture par FeuilleDeTemps (jamais plusieurs pour la même période/
// mission) : `feuilleDeTempsId` est @unique, garantissant l'idempotence de
// la création au niveau base de données, pas seulement applicatif (voir
// lib/billing/creation.ts).
//
// `dateEnvoi` (distinct de `dateEmission`) est le seul champ qui détermine
// la visibilité Client (voir app/api/factures/route.ts) — jamais le
// `statut` directement : une Facture ANNULEE après avoir été envoyée doit
// rester visible côté Client (il doit savoir qu'elle a été annulée),
// tandis qu'une Facture BROUILLON/VALIDEE (jamais envoyée) ou ANNULEE
// avant tout envoi ne doit jamais lui apparaître.
model Facture {
  id                 String         @id @default(cuid())
  client             Client         @relation(fields: [clientId], references: [id])
  clientId           String
  mission            Mission        @relation(fields: [missionId], references: [id])
  missionId          String
  feuilleDeTemps     FeuilleDeTemps @relation(fields: [feuilleDeTempsId], references: [id])
  feuilleDeTempsId   String         @unique
  numeroFacture      String         @unique
  statut             StatutFacture  @default(BROUILLON)
  montantHT          Decimal        @db.Decimal(12, 2)
  montantTVA         Decimal        @default(0) @db.Decimal(12, 2)
  montantTTC         Decimal        @db.Decimal(12, 2)
  devise             String
  dateEmission       DateTime?
  dateEcheance       DateTime?
  dateEnvoi          DateTime?
  regleFiscale       RegleFiscale?  @relation(fields: [regleFiscaleId], references: [id])
  regleFiscaleId     String?
  // Copie figée, non réévaluable, de la règle appliquée — voir le
  // commentaire de RegleFiscale ci-dessus.
  complianceSnapshot Json?
  document           Document?      @relation(fields: [documentId], references: [id])
  documentId         String?        @unique
  paiements          Paiement[]
  // ANNULEE uniquement : trace du motif, jamais une suppression de la
  // Facture elle-même (append-only, même discipline que le reste du
  // domaine).
  motifAnnulation    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([clientId])
  @@index([missionId])
  @@index([statut])
}

// Jamais une propriété de Facture (une Facture peut recevoir 0, 1 ou
// plusieurs Paiement) — voir lib/billing/solde.ts pour le calcul du solde,
// toujours dérivé en lisant cette table, jamais un champ dénormalisé sur
// Facture qui pourrait diverger. `reference` unique PAR Facture :
// idempotence au niveau base de données contre un double enregistrement du
// même paiement (retry réseau, double clic) — voir lib/billing/paiement.ts.
model Paiement {
  id           String         @id @default(cuid())
  facture      Facture        @relation(fields: [factureId], references: [id])
  factureId    String
  montant      Decimal        @db.Decimal(12, 2)
  devise       String
  datePaiement DateTime
  reference    String
  methode      String
  statut       StatutPaiement @default(CONFIRME)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([factureId, reference])
  @@index([factureId])
}

// COMPANY ATLAS — V2.3 : Communication Intelligence + Attention Center.
//
// Audit (mandat CEO V2.3 section 21, étape 0) : aucun modèle Notification
// n'existait avant ce lot, et Message (ci-dessus) n'a jamais porté de
// readAt/isRead. Le mandat section 5 (Attention Center) et section 8
// (Notifications) décrivent des ensembles de champs quasi identiques
// (type/priorité/titre/résumé/source/sourceId/createdAt/readAt/expiresAt) :
// créer deux modèles aurait violé la règle explicite section 6 ("ne pas
// créer deux systèmes concurrents"). Attention est donc le SEUL modèle,
// servant à la fois de centre d'attention et de notification.
//
// Vocabulaire fermé de `type` : chaque fait métier réel a son propre nom
// (repris verbatim des exemples du mandat section 11 pour Billing, et de
// la section 10 pour les besoins) — jamais une valeur libre.
enum AttentionType {
  FACTURE_ENVOYEE
  FACTURE_ECHEANCE_PROCHE
  FACTURE_ECHUE
  PAIEMENT_RECU
  PAIEMENT_PARTIEL
  PAIEMENT_ANNULE
  ANOMALIE_FINANCIERE
  BESOIN_A_CLARIFIER
  // V2.5 — Communication Intelligence (21/09/2026). Agrégée par THREAD
  // (jamais une ligne par Message individuel — voir lib/attention/
  // generateurs.ts, genererCandidatsMessage). source="Message".
  MESSAGE_NON_LU
}

enum AttentionCategorie {
  ACTION_REQUISE
  ALERTE
  INFORMATION
  RECOMMANDATION
}

enum AttentionPriorite {
  P0_CRITIQUE
  P1_HAUTE
  P2_NORMALE
  P3_BASSE
}

// OUVERTE = non lue. LUE = lue mais le fait métier sous-jacent est toujours
// vrai (jamais transformé en RESOLUE automatiquement dans ce cas — mandat
// section 10 : "ne jamais transformer automatiquement UNKNOWN en FACT").
// RESOLUE = le fait métier sous-jacent ne s'applique plus (détecté par
// lib/attention/synchronisation.ts) OU dismissal explicite d'une Attention
// purement INFORMATION/RECOMMANDATION (jamais une ACTION_REQUISE/ALERTE :
// voir lib/attention/api.ts). EXPIREE = date d'expiration dépassée sans
// résolution — calculé à la lecture, jamais par une tâche planifiée (aucune
// infrastructure de ce type n'existe dans ce dépôt, voir
// lib/billing/etat-facture.ts, précédent direct).
enum AttentionStatut {
  OUVERTE
  LUE
  RESOLUE
  EXPIREE
}

// Jamais INGENIEUR : ce rôle n'a structurellement accès à aucune donnée
// Billing ni Besoin (voir middleware.ts et chaque route consommée par
// lib/attention/synchronisation.ts) — l'exclure ici, au niveau du
// vocabulaire fermé, empêche toute Attention de lui être un jour destinée
// par erreur.
enum AttentionDestinataireType {
  CLIENT
  ADMIN
}

// Agrège des événements provenant des domaines existants — n'est JAMAIS une
// nouvelle source de vérité métier (mandat section 5) : chaque ligne est
// entièrement dérivable à nouveau depuis Facture/Paiement/ClientNeed à tout
// moment par lib/attention/synchronisation.ts, jamais une donnée saisie
// directement ici. `recipientId` est le clientId quand recipientType=CLIENT
// (une Attention Client est toujours scopée à UN Client, jamais un
// diffusion globale) ; NULL quand recipientType=ADMIN (rôle, jamais un
// destinataire individuel — même modèle que Facture/Paiement, qui n'ont
// aucune notion d'admin nommé).
//
// `actionDisponible` : forme contrôlée {label, href} UNIQUEMENT — jamais un
// objet d'action exécutable (aucune autonomie L5/L6 ajoutée, mandat section
// 16) : c'est un lien de navigation, jamais une action déclenchée par le
// système.
model Attention {
  id               String                    @id @default(cuid())
  type             AttentionType
  categorie        AttentionCategorie
  priorite         AttentionPriorite
  titre            String
  resume           String
  raison           String
  source           String
  sourceId         String
  recipientType    AttentionDestinataireType
  recipientId      String?
  actionDisponible Json?
  metadata         Json?
  statut           AttentionStatut           @default(OUVERTE)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  readAt           DateTime?
  resolvedAt       DateTime?
  expiresAt        DateTime?

  // Idempotence structurelle (mandat section 8 : "une même source ne doit
  // pas générer 50 notifications identiques") — un même fait métier mute
  // toujours la même ligne, jamais une nouvelle insertion.
  @@unique([type, source, sourceId])
  @@index([recipientType, recipientId, statut])
  @@index([createdAt])
}

// COMPANY ATLAS — V2.4 : Pièces jointes sécurisées (21/09/2026, Lot 0 —
// schéma uniquement, aucune API/upload/téléchargement dans ce lot).
//
// Aucun clientId sur ce modèle : l'ownership est TOUJOURS dérivé
// transitivement via messageId -> Message.clientId, jamais une seconde
// source de vérité sur l'appartenance (l'audit V2.4 a identifié ce
// couplage comme le défaut structurel du modèle Document existant —
// clientId obligatoire + relation Facture 1:1 morte pour ce cas d'usage
// — délibérément évité ici). Toute vérification d'accès doit donc
// remonter par `pieceJointe.message.clientId`, jamais un champ propre.
//
// Historique additif, même discipline que Message lui-même (aucune
// édition en V1) : `supprimeLe` marque une suppression LOGIQUE
// uniquement — jamais un DELETE, jamais un appel à supprimerFichier()
// dans ce lot (aucune logique d'accès/suppression n'est ajoutée ici,
// strictement le schéma).
model PieceJointe {
  id           String                @id @default(cuid())
  message      Message               @relation(fields: [messageId], references: [id])
  messageId    String
  nomFichier   String
  mimeType     String
  tailleOctets Int
  hash         String
  fileUrl      String
  // Interface future de malware scanning préparée sans scanner construit
  // (mandat V2.4 explicite) : aucune route ni logique ne lit ce champ
  // dans ce lot — NON_SCANNE par défaut, jamais un statut inventé.
  statutScan   StatutScanPieceJointe @default(NON_SCANNE)
  createdAt    DateTime              @default(now())
  supprimeLe   DateTime?

  @@index([messageId])
}

enum StatutScanPieceJointe {
  NON_SCANNE
  PROPRE
  SUSPECT
  ERREUR_SCAN
}

// COMPANY ATLAS — V2.5 : Communication Intelligence (21/09/2026).
//
// Curseur de lecture d'un fil Message, jamais un readAt/isRead posé sur
// Message lui-même (Message reste append-only, décision non négociable du
// mandat). Toujours scopé par (clientId, userId) où userId est le compte
// RÉEL qui lit (toujours renseigné, jamais NULL) :
// - Côté Client : userId = l'unique User (role CLIENT) rattaché à ce
//   Client (User.clientId, @unique) — un seul curseur possible par client,
//   cohérent avec "jamais de destinataire individuel" déjà en vigueur sur
//   Message/Attention côté Client.
// - Côté Admin : userId = le User (role ADMIN) qui lit CE fil précis —
//   décision CEO explicite (lecture Admin individuelle, un curseur par
//   Admin ET par client). Aujourd'hui un seul Admin existe (le CEO
//   lui-même) ; l'architecture supporte plusieurs Admin sans migration
//   future, chacun avec son propre curseur par fil.
//
// userId toujours non-NULL (jamais de valeur sentinelle) : la contrainte
// @@unique ci-dessous reste fiable même si un jour plusieurs comptes
// CLIENT existaient pour un même Client — chaque User a son propre
// curseur, sans ambiguïté.
model MessageLecture {
  id          String   @id @default(cuid())
  client      Client   @relation(fields: [clientId], references: [id])
  clientId    String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  dernierLuLe DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, userId])
  @@index([clientId])
}

// Préférences de notification — individuelles par User (première
// granularité par-utilisateur de ce domaine, jamais un remplacement du
// scoping par rôle d'Attention/Message eux-mêmes). Additive pure : aucune
// logique métier existante n'est modifiée si aucune ligne n'existe pour un
// User (voir lib/preferences-notification.ts, valeurs par défaut
// appliquées en code, jamais une hypothèse implicite côté base).
model PreferenceNotification {
  id              String               @id @default(cuid())
  user            User                 @relation(fields: [userId], references: [id])
  userId          String               @unique
  emailActif      Boolean              @default(true)
  // Catégories pour lesquelles un email est souhaité si emailActif=true.
  // Défaut applicatif (jamais stocké tant qu'aucune préférence n'a été
  // enregistrée) : ACTION_REQUISE + ALERTE actives, INFORMATION et
  // RECOMMANDATION désactivables (mandat V2.5, Lot 3).
  categoriesEmail AttentionCategorie[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// COMPANY ATLAS — A6.1 : Outcome Foundation (01/10/2026).
//
// Implémente le contrat défini par le rapport A6 ("ATLAS — A6 — OUTCOME
// CONTRACT / PRODUCT DESIGN") : répond à "la Mission a-t-elle réellement
// produit le résultat attendu par le Need validé ?" — jamais une deuxième
// Evaluation, jamais un proxy de satisfaction, jamais une conclusion
// inventée quand les preuves sont insuffisantes (voir OutcomeStatut.
// INDETERMINABLE ci-dessous).
//
// Mission / Evaluation / Evidence / Quality / Outcome restent strictement
// séparés (A6 §A6.3) : ce lot ne modifie ni Mission.statut, ni le modèle
// Evaluation, ni SolutionOption, ni Decision/DecisionOption (Control
// Plane) — `decisionOptionId` ci-dessous est une pure référence de
// traçabilité (même patron que SolutionOption.sourceOptionId/
// demandeTalentId : une simple colonne, jamais une relation Prisma),
// délibérément pour ne jamais exiger de champ inverse sur SolutionOption.
enum OutcomeStatut {
  OBTENU               // ACHIEVED
  PARTIELLEMENT_OBTENU // PARTIALLY_ACHIEVED
  NON_OBTENU           // NOT_ACHIEVED
  // Jamais une absence de ligne : un critère/ensemble de critères évalué
  // sans preuve suffisante produit explicitement cet état, jamais un
  // OBTENU/NON_OBTENU par défaut (règle absolue, A6 §9 et mandat A6.1 §15).
  INDETERMINABLE       // NOT_DETERMINABLE
}

// Méthode de vérification d'un critère — distincte de la confiance
// (OutcomeConfiance ci-dessous, qui réutilise VERIFIE/DECLARE/INFERE/
// INCONNU comme StatutPreuveCompetence/ClientNeedFait.statut, 5e instance
// du même vocabulaire à dessein jamais partagée, A6 §A6.3/§A6.10).
enum OutcomeMethodeVerification {
  VERIFIE_HUMAIN  // HUMAN_VERIFIED — un ADMIN a vérifié activement.
  DECLARE_CLIENT  // CLIENT_DECLARED — le client déclare lui-même.
  MESURE_SYSTEME  // SYSTEM_MEASURED — calculé depuis une donnée objective existante.
  INFERE_IA       // AI_INFERRED — une IA propose ; jamais suffisant seul pour OBTENU/NON_OBTENU.
}

enum OutcomeConfiance {
  VERIFIE
  DECLARE
  INFERE
  INCONNU
}

model OutcomeAssessment {
  id              String   @id @default(cuid())
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId       String
  // Version EXACTE, immuable, du Need évaluée — jamais la version
  // courante recalculée au moment de la lecture (A6 §A6.6 "point-in-time
  // truth"). Nullable : la majorité des Mission existantes n'ont pas de
  // sourceDemandeId traçable (voir Mission.sourceDemandeId) — ne jamais
  // deviner, laisser explicitement absent plutôt qu'inventer un lien.
  needVersion     ClientNeed? @relation(fields: [needVersionId], references: [id])
  needVersionId   String?
  // Référence de traçabilité pure vers la ligne SolutionOption (niveau
  // DECISION) qui a mené à cette Mission — jamais une relation Prisma
  // complète (même patron que SolutionOption.demandeTalentId), pour ne
  // jamais exiger de champ inverse sur SolutionOption (hors périmètre A6.1
  // explicite : "Ne modifie pas SolutionOption").
  decisionOptionId String?
  // Copie figée de RESULTAT_ATTENDU au moment de l'évaluation, si ce fait
  // existe sur la version pinnée — jamais une relecture live (le Need peut
  // avoir déjà forké depuis). Null si absent sur cette version (pas une
  // valeur inventée).
  expectedOutcome String?

  // Dérivé des OutcomeCriterionResult ci-dessous par
  // lib/outcome/verification.ts::verifierResultatVsNeed — jamais assigné
  // directement par un appelant (voir lib/outcome/service.ts).
  overallStatus   OutcomeStatut

  assessedAt      DateTime @default(now())
  // ADMIN uniquement (A6 §A6.11 — jamais le Client, jamais l'Ingénieur :
  // risque d'auto-validation ; jamais un Agent sans passer par B22, qui ne
  // s'applique à aucun appelant dans ce lot). Jamais null : l'API exige une
  // identité humaine authentifiée avant toute création.
  assessedByEmail String
  assessedByRole  String

  criteria        OutcomeCriterionResult[]

  // A15 — Supersession corrigée (même doctrine que DeliveryEvidence,
  // A12.1) : le pointeur vit sur la NOUVELLE ligne (supersedesId), jamais
  // sur l'ancienne — une ligne déjà créée n'est plus jamais réécrite,
  // aucune exception. "Courant" pour une Mission = supersededBy IS NULL
  // (aucune ligne suivante ne la référence par supersedesId). Au plus une
  // ligne courante par Mission à un instant donné — invariant applicatif
  // (transaction Serializable + retry, lib/outcome/service.ts), jamais une
  // contrainte DB (voir commentaire sur Mission.outcomeAssessments
  // ci-dessus). @unique sur supersedesId empêche structurellement toute
  // branche (deux lignes ne peuvent jamais superséder la même ligne).
  supersedesId    String?            @unique
  supersedes      OutcomeAssessment? @relation("OutcomeSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    OutcomeAssessment? @relation("OutcomeSupersession")

  createdAt       DateTime @default(now())

  @@index([missionId])
  @@index([needVersionId])
}

model OutcomeCriterionResult {
  id              String            @id @default(cuid())
  assessment      OutcomeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId    String
  // Référence de traçabilité pure vers l'instance ClientNeedFait(cle=
  // CRITERE_REUSSITE) précise évaluée — jamais une relation Prisma
  // complète (ClientNeedFait reste un modèle à très fort trafic, non
  // modifié par ce lot ; même discipline que decisionOptionId ci-dessus).
  // Null si ce critère ne correspond à aucun fait structuré (ex. critère
  // global unique faute de CRITERE_REUSSITE sur la version pinnée).
  sourceFaitId    String?
  // Copie figée du texte du critère au moment de l'évaluation — jamais
  // une relecture live.
  criterionText   String
  actualResult    String?
  status          OutcomeStatut
  confidence      OutcomeConfiance
  verificationMethod OutcomeMethodeVerification?

  evidences       OutcomeEvidence[]

  createdAt       DateTime @default(now())

  @@index([assessmentId])
}

model OutcomeEvidence {
  id          String                  @id @default(cuid())
  criterion   OutcomeCriterionResult  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  criterionId String
  // Libre, texte court — même rôle que SkillEvidence.source/detail,
  // jamais une copie de document complet (voir A6 §A6.8 : ce lot ne
  // construit pas de Deliverable Engine/Evidence Graph, uniquement le
  // point d'extension minimal permettant d'y brancher plus tard une
  // source réelle sans refactor).
  source      String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([criterionId])
}

// COMPANY ATLAS — A8 : SolutionDecision + Capability Engine V1 (05/10/2026).
//
// SÉPARATION DÉFINITIVE : ce modèle n'a AUCUN rapport avec `Decision`/
// `DecisionOption` (Control Plane, gouvernance d'actions/agents,
// lib/control-plane/*) — domaines distincts, jamais fusionnés. Le concept
// métier "SolutionDecision" (choix humain explicite d'une SolutionOption
// sur une version précise d'un besoin) reste porté techniquement par
// SolutionOption(niveau=DECISION), déjà mature et append-only (V2.1-E) —
// décision d'architecture A8 : migrer vers un modèle dédié exigerait de
// réécrire l'historique DECISION existant pour un gain nul, aucune
// collision de code ne l'exige (voir lib/client-solution/decision.ts pour
// le vocabulaire domaine `SolutionDecision`). `CapabilityRequirement`
// référence une SolutionDecision par pointeur texte simple
// (solutionDecisionId), jamais une relation Prisma — même discipline que
// SolutionOption.sourceOptionId/demandeTalentId : une relation forcerait
// un champ inverse sur SolutionOption, modification hors périmètre A8.
//
// Transforme les exigences structurées d'une Need VERSIONNÉE (faits
// COMPETENCE actifs uniquement — jamais CRITERE_REUSSITE, qui exigerait de
// synthétiser une capacité à partir d'une phrase de critère de succès,
// interdit par le principe "ne jamais inventer") en capacités requises.
// Indépendant du Talent/Matching par construction : aucun champ ne
// référence Profil/ProfilCompetence/SkillEvidence, aucun score.
model CapabilityRequirement {
  id       String     @id @default(cuid())
  need     ClientNeed @relation(fields: [needVersionId], references: [id], onDelete: Cascade)
  needVersionId String

  // Pointeur texte simple vers la ligne SolutionOption(niveau=DECISION)
  // ayant motivé cette dérivation, si une telle décision existe déjà pour
  // cette version du Need — jamais une précondition bloquante : la
  // dérivation fonctionne depuis le Need seul (voir lib/capability/service.ts).
  solutionDecisionId String?

  // Référence de traçabilité pure vers le ClientNeedFait(cle=COMPETENCE)
  // exact à l'origine de cette ligne — jamais une relation Prisma complète
  // (même discipline que OutcomeCriterionResult.sourceFaitId ci-dessus).
  // Toujours renseigné (contrairement à Outcome) : CapabilityRequirement
  // n'existe QUE dérivé d'un fait structuré précis, jamais autrement.
  sourceFaitId String

  // Texte brut du fait COMPETENCE source, jamais une reformulation/
  // élaboration — V1 est délibérément 1:1 avec le fait déclaré (la
  // distinction Skill≠Capability enrichie reste pour un futur lot
  // IA-assisté passant par ce même pipeline de provenance, jamais fabriquée
  // ici).
  requiredCapability String
  // Justification déterministe (template, référence le fait source) —
  // jamais une inférence supplémentaire.
  rationale          String

  // Copie figée du statut de provenance du fait source au moment de la
  // dérivation — réutilise StatutPreuveCompetence tel quel (même principe
  // que ClientNeedFait.statut lui-même), jamais recalculée après coup.
  provenance StatutPreuveCompetence

  // ACTIVE tant que le fait source reste une facette ACTIVE de sa version ;
  // SUPERSEDED si une re-dérivation constate que le fait source n'est plus
  // ACTIVE (défensif — aucun chemin d'écriture actuel ne repasse un
  // ClientNeedFait.statutActivite à OBSOLETE, mais le filtrage doit rester
  // correct si cela devient vrai un jour). Mis à jour en place
  // uniquement par le moteur lui-même, jamais par un appelant externe.
  status CapabilityRequirementStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  // A21 — MissionCapabilityLink : traçabilité inverse vers les Mission
  // ayant explicitement mobilisé cette capacité — jamais automatique
  // (aucune création n'est déclenchée depuis ce côté-ci). Une
  // CapabilityRequirement devenant SUPERSEDED (voir status ci-dessus)
  // n'affecte jamais rétroactivement les liens déjà créés : ceux-ci
  // conservent leur propre statut, indépendant (voir
  // MissionCapabilityLink.statut).
  missionLinks MissionCapabilityLink[]

  // Idempotence : une même (version de Need, fait source) ne produit
  // jamais deux lignes — clé naturelle, jamais un hash à maintenir
  // séparément (voir §12 du mandat A8).
  @@unique([needVersionId, sourceFaitId])
  @@index([needVersionId])
  @@index([solutionDecisionId])
}

enum CapabilityRequirementStatus {
  ACTIVE
  SUPERSEDED
}

// COMPANY ATLAS — A20 : MissionAssignment Foundation (05/10/2026).
//
// Source STRUCTURÉE de vérité pour l'affectation opérationnelle d'un
// Talent (Profil) à une Mission — coexiste avec le legacy `Mission.profilId`
// sans le remplacer : A20 ne retire pas `profilId`, ne le rend pas
// nullable, et ne migre aucun consommateur existant vers ce nouveau modèle
// (voir lib/mission/assignment-backfill.ts pour le backfill contrôlé des
// Mission historiques). Ne crée AUCUNE dépendance vers WorkItem/Deliverable
// (hors périmètre A20, voir contrat A13) : `role` ci-dessous est un rôle
// D'AFFECTATION, indépendant de tout futur rôle WorkItem.
//
// Identité immuable : une ligne appartient à EXACTEMENT une Mission et un
// Talent, fixés à la création (missionId/talentId jamais réécrits — un
// changement de Talent termine/annule l'ancienne ligne puis en crée une
// nouvelle, jamais un UPDATE du pointeur). Historique intégralement
// additif, même discipline que ClientNeedFait/SolutionOption : un même
// Talent peut avoir plusieurs MissionAssignment sur la même Mission dans le
// temps (ex. ACTIF -> TERMINE -> nouvelle ligne ACTIF), jamais collapsées.
//
// Invariants transactionnels (lib/mission/assignment.ts, jamais seulement
// applicatifs hors transaction — Serializable + retry P2034, même
// discipline que lib/outcome/service.ts/lib/client-need/versioning.ts) :
// (1) au plus un Assignment ACTIF avec estResponsablePrincipal=true par
// Mission ; (2) au plus un Assignment ACTIF par (Mission, Talent) — un
// Talent peut avoir un historique TERMINE/ANNULE sur cette Mission sans
// limite, seul le cumul de deux lignes ACTIF simultanées est interdit.
model MissionAssignment {
  id String @id @default(cuid())

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  // onDelete: Restrict (jamais Cascade) : un Talent ne peut jamais être
  // supprimé tant qu'il porte une affectation, historique ou active — même
  // doctrine que Mission.profilId (ON DELETE RESTRICT, voir migration
  // d'origine), jamais une suppression silencieuse de l'historique.
  talent   Profil @relation(fields: [talentId], references: [id], onDelete: Restrict)
  talentId String

  role   MissionAssignmentRole
  statut MissionAssignmentStatut @default(ACTIF)

  // Obligatoire quel que soit le statut (PLANIFIE/ACTIF comme TERMINE/ANNULE
  // en conservent un) — jamais déduite silencieusement d'un autre champ.
  dateDebut DateTime
  // A20 — DATE SEMANTICS CORRECTION (05/10/2026). AUCUN champ de Mission
  // (createdAt/updatedAt/dateDebut/dateFin) ne constitue une preuve de
  // la date RÉELLE d'affectation opérationnelle d'un Talent — ce sont des
  // faits de PROVENANCE DE LA DONNÉE (quand la ligne Mission a été écrite),
  // jamais des faits MÉTIER (quand le Talent a réellement commencé/fini).
  // Confondre les deux a été identifié comme une erreur dans la première
  // version du backfill A20 et corrigé ici : CONNUE = la date a été
  // explicitement fournie comme un fait réel (création/transition vivante
  // via le service, lib/mission/assignment.ts) ; PROXY_CREATION_MISSION/
  // PROXY_DERNIERE_ECRITURE_MISSION = reconstruite par le backfill
  // historique (lib/mission/assignment-backfill.ts) à partir d'un fait de
  // provenance, JAMAIS présentée comme une certitude métier. Tout
  // consommateur futur de dateDebut/dateFin DOIT lire ce champ avant de
  // traiter la date comme fiable.
  dateDebutProvenance DateAffectationProvenance @default(CONNUE)
  // NULL tant que PLANIFIE/ACTIF (affectation toujours en cours) ;
  // obligatoire au moment de la transition vers TERMINE/ANNULE (contrôlé
  // par le service, jamais par une contrainte DB — Prisma ne peut pas
  // exprimer une NOT NULL conditionnelle au statut).
  dateFin DateTime?
  // NULL tant que dateFin est NULL (même cycle de vie) — même doctrine de
  // provenance que dateDebutProvenance ci-dessus, jamais déduite.
  dateFinProvenance DateAffectationProvenance?

  // NULL = UNKNOWN explicite (jamais déduit) ; 0 = valeur connue et valide
  // (allocation nulle mais renseignée) ; 1..100 = valeur connue. Aucune
  // règle de somme à 100% entre Assignment d'une même Mission dans A20.
  allocationPct Int?

  // Au plus un Assignment ACTIF par Mission avec cette valeur à true —
  // invariant transactionnel (voir ci-dessus), jamais seulement applicatif.
  estResponsablePrincipal Boolean @default(false)

  // Immuables après création (même discipline que OutcomeAssessment/
  // CapabilityRequirement) : aucune route ne les réécrit jamais.
  createdAt      DateTime @default(now())
  createdByEmail String

  // A24 — WorkItemAssignment Foundation (05/10/2026). Inverse Prisma
  // strictement nécessaire pour la relation WorkItemAssignment.
  // missionAssignment ci-dessous — aucune règle A20 (lifecycle, dates,
  // provenance, backfill) n'est modifiée par cet ajout (contrat A24 §36).
  workItemAssignments WorkItemAssignment[]

  @@index([missionId])
  @@index([talentId])
}

enum MissionAssignmentRole {
  RESPONSABLE_PRINCIPAL
  CONTRIBUTEUR
  REVIEWER
}

enum MissionAssignmentStatut {
  PLANIFIE
  ACTIF
  TERMINE
  ANNULE
}

// A20 — DATE SEMANTICS CORRECTION (05/10/2026). Distingue une date
// d'affectation RÉELLEMENT connue (CONNUE — fournie explicitement par un
// Admin via le service vivant, création ou transition) d'une date
// RECONSTRUITE par le backfill historique à partir d'un fait de
// provenance de la donnée Mission, jamais d'un fait d'affectation
// vérifié. PROXY_CREATION_MISSION/PROXY_DERNIERE_ECRITURE_MISSION ne
// doivent JAMAIS être traitées comme une certitude métier par un
// consommateur futur (voir MissionAssignment.dateDebutProvenance/
// dateFinProvenance).
enum DateAffectationProvenance {
  CONNUE
  PROXY_CREATION_MISSION
  PROXY_DERNIERE_ECRITURE_MISSION
}

// COMPANY ATLAS — A21 : MissionCapabilityLink (05/10/2026).
//
// Jonction EXPLICITE entre une capacité issue du besoin/solution
// (CapabilityRequirement, A8) et une Mission qui la mobilise réellement —
// jamais un matching automatique, jamais une compétence Talent, jamais
// une preuve d'exécution (hors périmètre A21 : Outcome/WorkItem/
// Deliverable/Evidence restent des domaines séparés, aucune dépendance
// introduite ici vers eux). Création toujours EXPLICITE : ni la création
// d'une Mission, ni la dérivation d'une CapabilityRequirement (A8) ne
// déclenche automatiquement un lien.
//
// PROVENANCE SANS DUPLICATION : `capabilityRequirementId` référence la
// ligne source (jamais une copie de ses champs needVersionId/
// solutionDecisionId/sourceFaitId/rationale, qui restent exclusivement
// sur CapabilityRequirement). Nullable : un LIEN MANUEL (sans
// CapabilityRequirement) est explicitement autorisé pour les Mission
// legacy/manuelles sans Need/Decision (contrat A21 §6/§11) — ATLAS
// n'interdit jamais la construction d'une Mission hors du pipeline
// Need→Solution, et ne doit donc pas non plus interdire d'y documenter
// une capacité mobilisée. onDelete: Restrict (jamais Cascade) : une
// CapabilityRequirement référencée ne peut jamais être supprimée tant
// qu'un lien l'utilise — même doctrine que MissionAssignment.talentId.
//
// SNAPSHOT (`capability`) : copié depuis CapabilityRequirement.
// requiredCapability AU MOMENT DE LA CRÉATION, jamais relu dynamiquement
// depuis la relation — une re-dérivation A8 ultérieure qui ferait passer
// la CapabilityRequirement source en SUPERSEDED (lib/capability/service.ts)
// NE MODIFIE JAMAIS ce lien, ni son texte, ni son statut : l'historique
// d'une Mission reste figé au moment de l'attachement, exactement comme
// OutcomeAssessment reste pinné à sa version du Need (A6.1). Aucune
// cascade automatique SUPERSEDED->SUPERSEDED entre CapabilityRequirement
// et MissionCapabilityLink — ce sont deux statuts indépendants, un choix
// de supersession ici est TOUJOURS une action Admin explicite (retrait),
// jamais une conséquence d'un événement survenu côté CapabilityRequirement.
//
// COHÉRENCE DE VERSION (contrat A21 §6) : un lien référençant une
// CapabilityRequirement exige que Mission.needVersionId soit renseigné ET
// égal exactement à CapabilityRequirement.needVersionId — vérifié par le
// service (lib/mission/capability-link.ts), jamais en base (Prisma ne
// peut pas exprimer cette cohérence croisée nativement, même limitation
// que Mission.solutionDecisionId vs needVersionId, A18). Une Mission sans
// needVersionId ne peut donc recevoir qu'un lien MANUEL — jamais une
// CapabilityRequirement "flottante" sans pin Need vérifiable.
model MissionCapabilityLink {
  id String @id @default(cuid())

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  capabilityRequirement   CapabilityRequirement? @relation(fields: [capabilityRequirementId], references: [id], onDelete: Restrict)
  capabilityRequirementId String?

  // Toujours renseigné : snapshot de CapabilityRequirement.requiredCapability
  // si capabilityRequirementId est fourni, sinon texte libre saisi pour un
  // lien manuel — jamais les deux à la fois (contrôlé par le service).
  capability String

  // Justification de la MOBILISATION dans cette Mission — distincte de
  // CapabilityRequirement.rationale (justification de la DÉRIVATION depuis
  // le Need), jamais recopiée depuis celle-ci.
  rationale String?

  // ACTIVE par défaut ; SUPERSEDED uniquement par une action Admin
  // explicite de retrait (contrat A21 §10) — jamais une cascade depuis
  // CapabilityRequirement.status. Terminal : un lien SUPERSEDED ne repasse
  // jamais ACTIVE (réactivation = nouveau lien, même discipline que
  // MissionAssignment).
  statut MissionCapabilityLinkStatut @default(ACTIVE)

  // Immuables après création — aucune route ne les réécrit jamais (même
  // discipline que MissionAssignment/OutcomeAssessment/CapabilityRequirement).
  createdAt      DateTime @default(now())
  createdByEmail String

  @@index([missionId])
  @@index([capabilityRequirementId])
}

enum MissionCapabilityLinkStatut {
  ACTIVE
  SUPERSEDED
}

// COMPANY ATLAS — A23 : WorkItem Foundation (05/10/2026).
//
// Unité CONCRÈTE de travail à l'intérieur d'une Mission — Mission 1 - N
// WorkItem, jamais l'inverse (contrat A23 §2). Volontairement SANS
// talentId/profilId/engineerId : un WorkItem ne connaît jamais directement
// un Talent (contrat A23 §7) — la relation future passera par
// WorkItemAssignment -> MissionAssignment -> Talent, un lot distinct
// (A24+), jamais anticipé ici. Un WorkItem peut donc exister indéfiniment
// sans aucun Assignment (contrat A23 §8) — jamais une contrainte "Talent
// obligatoire".
//
// AUCUNE RELATION vers Deliverable/DeliveryEvidence/DeliveryQualityGate/
// OutcomeAssessment/Learning/FinancialResult dans ce lot (contrat A23 §38)
// — ces domaines appartiennent à des lots futurs distincts.
//
// SANS dateDebut/dateFin métier (contrat A23 §23) : aucune nécessité
// démontrée dans ce lot ; `createdAt`/`updatedAt` restent des faits de
// PROVENANCE DE LA DONNÉE (quand la ligne a été écrite/modifiée), jamais
// des faits d'exécution — même doctrine que Mission.createdAt/updatedAt
// (A20 Date Semantics Correction) : `updatedAt` ne doit JAMAIS être lu
// comme une date de transition de statut.
//
// SANS colonne dédiée pour la raison de blocage/résolution/annulation
// (contrat A23 §19/§20/§21) — même choix que Mission.statut (A22) :
// raison/raisonResolution/motif sont validés par le service
// (lib/work-item/lifecycle.ts) et journalisés (JournalActivite.detail),
// jamais persistés comme colonne structurée — "pas de nouvelle colonne
// pour un fait déjà capturé par l'audit".
model WorkItem {
  id String @id @default(cuid())

  // Immuable après création (contrat A23 §9/§24) : aucun service de ce
  // lot n'accepte jamais missionId en paramètre de modification — un
  // "déplacement" de WorkItem n'existe pas, seulement ANNULE + nouveau
  // WorkItem sur l'autre Mission.
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  titre       String
  description String?

  statut WorkItemStatut @default(A_FAIRE)

  // Immuables après création (même discipline que MissionAssignment/
  // MissionCapabilityLink/OutcomeAssessment/CapabilityRequirement).
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdByEmail String

  // A24 — WorkItemAssignment Foundation (05/10/2026). Inverse Prisma
  // strictement nécessaire — aucune règle A23 (lifecycle, création,
  // transition, statut) n'est modifiée par cet ajout (contrat A24 §37).
  assignments WorkItemAssignment[]

  // A25 — Deliverable Foundation (05/10/2026). Inverse Prisma strictement
  // nécessaire pour DeliverableWorkItemLink ci-dessous — aucune règle A23
  // (lifecycle, création, transition, statut) n'est modifiée par cet ajout.
  deliverableLinks DeliverableWorkItemLink[]

  // A26 — DeliveryEvidence Foundation (05/10/2026). Inverse Prisma
  // strictement nécessaire — aucune règle A23 n'est modifiée par cet ajout.
  deliveryEvidences DeliveryEvidence[]

  @@index([missionId])
  @@index([missionId, statut])
}

// Graphe de transition verrouillé (contrat A23 §5) — voir
// lib/work-item/lifecycle.ts::TRANSITIONS_AUTORISEES pour la matrice
// explicite. Machine totalement indépendante du lifecycle Mission (A22) :
// aucune synchronisation automatique dans un sens ni dans l'autre (contrat
// A23 §12/§13/§34).
enum WorkItemStatut {
  A_FAIRE
  EN_COURS
  BLOQUE
  TERMINE
  ANNULE
}

// COMPANY ATLAS — A24 : WorkItemAssignment Foundation (05/10/2026).
//
// Répond à "qui exécute concrètement ce WorkItem ?" — JAMAIS par un lien
// direct WorkItem -> Talent (contrat A24 §2) : WorkItem ne reçoit ni
// talentId, ni profilId, ni engineerId. Le chemin reste obligatoirement
// WorkItem -> WorkItemAssignment -> MissionAssignment -> Talent (contrat
// A24 §1/§10) : le client de l'API fournit missionAssignmentId, jamais un
// talentId — le serveur résout le Talent en lisant MissionAssignment,
// jamais l'inverse.
//
// COHÉRENCE DE MISSION (contrat A24 §9) : une ligne n'est valide que si
// WorkItem.missionId === MissionAssignment.missionId — vérifié par le
// service (lib/work-item/assignment.ts), jamais en base (Prisma ne peut
// pas exprimer cette cohérence croisée nativement, même limitation que
// Mission.solutionDecisionId vs needVersionId, A18, et MissionCapabilityLink
// vs needVersionId, A21).
//
// RÔLE/STATUT dédiés, jamais réutilisés depuis MissionAssignment (contrat
// A24 §7/§8) : les deux machines représentent des faits différents (le
// rôle d'un Talent sur LA MISSION entière n'est pas forcément son rôle sur
// CE WorkItem précis).
model WorkItemAssignment {
  id String @id @default(cuid())

  // Immuable après création (contrat A24 §27) : aucun service de ce lot
  // n'accepte jamais workItemId en paramètre de modification — un
  // "déplacement" vers un autre WorkItem n'existe pas, seulement ANNULE/
  // TERMINE + nouvelle WorkItemAssignment.
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  workItemId String

  // onDelete: Restrict (jamais Cascade) : une MissionAssignment ne peut
  // jamais être supprimée tant qu'elle porte une WorkItemAssignment,
  // historique ou active — même doctrine que MissionAssignment.talentId
  // (A20) et MissionCapabilityLink.capabilityRequirementId (A21). Immuable
  // après création (contrat A24 §26/§27) : un changement de Talent sur ce
  // WorkItem n'est JAMAIS une réécriture de ce champ, toujours ANNULE/
  // TERMINE + nouvelle ligne.
  missionAssignment   MissionAssignment @relation(fields: [missionAssignmentId], references: [id], onDelete: Restrict)
  missionAssignmentId String

  // Rôle sur CE WorkItem précis — indépendant du rôle MissionAssignment
  // (contrat A24 §7/§22). Immuable après création : aucune route de ce
  // lot ne le réécrit (non justifié par le mandat — voir lib/work-item/
  // assignment.ts, "aucun champ métier librement éditable après création").
  role WorkItemAssignmentRole

  // PLANIFIE par défaut à la création — jamais choisi par le client
  // (contrat A24 §29).
  statut WorkItemAssignmentStatut @default(PLANIFIE)

  // Ni l'une ni l'autre n'est jamais déduite (contrat A24 §23/§24) : pas
  // de createdAt, pas de MissionAssignment.dateDebut, pas de transition
  // WorkItem. NULL par défaut — jamais une fausse date. dateDebut
  // optionnelle à la création ; dateFin optionnelle UNIQUEMENT fournie par
  // l'appelant au moment de "terminer"/"annuler" (jamais "now()"
  // implicite) ; dateFin >= dateDebut vérifiée par le service lorsque les
  // deux existent.
  dateDebut DateTime?
  dateFin   DateTime?

  // Immuables après création (même discipline que MissionAssignment/
  // MissionCapabilityLink/WorkItem).
  createdAt      DateTime @default(now())
  createdByEmail String

  @@index([workItemId])
  @@index([missionAssignmentId])
}

enum WorkItemAssignmentRole {
  EXECUTEUR
  CONTRIBUTEUR
  REVIEWER
}

// Graphe de transition verrouillé (contrat A24 §28) — voir
// lib/work-item/assignment.ts::TRANSITIONS_AUTORISEES. Machine totalement
// indépendante des lifecycles Mission (A22)/WorkItem (A23)/MissionAssignment
// (A20) : aucune synchronisation automatique dans un sens ni dans l'autre.
enum WorkItemAssignmentStatut {
  PLANIFIE
  ACTIF
  TERMINE
  ANNULE
}

// COMPANY ATLAS — A25 : Deliverable Foundation (05/10/2026).
//
// Ce que la Mission a PRODUIT/REMIS/PRÉPARÉ — jamais une preuve
// (Evidence), jamais une validation qualité (Quality), jamais un
// résultat client (Outcome). Un Deliverable FINALIZED n'implique JAMAIS
// Outcome=OBTENU (contrat A25 §28/§32) — même doctrine que Mission.
// TERMINEE n'impliquant jamais Outcome=OBTENU (A6.1/A22).
//
// DÉCISION DE MODÉLISATION EXPLICITE (contrat A25 §17/§39, documentée ici
// comme demandé) : `Deliverable` est un objet logique QUASI-VIDE —
// uniquement missionId/acceptanceCriteria/métadonnées de création. TOUT
// le contenu versionné (titre, nature, contenu structuré) ET le STATUT de
// lifecycle vivent EXCLUSIVEMENT sur DeliverableVersion ci-dessous. Un
// Deliverable n'a PAS de statut propre — jamais un second statut
// redondant : "le statut du Deliverable" se lit toujours comme celui de
// sa version courante (non-supersédée). Justification : le cycle DRAFT->
// REVIEW->APPROVED->FINALIZED décrit l'état d'un CONTENU précis (contrat
// A25 §18/§20 : "cette VERSION est officiellement gelée"), jamais un état
// administratif de l'objet logique — exactement le même raisonnement qui
// a mené A15 à poser supersedesId/le statut matériel sur OutcomeAssessment
// (une ligne par évaluation), jamais sur Mission.
//
// acceptanceCriteria reste sur Deliverable (pas sur Version) : c'est le
// CONTRAT d'acceptation de l'objet logique dans son ensemble (contrat
// A25 §27), pas un contenu qui change à chaque révision — distinct de
// Need.criteres/Outcome.criterion, aucun lien automatique.
model Deliverable {
  id String @id @default(cuid())

  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionId String

  // Descriptif de ce que "accepter" ce livrable signifie — jamais
  // confondu avec un critère de succès du Need (A1) ni un critère
  // Outcome (A6.1), aucun lien automatique (contrat A25 §27).
  acceptanceCriteria String?

  // Immuables après création — aucune route ne les réécrit jamais (même
  // discipline que WorkItem/MissionAssignment/MissionCapabilityLink).
  createdAt      DateTime @default(now())
  createdByEmail String

  versions      DeliverableVersion[]
  workItemLinks DeliverableWorkItemLink[]

  @@index([missionId])
}

// Nature du CONTENU (pas un type commercial/catalogue — contrat A25 §6/§7,
// DeliverableType explicitement interdit). DOCUMENT = fichier/texte narratif
// à venir (A25 ne crée aucune relation Document — voir décision ci-dessous
// sur DeliverableDocumentLink) ; STRUCTURE = données structurées (seule
// nature acceptant contenuStructure) ; OPERATION = action opérationnelle
// effectuée (ex. configuration déployée, aucun artefact fichier) ;
// DECLARATIF = déclaration/affirmation structurée sans preuve jointe.
enum DeliverableNatureContenu {
  DOCUMENT
  STRUCTURE
  OPERATION
  DECLARATIF
}

// Cycle verrouillé (contrat A25 §16) — voir
// lib/deliverable/version.ts::TRANSITIONS_AUTORISEES pour la matrice
// explicite. DRAFT->REVIEW->APPROVED->FINALIZED ; REVIEW->REJECTED.
// FINALIZED et REJECTED sont TOUS LES DEUX terminaux : aucune réouverture
// REJECTED->DRAFT (contrat A25 §21 : "une correction crée une nouvelle
// version", jamais une réécriture/réouverture — même doctrine que
// TERMINE/ANNULE sur WorkItem/WorkItemAssignment, A23/A24).
enum DeliverableStatut {
  DRAFT
  REVIEW
  APPROVED
  FINALIZED
  REJECTED
}

// Une version précise du CONTENU du Deliverable — append-only, jamais
// réécrite (contrat A25 §13) : succession portée par la NOUVELLE ligne
// (supersedesId, même doctrine que OutcomeAssessment/A15, jamais
// supersededById sur l'ancienne), @unique sur supersedesId empêchant
// structurellement tout branchement (contrat A25 §15/§41 : V1->V2->V3,
// jamais V1->{V2,V3}). Le numéro `version` est attribué par le service
// (lib/deliverable/version.ts), jamais fourni par le client (contrat
// A25 §14).
model DeliverableVersion {
  id String @id @default(cuid())

  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String

  // Serveur-assigné, strictement croissant à partir de 1 par Deliverable
  // — jamais choisi par le client.
  version Int

  titre         String
  natureContenu DeliverableNatureContenu

  // Autorisé UNIQUEMENT si natureContenu = STRUCTURE (contrat A25 §8/§37)
  // — vérifié par le service, jamais en base (Prisma ne peut pas exprimer
  // cette cohérence croisée nativement, même limitation que
  // MissionCapabilityLink vs needVersionId, A21).
  contenuStructure Json?

  statut DeliverableStatut @default(DRAFT)

  // A15 — même doctrine de supersession corrigée : le pointeur vit sur la
  // NOUVELLE ligne, l'ancienne n'est jamais mutée après coup. @unique
  // empêche toute branche.
  supersedesId String?             @unique
  supersedes   DeliverableVersion? @relation("DeliverableVersionSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DeliverableVersion? @relation("DeliverableVersionSuccession")

  // Immuables après création — jamais réécrits (contrat A25 §40 :
  // version/supersedesId/createdAt/createdByEmail explicitement listés).
  // Une fois FINALIZED, titre/natureContenu/contenuStructure deviennent
  // également immuables (contrat A25 §18) — contrôlé par le service,
  // jamais par une contrainte DB (le statut conditionne l'immutabilité,
  // Prisma ne peut pas l'exprimer nativement).
  createdAt      DateTime @default(now())
  createdByEmail String

  // A26 — DeliveryEvidence Foundation (05/10/2026). Inverse Prisma
  // strictement nécessaire — aucune règle A25 n'est modifiée par cet ajout.
  deliveryEvidences DeliveryEvidence[]

  // A27 — Quality Gate Foundation (05/10/2026). Inverse Prisma strictement
  // nécessaire — aucune règle A25 (lifecycle, immutabilité, succession)
  // n'est modifiée par cet ajout.
  qualityGates DeliveryQualityGate[]

  @@unique([deliverableId, version])
  @@index([deliverableId])
}

// Lien EXPLICITE entre un Deliverable et les WorkItem ayant contribué à sa
// production — N:M, jamais créé automatiquement (contrat A25 §22/§23).
// Volontairement au niveau Deliverable, JAMAIS DeliverableVersion (contrat
// A25 §25/§26) : les WorkItems contributeurs restent les mêmes à travers
// les révisions de contenu, jamais dupliqués à chaque nouvelle version.
// COHÉRENCE DE MISSION (contrat A25 §24) : Deliverable.missionId ==
// WorkItem.missionId, vérifiée par le service (lib/deliverable/
// work-item-link.ts), jamais en base (même limitation que
// WorkItemAssignment vs Mission, A24). onDelete: Restrict sur workItem
// (jamais Cascade) : même doctrine que MissionAssignment.talentId (A20) —
// un WorkItem ne peut jamais être supprimé tant qu'il porte un lien.
// Suppression de CE lien = hard delete (contrat A25 §44, verbe DELETE) :
// jamais un soft-SUPERSEDED comme MissionCapabilityLink (A21), parce que
// ce lien ne porte lui-même aucun fait métier à historiser — seul un pur
// pointeur de traçabilité, retiré sans perte d'information (ni le
// Deliverable ni le WorkItem ne sont jamais supprimés par ce retrait).
model DeliverableWorkItemLink {
  id String @id @default(cuid())

  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String

  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  workItemId String

  createdAt      DateTime @default(now())
  createdByEmail String

  @@unique([deliverableId, workItemId])
  @@index([deliverableId])
  @@index([workItemId])
}

// COMPANY ATLAS — A26 : DeliveryEvidence Foundation (05/10/2026).
//
// Répond à "quel fait pouvons-nous documenter, sur quelle cible, avec
// quelle méthode, et avec quel niveau de confiance ?" — JAMAIS "le client
// a-t-il obtenu son résultat ?" (Outcome, hors périmètre A26, contrat
// A26 §3/§21). N'implique jamais OutcomeAssessment ni un QualityGate futur
// (contrat A26 §21/§22).
//
// CIBLE XOR (contrat A26 §6) : exactement WorkItem OU DeliverableVersion,
// jamais les deux, jamais aucun — vérifié par le service
// (lib/delivery-evidence/evidence.ts), jamais en base nativement via
// Prisma (CHECK ajouté manuellement en migration, même limitation que les
// index uniques partiels A21/A24 — voir migration.sql).
//
// IMMUTABILITÉ + SUCCESSION (contrat A26 §14/§15/§16) : même doctrine que
// OutcomeAssessment (A15)/DeliverableVersion (A25) — le pointeur de
// succession vit sur la NOUVELLE ligne (supersedesId), jamais l'ancienne
// mutée. DIFFÉRENCE STRUCTURELLE IMPORTANTE documentée ici : contrairement
// à OutcomeAssessment/DeliverableVersion (UN SEUL objet versionné par
// Mission/Deliverable), une cible (WorkItem ou DeliverableVersion) peut
// porter PLUSIEURS chaînes d'Evidence totalement indépendantes
// simultanément (ex. "12 tests passés" ET "accès client indisponible" sur
// le même WorkItem ne sont jamais des versions l'une de l'autre) — il
// n'existe donc PAS de notion de "ligne courante unique par cible" à
// auto-détecter. supersedesId est donc TOUJOURS explicitement fourni par
// l'appelant (jamais déduit d'une recherche "supersededBy IS NULL pour
// cette cible"), et désigne précisément QUELLE assertion antérieure est
// corrigée — jamais une simple dernière-en-date.
model DeliveryEvidence {
  id String @id @default(cuid())

  // XOR avec deliverableVersionId ci-dessous — exactement l'un des deux,
  // jamais les deux, jamais aucun (contrat A26 §6/§7). onDelete: Restrict
  // (jamais Cascade) : une Evidence est un fait historique, elle ne doit
  // jamais disparaître silencieusement si sa cible était supprimée (même
  // doctrine que MissionAssignment.talentId, A20).
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  workItemId String?

  deliverableVersion   DeliverableVersion? @relation(fields: [deliverableVersionId], references: [id], onDelete: Restrict)
  deliverableVersionId String?

  methode   DeliveryEvidenceMethod
  // Couple (méthode, confiance) validé par le service selon la matrice
  // verrouillée du contrat A26 §12 — jamais une combinaison arbitraire
  // acceptée en base.
  confiance DeliveryEvidenceConfidence

  // Assertion factuelle contextualisée, texte libre — jamais un moteur
  // NLP/paraphrase IA, jamais une normalisation sémantique (contrat A26
  // §19/§47) : le service conserve l'assertion fournie telle quelle.
  contenu String

  // Succession append-only — même doctrine que OutcomeAssessment (A15) et
  // DeliverableVersion (A25) : le pointeur vit sur la NOUVELLE ligne,
  // jamais l'ancienne mutée. @unique empêche structurellement toute
  // branche (contrat A26 §15/§44 : E1->E2->E3, jamais E1->{E2,E3}).
  // Cohérence vérifiée par le service (jamais en base) : même cible, même
  // Mission (contrat A26 §41/§42/§43).
  supersedesId String?           @unique
  supersedes   DeliveryEvidence? @relation("DeliveryEvidenceSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DeliveryEvidence? @relation("DeliveryEvidenceSuccession")

  // Immuables après création — aucune route ne les réécrit jamais (même
  // discipline que WorkItem/MissionAssignment/DeliverableVersion).
  // Volontairement AUCUN verifiedBy/verifiedAt (contrat A26 §18) : la
  // méthode + createdByEmail suffisent ("VALIDATION_ADMIN" + l'email de
  // l'Admin créateur matérialise déjà la validation, plus l'audit
  // journalisé — jamais un second mécanisme de validation redondant).
  createdAt      DateTime @default(now())
  createdByEmail String

  // A27 — Quality Gate Foundation (05/10/2026). Inverse Prisma strictement
  // nécessaire pour QualityEvidenceLink ci-dessous — aucune règle A26
  // (immutabilité, succession, contenu) n'est modifiée par cet ajout.
  qualityEvidenceLinks QualityEvidenceLink[]

  @@index([workItemId])
  @@index([deliverableVersionId])
}

// Méthodes verrouillées (contrat A26 §10) — jamais étendues dans ce lot.
enum DeliveryEvidenceMethod {
  DECLARATION_TALENT
  VALIDATION_ADMIN
  VALIDATION_CLIENT
  MESURE_SYSTEME
  TEST_AUTOMATISE
  INFERENCE_IA
}

// Confiance QUALITATIVE (contrat A26 §11/§20) — jamais un score numérique
// (pas de confidenceScore/probability). Vocabulaire fermé DÉDIÉ, jamais
// réutilisé depuis OutcomeConfiance/StatutPreuveCompetence/ClientNeedFait.
// statut (même discipline que OutcomeMethodeVerification, A6 §A6.3).
enum DeliveryEvidenceConfidence {
  VERIFIE
  DECLARE
  INFERE
  INCONNU
}

// COMPANY ATLAS — A27 : Quality Gate Foundation (05/10/2026).
//
// Répond à "ce qui a été livré respecte-t-il les critères d'acceptation
// définis ?" — JAMAIS "le client a-t-il obtenu son résultat ?" (Outcome,
// hors périmètre A27, contrat A27 §1/§3). Les trois assertions Evidence
// (A26, "que s'est-il passé ?") / Quality (A27, "cela respecte-t-il les
// critères ?") / Outcome (A6.1, "le client a-t-il obtenu son résultat ?")
// restent strictement indépendantes, jamais fusionnées, jamais un
// automatisme dans un sens ou dans l'autre (contrat A27 §3/§11/§28/§29).
//
// CIBLE — DÉCISION DE MODÉLISATION EXPLICITE (contrat A27 §6/§7,
// documentée ici comme demandé) : UNIQUEMENT DeliverableVersion — jamais
// WorkItem, contrairement à DeliveryEvidence (A26, XOR WorkItem/
// DeliverableVersion). Raison : "critères" est le cœur même de ce que
// Quality évalue, et acceptanceCriteria est un concept qui vit
// EXCLUSIVEMENT sur Deliverable (voir ci-dessous) — WorkItem (A23) ne
// porte structurellement aucune notion de critère d'acceptation : c'est
// une unité de travail interne, pas un contenu livré à évaluer contre un
// contrat d'acceptation. Introduire une cible WorkItem pour Quality
// exigerait soit d'inventer un acceptanceCriteria sur WorkItem (hors
// périmètre, non demandé), soit d'évaluer un WorkItem contre les critères
// d'un Deliverable qu'il ne porte pas lui-même — une confusion de
// domaine. Une cible générique (Option C) est également écartée : elle
// introduirait une abstraction supplémentaire pour éviter une seule FK,
// ce que le contrat interdit explicitement (§7 : "ne pas introduire une
// abstraction générique seulement pour éviter deux FK"). Un seul FK
// obligatoire, jamais nullable, jamais XOR — plus simple que A26 parce
// que le besoin réel l'est aussi.
//
// IMMUABILITÉ DE CIBLE (contrat A27 §28) : une fois créée, une
// DeliveryQualityGate reste pointée EXACTEMENT sur cette version — jamais
// déplacée automatiquement vers une version plus récente si le
// Deliverable évolue (même doctrine que DeliveryEvidence vs sa cible,
// A26).
//
// CRITÈRES / SNAPSHOT (contrat A27 §9/§10, décision explicite) :
// Deliverable.acceptanceCriteria (A25) est un champ libre MUTABLE sur
// l'objet logique Deliverable, tandis qu'une DeliverableVersion est un
// instantané immuable dans le temps — une Quality historique référençant
// V1 ne doit JAMAIS réinterpréter silencieusement sous un
// acceptanceCriteria modifié APRÈS coup. Solution minimale retenue (même
// doctrine que OutcomeAssessment.expectedOutcome, A6.1, "copie figée au
// moment de l'évaluation, jamais une relecture live") : `
// acceptanceCriteriaSnapshot` copie littéralement Deliverable.
// acceptanceCriteria au moment de la création, une seule fois, jamais mis
// à jour ensuite. Aucun moteur de règles générique construit : simple
// copie figée.
//
// GRANULARITÉ — DÉCISION EXPLICITE (contrat A27 §23/§24/§25/§26) : PAS de
// QualityCriterionResult par critère (contrairement à OutcomeAssessment/
// OutcomeCriterionResult, A6.1) — un seul résultat de premier niveau
// (`resultat`). Raison indépendante, jamais une copie aveugle : Outcome
// dispose d'une source STRUCTURÉE de critères (ClientNeedFait,
// cle=CRITERE_REUSSITE) à itérer un par un ; Deliverable.acceptanceCriteria
// est un unique champ texte libre (A25 §27), sans aucune liste structurée
// à décomposer — construire une granularité par critère exigerait de
// demander à l'évaluateur de ré-inventer un découpage que le modèle ne
// fournit pas, contraire au principe "jamais inventer". `criteresEvalues`
// (texte libre, obligatoire) porte la déclaration de l'évaluateur sur ce
// qui a réellement été vérifié.
//
// RÉSULTAT (contrat A27 §11/§12/§13) : vocabulaire fermé DÉDIÉ
// (DeliveryQualityResult), jamais réutilisé depuis OutcomeStatut (OBTENU/
// PARTIELLEMENT_OBTENU/NON_OBTENU/INDETERMINABLE) ni depuis le vocabulaire
// QualityStatus non lié de lib/quality/domain.ts (Quality Signals CI —
// bounded context totalement différent, dérivé de CI/CODE_REVIEW/RUNTIME
// pour la Sécurité/le code, AUCUN rapport avec cette Quality-ci malgré le
// nom partagé — vérifié par l'audit A27 §4, aucune collision de modèle
// Prisma). NOT_DETERMINABLE est préféré à un faux PASS/FAIL quand la
// preuve est insuffisante — jamais forcé par défaut.
//
// LIFECYCLE (contrat A27 §17/§18) : DRAFT -> FINALIZED uniquement, machine
// minimale à deux états (jamais un vocabulaire flou) — transition en
// écriture conditionnelle (`updateMany` sur id+statut, même discipline
// que DeliverableVersion/WorkItem, AUCUN invariant croisé entre lignes,
// donc jamais de transaction Serializable ici). AUCUNE SUCCESSION
// (supersedesId) dans ce lot (contrat A27 §17, "une simple nouvelle
// Quality indépendante peut suffire si le besoin n'est pas démontré") :
// contrairement à OutcomeAssessment/DeliverableVersion (UN SEUL objet
// courant par parent, succession auto-détectée nécessaire), plusieurs
// DeliveryQualityGate INDÉPENDANTES peuvent légitimement coexister sur la
// MÊME DeliverableVersion (ex. une évaluation "fonctionnelle" et une
// évaluation "sécurité" ne sont jamais des versions l'une de l'autre) —
// il n'existe donc PAS de notion de "ligne courante unique par cible" à
// remplacer, donc rien à superséder structurellement. Une correction
// après FINALIZED est simplement une NOUVELLE DeliveryQualityGate
// indépendante sur la même cible, jamais une réécriture de l'ancienne.
//
// RBAC (hors de ce modèle/service, contrôlé par les routes, contrat A27
// §17-21 audité) : ADMIN et INGENIEUR (sur les Missions où il est
// autorisé, via lib/delivery-evidence/access.ts::
// estIngenieurAutoriseSurMission, même fonction partagée que A26 pour
// DeliverableVersion) peuvent créer/préparer une DRAFT ; seul ADMIN peut
// finaliser (jamais l'Ingénieur, même sur sa propre ligne — risque
// d'auto-validation, même doctrine que OutcomeAssessment, A6.1 §A6.11) ;
// le CLIENT ne devient JAMAIS automatiquement approbateur Quality (sa
// validation reste exclusivement DeliveryEvidence.VALIDATION_CLIENT,
// A26) — lecture uniquement sur ses propres Mission.
//
// AUCUN RÔLE AGENT (contrat A27 §22-27, limitation déjà documentée par
// A26/A6.1) : ce schéma n'ajoute aucune identité Agent — une Quality
// "proposée par IA" devrait passer par ADMIN comme pour INFERENCE_IA
// (A26) ou DECLARE_CLIENT/INFERE_IA (Outcome), jamais une création
// directe FINALIZED.
//
// ISOLATION ABSOLUE (contrat A27 §37-42) : ce domaine ne modifie JAMAIS
// DeliveryEvidence (seulement référencée via QualityEvidenceLink, jamais
// son contenu copié), ne modifie JAMAIS Deliverable/DeliverableVersion
// (contenu, statut, FINALIZE/REJECT), ne modifie JAMAIS WorkItem.statut,
// ne modifie JAMAIS Mission.statut. Mission TERMINEE/ANNULEE ne bloque
// JAMAIS la création d'une DeliveryQualityGate historiquement nécessaire
// (même doctrine que DeliveryEvidence/DeliverableVersion, A25/A26) :
// aucune précondition Mission.statut/DeliverableVersion.statut n'est
// vérifiée ici.
enum DeliveryQualityResult {
  PASS
  FAIL
  NOT_DETERMINABLE
}

enum DeliveryQualityStatut {
  DRAFT
  FINALIZED
}

model DeliveryQualityGate {
  id String @id @default(cuid())

  // Cible UNIQUE et immuable (contrat A27 §6/§7/§28) — jamais XOR, jamais
  // nullable, jamais déplacée vers une version ultérieure. onDelete:
  // Restrict (jamais Cascade) : une Quality est un fait historique, elle
  // ne doit jamais disparaître silencieusement si sa cible était
  // supprimée (même doctrine que DeliveryEvidence vs ses cibles, A26).
  deliverableVersion   DeliverableVersion @relation(fields: [deliverableVersionId], references: [id], onDelete: Restrict)
  deliverableVersionId String

  // Déclaration libre de l'évaluateur sur ce qui a réellement été vérifié
  // — obligatoire (champ minimal "critères" du contrat A27 §5), jamais
  // une relecture automatique de acceptanceCriteriaSnapshot ci-dessous
  // (qui reste une copie contextuelle, pas une liste à cocher).
  criteresEvalues String

  // Copie figée de Deliverable.acceptanceCriteria au moment de la
  // création — jamais relue live ensuite (contrat A27 §9/§10). Null si
  // le Deliverable n'avait aucun acceptanceCriteria renseigné à cet
  // instant (pas une valeur inventée).
  acceptanceCriteriaSnapshot String?

  resultat DeliveryQualityResult

  // DRAFT à la création, jamais choisi par l'appelant (contrat A27 §17).
  statut DeliveryQualityStatut @default(DRAFT)

  // Évaluateur + date (champs minimaux du contrat A27 §5) — immuables
  // après création, même discipline que WorkItem/MissionAssignment/
  // DeliverableVersion/DeliveryEvidence.
  evaluatedAt      DateTime @default(now())
  evaluatedByEmail String
  evaluatedByRole  String

  createdAt      DateTime @default(now())
  createdByEmail String

  evidenceLinks QualityEvidenceLink[]

  @@index([deliverableVersionId])
}

// Provenance Evidence d'une Quality — N:M, jamais une copie de contenu
// (contrat A27 §14/§15/§16/§33-36) : référence l'EXACTE ligne
// DeliveryEvidence citée au moment de l'évaluation. Une Evidence
// supersédée PLUS TARD par une nouvelle ligne reste légalement
// référencée ici, jamais déplacée vers la nouvelle (contrat A27 §16) —
// aucune vérification de supersession n'est faite à la création du lien,
// volontairement. Ajout/retrait uniquement tant que la Quality parente
// est DRAFT (contrôlé par le service, jamais en base) — une fois
// FINALIZED, le contenu de la Quality (y compris ses liens Evidence)
// devient immuable, même discipline que DeliverableVersion (contrat
// A25 §18).
//
// Hard delete (même discipline que DeliverableWorkItemLink, A25 §44) : ce
// lien ne porte lui-même aucun fait métier à historiser, seul un
// pointeur de traçabilité — son retrait ne détruit ni la Quality ni
// l'Evidence référencée.
model QualityEvidenceLink {
  id String @id @default(cuid())

  qualityGate   DeliveryQualityGate @relation(fields: [qualityGateId], references: [id], onDelete: Cascade)
  qualityGateId String

  // onDelete: Restrict (jamais Cascade) : une DeliveryEvidence est un
  // fait historique de A26, jamais supprimée silencieusement parce
  // qu'une Quality la référence (même doctrine que DeliverableWorkItemLink.
  // workItemId, A25).
  deliveryEvidence   DeliveryEvidence @relation(fields: [deliveryEvidenceId], references: [id], onDelete: Restrict)
  deliveryEvidenceId String

  createdAt      DateTime @default(now())
  createdByEmail String

  // Idempotence : jamais deux liens identiques entre la même Quality et
  // la même Evidence (contrat A27 §33-36, "optionnellement empêcher les
  // doublons exacts").
  @@unique([qualityGateId, deliveryEvidenceId])
  @@index([qualityGateId])
  @@index([deliveryEvidenceId])
}

// COMPANY ATLAS — A29 : Financial Result Foundation (05/10/2026).
//
// Répond à "quel résultat financier réel cette Mission a-t-elle produit ?"
// — JAMAIS "quel était l'objectif commercial ?" (Mission.tjmVente/nbJours/
// margeCible, contrat A29 §2/§5/§18, intégralement conservés tels quels :
// CIBLE commerciale, jamais renommée/transformée en "réel"). N'implique
// JAMAIS OutcomeAssessment ni DeliveryQualityGate (contrat A29 §6/§7/§33) :
// `Outcome PASS/ACHIEVED + Financial Result LOSS` et
// `Quality FAIL + Financial Result PROFIT` doivent tous deux rester
// possibles — Mission reste le seul point d'articulation commun, jamais
// une FK directe vers l'un ou l'autre.
//
// AUDIT DES SOURCES FINANCIÈRES RÉELLES (contrat A29 §3/§8, mené avant
// toute décision de modèle) : grep "margeCible/tjmVente/nbJours/cout/
// revenu/financial/finance/margin" sur app/lib/prisma/tests a révélé :
//   A — Prévision : Mission.tjmVente/nbJours/margeCible (déjà existants,
//       jamais touchés ici).
//   B — Réalisé existant : Facture/Paiement (V2.2-B, Decimal(12,2), déjà
//       une facturation RÉELLE — montantHT/TTC facturé, Paiement.montant
//       réellement encaissé si statut=CONFIRME) ; FeuilleDeTemps.statut=
//       "ValideeClient" (seul statut définitif, déjà utilisé par
//       lib/finance/margin-intelligence.ts comme unique source de "jours
//       réels"). AUCUNE donnée de COÛT TALENT réellement payé n'existe
//       (Profil.montantSaisi est un TJM NÉGOCIÉ/catalogue, jamais une
//       dépense réellement engagée — contrat A29 §16, confirmé par cet
//       audit : calculerTjmCout() produit un TAUX modélisé via des
//       Hypotheses globales, jamais un montant payé).
//   C — Déclaratif : un ADMIN peut déclarer un montant qu'il affirme réel
//       (même doctrine que DeliveryEvidence.contenu/A27 criteresEvalues :
//       une assertion humaine, jamais une invention du service).
//   D — Calculé : Profit = Revenue - Cost, Margin% = Profit/Revenue
//       (uniquement si les deux entrées sont connues — jamais déduit d'un
//       seul côté).
//   E — Inconnu : par défaut, pour toute Mission sans donnée fiable
//       déclarée — jamais un 0 implicite (contrat A29 §10 : "0 et UNKNOWN
//       sont deux états différents").
//
// DÉCISION DE MODÉLISATION EXPLICITE (contrat A29 §16/§26, documentée
// ici) : compte tenu de l'absence totale de coût Talent réellement payé
// dans ce schéma, ce lot n'implémente AUCUN calcul automatique de coût
// (jamais allocationPct × un TJM quelconque, contrat A29 §16) — Revenue
// ET Cost sont tous deux des montants DÉCLARÉS par un ADMIN
// (provenance obligatoire, jamais une valeur stockée sans savoir d'où
// elle vient), exactement l'exemple du contrat A29 §26. Une Mission sans
// déclaration ADMIN reste structurellement NOT_DETERMINABLE, jamais
// recalculée depuis Mission.tjmVente/nbJours/margeCible (contrat A29
// §47 : la cible commerciale ne devient jamais un réalisé par magie).
// Réutiliser Facture/Paiement comme calcul automatique de Revenue a été
// délibérément écarté pour ce lot V1 (périmètre minimal, contrat A29 §37/
// §38 "pas de système comptable") — reste une extension documentée
// possible pour un lot futur, jamais construite ici sans nécessité
// démontrée.
//
// CIBLE (contrat A29 §33) : FK directe vers Mission UNIQUEMENT — jamais
// vers OutcomeAssessment/DeliveryQualityGate, pour préserver
// l'indépendance totale entre les trois moteurs.
//
// LIFECYCLE / SUCCESSION (contrat A29 §20/§35/§36, décision explicite) :
// DRAFT -> FINALIZED (même machine minimale que DeliveryQualityGate, A27)
// ; `supersedesId` TOUJOURS explicite, jamais auto-détecté (contrat A29
// §35 : "ne pas créer de contrainte unique avant d'avoir déterminé le
// besoin" — contrairement à OutcomeAssessment, A6.1, qui impose UN SEUL
// courant par Mission). Plusieurs FinancialResult peuvent légitimement
// coexister pour la même Mission (ex. un DRAFT en préparation et un
// FINALIZED déjà figé) — même doctrine que DeliveryEvidence (A26) :
// aucune notion de "ligne courante unique" à auto-détecter, une
// correction après FINALIZED est une NOUVELLE ligne, qui peut
// explicitement superséder l'ancienne si l'appelant le précise.
//
// MONEY (contrat A29 §11) : Decimal(12,2), même convention que Facture/
// Paiement (V2.2-B) — jamais Float (contrairement à Mission.tjmVente/
// margeCible, déjà Float, jamais changés ici). `marginPct` en Decimal
// (7,4), fraction (0.30 = 30%) — même convention que Mission.margeCible
// (Float, mais déjà une fraction, jamais un pourcentage littéral), arrondi
// déterministe via Prisma.Decimal.ROUND_HALF_UP (jamais un flottant
// binaire imprévisible).
//
// DEVISE (contrat A29 §12) : `currency` requis, jamais un défaut "EUR"
// codé en dur dans le SCHÉMA (contrairement à Mission.deviseVente, qui,
// lui, porte un défaut applicatif historique) — le SERVICE renseigne
// `currency` depuis Mission.deviseVente si l'appelant ne le fournit pas
// explicitement, jamais une supposition implicite au niveau du modèle.
enum FinancialResultStatut {
  DRAFT
  FINALIZED
}

// Vocabulaire DÉDIÉ à Financial Result (contrat A29 §9/§27), jamais
// réutilisé depuis DeliveryEvidenceConfidence (A26)/OutcomeConfiance
// (A6.1) — même discipline que chaque domaine précédent (A26 §11/§20).
// DECLARE : un ADMIN affirme ce montant sans vérification croisée
// supplémentaire documentée. VERIFIE : l'ADMIN atteste explicitement
// avoir vérifié ce montant contre une source réelle (ex. Facture/
// Paiement déjà existants) — toujours une assertion humaine, jamais un
// calcul automatique qui le rendrait "vérifié" par construction (contrat
// A29 §27 : "ne pas appeler verified une donnée simplement saisie" —
// VERIFIE exige donc en plus `justification` non vide expliquant la
// vérification, contrôlé par le service).
enum FinancialResultProvenance {
  DECLARE
  VERIFIE
}

// Vocabulaire verrouillé (contrat A29 §13), jamais réutilisé depuis
// OutcomeStatut/DeliveryQualityResult (A6.1/A27) — bounded context
// distinct. NOT_DETERMINABLE couvre à la fois "Revenue ou Cost inconnu"
// ET "Revenue connu mais égal à zéro" pour le pourcentage de marge
// (contrat A29 §24, division par zéro jamais calculée) — jamais un déni
// de ce dernier cas comme une simple absence de champ.
enum FinancialResultGlobal {
  PROFIT
  BREAK_EVEN
  LOSS
  NOT_DETERMINABLE
}

model FinancialResult {
  id String @id @default(cuid())

  // onDelete: Restrict (jamais Cascade) : un FinancialResult est un fait
  // historique, il ne doit jamais disparaître silencieusement si la
  // Mission était supprimée (même doctrine que toutes les cibles A26/A27).
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionId String

  // Devise de CE résultat — requise, jamais déduite implicitement d'un
  // défaut codé en dur ici (le service la renseigne depuis
  // Mission.deviseVente si absente à l'appel, contrat A29 §12).
  currency String

  // Revenue/Cost — tous deux optionnels (null = UNKNOWN, jamais 0 par
  // défaut, contrat A29 §10). Si renseigné : provenance ET justification
  // non vide sont OBLIGATOIRES (contrôlé par le service, jamais en base) —
  // jamais un montant stocké sans savoir d'où il vient (contrat A29 §9).
  revenueAmount        Decimal?                   @db.Decimal(12, 2)
  revenueProvenance    FinancialResultProvenance?
  revenueJustification String?

  costAmount        Decimal?                   @db.Decimal(12, 2)
  costProvenance    FinancialResultProvenance?
  costJustification String?

  // Dérivés — TOUJOURS calculés par le service (lib/financial-result/
  // financial-result.ts::calculerResultat), jamais fournis par l'appelant
  // (contrat A29 §10/§23/§24) : Profit = Revenue - Cost et Margin% =
  // Profit/Revenue UNIQUEMENT si les deux entrées sont connues ET
  // Revenue != 0 pour Margin% ; sinon NOT_DETERMINABLE explicite, jamais
  // NaN/Infinity/0 par défaut.
  profitAmount   Decimal?               @db.Decimal(12, 2)
  marginPct      Decimal?               @db.Decimal(7, 4)
  resultatGlobal FinancialResultGlobal

  // DRAFT à la création, jamais choisi par l'appelant (contrat A29 §20).
  statut FinancialResultStatut @default(DRAFT)

  // "Date" métier minimale du contrat A29 §9/§21 — distincte de
  // `createdAt` (infra) par discipline, même si identique en pratique à
  // la création (même convention que DeliveryQualityGate.evaluatedAt,
  // A27). periodStart/periodEnd explicitement HORS PÉRIMÈTRE A29 (contrat
  // A29 §22 : "résultat sur le périmètre complet de la Mission", jamais
  // périodique dans ce lot) — extension future documentée, jamais
  // construite ici sans besoin démontré.
  calculatedAt      DateTime @default(now())
  calculatedByEmail String
  calculatedByRole  String

  // Succession EXPLICITE, jamais auto-détectée (contrat A29 §35/§36, voir
  // commentaire de modèle ci-dessus) — @unique empêche toute branche
  // (E1->E2->E3, jamais E1->{E2,E3}, même doctrine que DeliveryEvidence/
  // A26).
  supersedesId String?           @unique
  supersedes   FinancialResult? @relation("FinancialResultSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy FinancialResult? @relation("FinancialResultSuccession")

  createdAt      DateTime @default(now())
  createdByEmail String

  @@index([missionId])
}

// ============================================================================
// COMPANY ATLAS — A30 : LEARNING FOUNDATION (05/10/2026).
//
// Objectif (contrat A30, Learning Contract validé) : transformer
// l'expérience passée d'une Mission en connaissance traçable et
// réutilisable, sans jamais réécrire l'historique ni automatiser de
// décision future. Dernier maillon de la chaîne Need -> Solution ->
// Mission -> Talent/Capability -> Delivery -> Evidence -> Quality ->
// Outcome -> FinancialResult -> Learning -> Future Context.
//
// LEARNING != SOURCE (contrat A30 §3.1) : référence sa source par simple
// pointeur texte, jamais une relation Prisma forçant un champ inverse sur
// le modèle source (même discipline que OutcomeAssessment.decisionOptionId/
// SolutionOption.sourceOptionId, A6.1/V2.1-A, auditée en A30-AUDIT §6) —
// Deliverable/DeliverableVersion/WorkItem/DeliveryEvidence/
// DeliveryQualityGate/OutcomeAssessment/FinancialResult restent
// strictement INCHANGÉS par ce lot (contrat A30 §3.3, aucune modification
// d'un moteur précédent).
//
// LEARNING != DECISION (contrat A30 §3.3) : aucune route/service de ce
// lot ne modifie jamais Need/NeedFact/SolutionOption/CapabilityRequirement/
// Talent/Mission — un Learning reste une entrée CONTEXTUELLE potentielle
// pour une décision humaine future, jamais une décision elle-même.
//
// LEARNING != AI MEMORY (contrat A30 §3.4) : aucun embedding, aucun
// pgvector, aucun RAG, aucune recherche vectorielle, aucun knowledge
// graph, aucun pipeline LLM — substrat métier uniquement (table
// relationnelle classique, contenu texte libre).
model Learning {
  id String @id @default(cuid())

  // Source PRIMAIRE obligatoire (contrat A30 §7) — onDelete: Restrict
  // (jamais Cascade) : un Learning est un fait historique, il ne doit
  // jamais disparaître silencieusement si sa Mission source était
  // supprimée (même doctrine que FinancialResult/OutcomeAssessment).
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionId String

  // Source PRÉCISE optionnelle (contrat A30 §7/§8) — au plus UNE des sept
  // colonnes ci-dessous est renseignée (invariant contrôlé par le
  // service, jamais en base), jamais une table polymorphe générique
  // "LearningSource" (interdiction explicite contrat A30 §8, anti-patron
  // déjà présent dans ce schéma avec AuditEvent.objectId — audité et
  // délibérément non reproduit ici). Simples colonnes texte, jamais une
  // relation Prisma complète — même discipline que §3.1 ci-dessus : aucun
  // champ inverse n'est ajouté sur WorkItem/Deliverable/DeliverableVersion/
  // DeliveryEvidence/DeliveryQualityGate/OutcomeAssessment/FinancialResult.
  // Chacune est vérifiée par le service comme appartenant à la MÊME
  // Mission que `missionId` ci-dessus (contrat A30 §7, règle absolue) —
  // "introuvable" et "appartient à une autre Mission" produisent la même
  // erreur (même doctrine IDOR que A26/A27/A29).
  sourceWorkItemId             String?
  sourceDeliverableId          String?
  sourceDeliverableVersionId   String?
  sourceDeliveryEvidenceId     String?
  sourceDeliveryQualityGateId  String?
  sourceOutcomeAssessmentId    String?
  sourceFinancialResultId      String?

  // Typologie verrouillée par le Learning Contract (contrat A30 §5) —
  // volontairement les six valeurs explicitement listées par le mandat
  // d'implémentation (dérogeant à la réduction à 3 proposée par l'audit
  // A30-AUDIT §10 : le contrat validé par le CTO retient la typologie
  // complète). Aucun type ne change automatiquement un comportement
  // système (contrat A30 §5, dernière ligne) — champ purement descriptif,
  // jamais lu par aucune condition applicative hors validation d'entrée.
  type LearningType

  // Contenu minimal (contrat A30 §11) : `title` + `statement` doivent se
  // comprendre indépendamment de la source (jamais une simple référence
  // du type "voir Evidence X"). Écrit-une-fois : aucune route de ce lot
  // n'autorise la modification de ces deux champs après création (contrat
  // A30 §13, "ne jamais réécrire l'apprentissage historique" — une
  // correction de contenu crée une NOUVELLE ligne via supersession,
  // jamais une mutation en place).
  title     String
  statement String

  // Provenance (contrat A30 §3.2/§6) — distincte de `confidence`
  // ci-dessous (contrat A30 §12 : "INFERRED + HIGH reste une inférence").
  // INFERRED ne devient jamais automatiquement VERIFIED/DECLARED (contrat
  // A30 §3.2/§6, "aucune promotion automatique") — seule une nouvelle
  // ligne explicite (création humaine) peut porter une provenance
  // différente pour la même observation.
  provenance LearningProvenance

  // Confiance (contrat A30 §12) — jamais un score algorithmique, jamais
  // calculée : toujours déclarée explicitement par le créateur au moment
  // de la création, au même titre que provenance.
  confidence LearningConfidence

  // Portée d'applicabilité (contrat A30 §9) — MISSION par défaut,
  // jamais élargie automatiquement par le système (contrat A30 §9,
  // "la portée ne doit jamais être automatiquement élargie" — un
  // Learning créé pour une Mission reste limité à cette Mission tant
  // qu'un processus explicite ne l'élargit pas). Immuable après création
  // dans ce lot (aucun "moteur de réutilisation contrôlé" construit ici,
  // contrat A30 §17) : seul un ADMIN peut déclarer directement une
  // portée plus large qu'une Mission AU MOMENT de la création (jamais un
  // Ingénieur, contrôlé par le service — contrat A30 §18, "il ne doit
  // jamais pouvoir transformer seul une inférence en connaissance ATLAS
  // globale").
  scope LearningScope @default(MISSION)

  // Statut de VALIDATION (contrat A30 §18 "valider"/§22
  // "learning.validated") — distinct de `applicabilite` ci-dessous.
  // PROPOSE à la création quel que soit le rôle du créateur, jamais
  // choisi par l'appelant. Transition PROPOSE -> VALIDE réservée ADMIN
  // (contrat A30 §18), jamais l'inverse (même discipline append-only que
  // ClientNeedFait.statutActivite : une "dévalidation" créerait une
  // nouvelle ligne, jamais une réécriture). Ne modifie JAMAIS
  // `provenance` : valider un Learning INFERRED ne le transforme jamais
  // en VERIFIED (contrat A30 §3.2/§6, règle absolue).
  statut          LearningStatut @default(PROPOSE)
  validatedAt     DateTime?
  validatedByEmail String?

  // Statut d'APPLICABILITÉ (contrat A30 §10) — distinct de `statut`
  // ci-dessus : sépare la vérité historique (toujours vraie, jamais
  // supprimée) de la validité actuelle (peut devenir obsolète dans le
  // temps, même sans correction de contenu ni successeur). ACTIVE par
  // défaut, jamais OBSOLETE -> ACTIVE (réactivation = nouvelle ligne,
  // même discipline que NeedFactStatus/ClientNeedFait). Transition
  // traçable (`obsoleteAt`/`obsoleteByEmail`, même patron que
  // EmergencyStop.liftedAt/liftedBy) — réservée ADMIN (contrat A30 §18).
  applicabilite    LearningApplicabilite @default(ACTIVE)
  obsoleteAt       DateTime?
  obsoleteByEmail  String?

  // Succession EXPLICITE, jamais auto-détectée (contrat A30 §14, "le
  // caller doit explicitement déclarer la succession") — @unique empêche
  // toute branche concurrente (même doctrine que DeliveryEvidence/
  // OutcomeAssessment/FinancialResult, interdiction de branching). Cross-
  // Mission et cross-client structurellement impossibles : le service
  // vérifie que l'ancien Learning référencé appartient exactement à la
  // même Mission (donc au même client, Mission.clientId étant fixe)
  // avant toute création (contrat A30 §14). La création d'une ligne
  // successeur NE modifie JAMAIS l'ancienne ligne (ni son `statut`, ni
  // son `applicabilite`) — aucune automatisation, aucune mutation
  // silencieuse (contrat A30 §13).
  supersedesId String?    @unique
  supersedes   Learning?  @relation("LearningSuccession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Learning?  @relation("LearningSuccession")

  createdAt      DateTime @default(now())
  createdByEmail String
  createdByRole  String


  @@index([missionId])
  @@index([sourceWorkItemId])
  @@index([sourceDeliverableId])
  @@index([sourceDeliverableVersionId])
  @@index([sourceDeliveryEvidenceId])
  @@index([sourceDeliveryQualityGateId])
  @@index([sourceOutcomeAssessmentId])
  @@index([sourceFinancialResultId])
  @@index([statut])
  @@index([scope])
}

// Typologie verrouillée (contrat A30 §5) — six valeurs explicitement
// nommées par le Learning Contract. LESSON : constat factuel dérivé
// d'une expérience précise. PATTERN : récurrence observée à travers
// plusieurs expériences. BEST_PRACTICE : pratique jugée à reproduire.
// ANTI_PATTERN : approche jugée à éviter (distincte de BEST_PRACTICE,
// jamais un simple "négatif" de celle-ci — un évaluateur doit pouvoir
// distinguer "à faire" de "à éviter" au premier coup d'oeil). RECOMMENDATION :
// préconisation actionnable pour une future Mission similaire. INSIGHT :
// observation qualitative ne rentrant dans aucune des catégories
// précédentes. Aucune valeur ne déclenche de comportement système
// automatique (contrat A30 §5).
enum LearningType {
  LESSON
  PATTERN
  BEST_PRACTICE
  ANTI_PATTERN
  RECOMMENDATION
  INSIGHT
}

// Provenance verrouillée (contrat A30 §3.2/§6) — quatre valeurs
// explicitement nommées. OBSERVED : constat direct par le créateur,
// sans déclaration tierce. DECLARED : rapporté par un tiers (ex. un
// Ingénieur rapportant un fait vécu sur sa Mission). VERIFIED :
// vérification humaine active contre une source réelle. INFERRED :
// proposition d'une IA — jamais suffisant seul pour un Learning VALIDE
// sans revue humaine explicite (contrat A30 §3.2, "aucune promotion
// automatique"), même doctrine que OutcomeMethodeVerification.INFERE_IA
// (A6.1) et DeliveryEvidenceMethod côté Evidence (A26) — vocabulaire
// volontairement NON partagé entre domaines (contrat A6 §A6.3/§A6.10,
// "5e instance du même vocabulaire à dessein jamais partagée").
enum LearningProvenance {
  OBSERVED
  DECLARED
  VERIFIED
  INFERRED
}

// Confiance verrouillée (contrat A30 §12) — jamais confondue avec
// `LearningProvenance` ci-dessus (ex. "INFERRED + HIGH" reste une
// inférence, "VERIFIED + MEDIUM" reste vérifiée mais limitée en
// confiance). Jamais un score algorithmique (contrat A30 §12, "pas de
// scoring automatique") — toujours une déclaration humaine explicite au
// moment de la création.
enum LearningConfidence {
  LOW
  MEDIUM
  HIGH
}

// Portée verrouillée (contrat A30 §9) — cinq valeurs explicitement
// nommées. MISSION : expérience spécifique à cette Mission précise.
// CLIENT : réutilisable uniquement dans le contexte du même client.
// DOMAIN : connaissance réutilisable dans un domaine métier. CAPABILITY :
// connaissance liée à une capacité précise. ATLAS : connaissance
// généralisée à l'ensemble d'ATLAS. Jamais élargie automatiquement par
// le système (contrat A30 §9) — voir commentaire du champ `scope`
// ci-dessus pour la restriction de rôle à la création.
enum LearningScope {
  MISSION
  CLIENT
  DOMAIN
  CAPABILITY
  ATLAS
}

// Statut de VALIDATION (contrat A30 §18/§22) — PROPOSE à la création,
// VALIDE uniquement après une action ADMIN explicite ("valider"). Jamais
// l'inverse (append-only, même doctrine que NeedFactStatus). Distinct de
// LearningApplicabilite ci-dessous — deux axes indépendants (contrat A30
// §10 vs §18).
enum LearningStatut {
  PROPOSE
  VALIDE
}

// Statut d'APPLICABILITÉ (contrat A30 §10) — sépare la vérité historique
// (toujours vraie) de la validité actuelle (peut devenir obsolète).
// ACTIVE par défaut, jamais OBSOLETE -> ACTIVE (même discipline
// append-only que NeedFactStatus/ClientNeedFait.statutActivite — une
// réactivation crée un nouveau Learning, jamais une réécriture).
enum LearningApplicabilite {
  ACTIVE
  OBSOLETE
}

// ============================================================================
// COMPANY ATLAS — A32 : AGENTIC RUNTIME FOUNDATION (05/10/2026).
//
// Socle d'exécution contrôlée pour de futures boucles agentiques — PAS une
// boucle métier autonome (contrat A32 §1/§18). Implémente exactement le
// contrat validé par l'audit A31 : GOAL -> CONTEXT -> OBSERVE -> PROPOSE ->
// AUTHORIZE -> ACT -> VERIFY -> STOP/CONTINUE, sans jamais introduire de
// nouveau système Agent/RBAC/Permission/Approval/EmergencyStop/AuditEvent/
// Evidence/Learning/Outcome (contrat A32 §4, liste d'interdictions).
//
// ZÉRO MODIFICATION D'UN MODÈLE EXISTANT (B19/B20/B22/A18-A30) : toute
// référence vers AgentIdentity/AgentPermission/Decision/Delegation/
// AuthorizationRequest/EmergencyStop/Mission/ClientNeed/SolutionOption est
// un simple pointeur texte (String, jamais @relation) — même discipline
// que Learning.sourceFinancialResultId (A30) et OutcomeAssessment.
// decisionOptionId (A6.1) : une relation Prisma forcerait un champ inverse
// sur ces modèles, modification structurellement hors périmètre de ce
// lot. Vérifié par le service (lib/agentic/runtime.ts), jamais en base.
//
// AgenticLoopType/AgenticLoopVersion : contrat A32 §6 interdit explicitement
// une table "AgenticLoop" — un seul type technique de fondation ("FOUNDATION")
// existe pour ce lot ; le registre fermé des loopType/loopVersion valides
// vit dans le code (lib/agentic/runtime.ts::REGISTRE_LOOPS), jamais en base.
// L'enum ci-dessous reste additif (une future boucle ajoute une valeur,
// jamais une table parallèle).
enum AgenticLoopType {
  FOUNDATION
}

// Machine d'état validée par l'audit A31 §7, réduite à 9 états (WAITING_INPUT
// du contrat initial fusionné dans WAITING_APPROVAL — aucun flux existant
// n'a jamais eu besoin d'un second mécanisme de blocage sur une question
// humaine libre, voir A31 §7). SUCCEEDED/FAILED/STOPPED/ESCALATED sont
// terminaux — aucune route de ce lot ne permet de les rouvrir (contrat
// A32 §7, "aucun terminal state ne peut être réouvert").
enum AgenticRunStatut {
  DRAFT
  READY
  RUNNING
  WAITING_APPROVAL
  PAUSED
  SUCCEEDED
  FAILED
  STOPPED
  ESCALATED
}

// Vocabulaire FERMÉ (contrat A32 §11) — jamais une chaîne arbitraire
// fournie par le client. Couvre exactement les 11 catégories mandatées
// par A32.
enum AgenticStopReason {
  GOAL_REACHED
  MAX_ITERATIONS_REACHED
  TIMEOUT
  PERMISSION_DENIED
  APPROVAL_REJECTED
  INVARIANT_VIOLATION
  EXECUTION_ERROR
  VERIFICATION_FAILED
  EMERGENCY_STOP
  HUMAN_STOP
  ESCALATION_REQUIRED
}

// Deux formes de Step suffisent pour la fondation (contrat A31 §8 : une
// itération = UN passage OBSERVE->REASON->PROPOSE->AUTHORIZE->ACT->VERIFY,
// persisté comme UNE ligne à champs multiples, jamais une ligne par
// sous-étape — même discipline que DeliveryQualityGate, A27).
// OBSERVE_ONLY : la Step ne lit/observe que le contexte, ne produit aucune
// proposition (ex. vérification de contexte avant démarrage). PROPOSE_AND_ACT :
// la Step observe PUIS propose une action classée server-side (ActionClass,
// B22, réutilisé tel quel) — éventuellement suivie d'une autorisation et
// d'une tentative d'exécution via le Tool Registry.
enum AgenticStepType {
  OBSERVE_ONLY
  PROPOSE_AND_ACT
}

enum AgenticStepStatut {
  PENDING
  SUCCEEDED
  FAILED
}

enum ActionExecutionStatut {
  PENDING
  SUCCEEDED
  FAILED
}

model AgenticRun {
  id String @id @default(cuid())

  // Registre fermé CODE (lib/agentic/runtime.ts), jamais une table
  // "AgenticLoop" (contrat A32 §6). loopVersion est un entier simple,
  // validé contre le registre à la création — jamais incrémenté en place.
  loopType    AgenticLoopType @default(FOUNDATION)
  loopVersion Int

  // AgentIdentity (B19) — pointeur texte pur, jamais @relation (voir
  // commentaire de bloc ci-dessus). Validé par le service : doit exister
  // ET être ACTIVE au moment de la création (contrat A32 §13 : "AgentIdentity
  // ≠ utilisateur humain ≠ autorité métier" — ce champ documente SOUS QUELLE
  // identité déclarée le Run agit, jamais une autorité en lui-même).
  agentIdentityId String

  // Action/scope DÉCLARÉS pour toute la durée du Run — vocabulaire B20
  // réutilisé EXACTEMENT (AgentPermissionAction/AgentPermissionScope,
  // déjà présents dans ce schéma, jamais redéclarés). La classification
  // réelle (ActionClass) est TOUJOURS recalculée server-side à chaque
  // tentative de proposition (lib/control-plane/commitment.ts::classifierAction,
  // réutilisé tel quel, contrat A32 §15) — jamais fournie par le client,
  // jamais stockée ici en amont de cette classification.
  declaredAction AgentPermissionAction
  declaredScope  AgentPermissionScope

  goal String

  // Contexte PINNÉ, immuable après création (contrat A32 §12, A31 §13) —
  // jamais une relation Prisma (voir commentaire de bloc). Tous optionnels :
  // un Run FOUNDATION peut exister sans aucune Mission (ex. un run purement
  // diagnostique) ; si missionId est renseigné, needVersionId/solutionDecisionId
  // (si fournis) doivent être EXACTEMENT ceux déjà pinnés sur cette Mission
  // (Mission.needVersionId/solutionDecisionId, A18) — vérifié par le service
  // à la création (DRAFT) et revérifié à chaque reprise PAUSED->RUNNING
  // (contrat A32 §8 : "si le contexte n'est plus valide, ne reprends pas
  // silencieusement").
  missionId          String?
  needVersionId      String?
  solutionDecisionId String?

  statut AgenticRunStatut @default(DRAFT)

  // Borne stricte, positive, définie à la création, jamais modifiée
  // pendant le Run (contrat A32 §10) — plafonnée par le service
  // (lib/agentic/runtime.ts::MAX_ITERATIONS_PLAFOND) pour interdire toute
  // boucle infinie même à la création.
  maxIterations  Int
  iterationCount Int @default(0)

  // Pointeur texte pur vers l'AuthorizationRequest (B22) qui bloque
  // actuellement le Run en WAITING_APPROVAL — jamais @relation (voir
  // commentaire de bloc). NULL hors de cet état.
  currentAuthorizationRequestId String?

  stopReason   AgenticStopReason?
  resultSummary String?
  errorDetail   String?

  // Chaîne tous les événements Run->Step->ActionExecution (JournalActivite,
  // jamais AuditEvent B22 — contrat A32 §26, "AuditEvent reste réservé au
  // bounded context B22 existant"). Généré à la création, jamais fourni
  // par l'appelant (même discipline que lib/security/events.ts::nouveauCorrelationId).
  correlationId String

  createdAt      DateTime  @default(now())
  createdByEmail String
  createdByRole  String
  startedAt      DateTime?
  pausedAt       DateTime?
  resumedAt      DateTime?
  completedAt    DateTime?

  steps AgenticStep[]

  @@index([statut])
  @@index([missionId])
  @@index([agentIdentityId])
  @@index([correlationId])
}

model AgenticStep {
  id String @id @default(cuid())

  run   AgenticRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  runId String

  // Server-assigné, strictement croissant à partir de 1 par Run — jamais
  // choisi par l'appelant (même discipline que DeliverableVersion.version,
  // A25). @@unique ci-dessous est le filet de sécurité concurrence pour
  // le compteur d'itérations (contrat A32 §9/§10).
  stepIndex Int
  stepType  AgenticStepType

  // Conclusion d'observation, JAMAIS la chaîne de raisonnement brute d'un
  // LLM (contrat A32 §5, "ne crée pas de stockage de chain of thought") —
  // texte court, factuel, suffisant pour l'audit.
  observation String

  // Rempli uniquement pour PROPOSE_AND_ACT — jamais une conversion
  // implicite en action (contrat A32 §20 : Proposal -> Authorization ->
  // Action -> Verification, aucune étape sautée).
  proposal String?

  // Snapshot de la classification server-side AU MOMENT de cette Step
  // (lib/control-plane/commitment.ts::classifierAction, B22, réutilisé
  // tel quel — AUCUNE redéclaration d'enum, voir le champ lui-même qui
  // référence directement ActionClass, B22).
  actionClass ActionClass?

  // Pointeur texte pur vers l'AuthorizationRequest (B22) créée pour cette
  // Step, si la classification l'a exigé — jamais @relation.
  authorizationRequestId String?

  // Pointeur texte pur vers le Tool invoqué (registre CODE, lib/agentic/tools.ts)
  // — jamais une table Tool (contrat A32 §17, préférence registre code-first).
  toolId String?

  verificationResult  String?
  verificationPassed  Boolean?

  statut      AgenticStepStatut @default(PENDING)
  errorDetail String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  actionExecution ActionExecution?

  @@unique([runId, stepIndex])
  @@index([runId])
}

// Trace CHAQUE tentative d'invocation d'un Tool (contrat A32 §16) —
// distincte d'Evidence (A26, réutilisée SANS modification lorsqu'une
// action produit réellement une preuve métier, contrat A32 §24 : "ne crée
// pas une nouvelle table Evidence générique", "ActionExecution != Evidence").
// 1:1 avec AgenticStep dans ce lot (une Step propose au plus une action) —
// relation conservée extensible (pas de contrainte empêchant une évolution
// future), mais jamais exploitée au-delà de 1:1 ici.
model ActionExecution {
  id String @id @default(cuid())

  step   AgenticStep @relation(fields: [stepId], references: [id], onDelete: Restrict)
  stepId String      @unique
  // Dénormalisé depuis step.runId — vérification directe sans jointure,
  // même patron que SolutionOption.clientId (dénormalisation en lecture
  // seule, jamais une seconde source de vérité : toujours écrit depuis
  // step.runId par le service, jamais fourni par l'appelant).
  runId String

  toolId String

  // Clé d'idempotence serveur = `${runId}:${stepIndex}:${toolId}` — jamais
  // fournie par l'appelant (contrat A32 §16, A31 §14). @@unique est le
  // filet de sécurité concurrence contre une double exécution.
  idempotencyKey String @unique

  // Entrée VALIDÉE/normalisée réellement transmise au Tool — jamais une
  // copie brute non validée de l'entrée agent (contrat A32 §16/§30). Aucun
  // secret/token/mot de passe n'est jamais stocké ici (rédaction obligatoire
  // à la charge du Tool, même discipline que AuditEvent.metadata, B22, et
  // EvenementSecurite.detail, B16).
  inputNormalise Json?
  resultat       Json?

  statut      ActionExecutionStatut @default(PENDING)
  erreur      String?
  correlationId String

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([runId])
  @@index([toolId])
}
