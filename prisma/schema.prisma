model ClientNeedFait {
  id             String                 @id @default(cuid())
  need           ClientNeed             @relation(fields: [needId], references: [id], onDelete: Cascade)
  needId         String
  composanteId   String?
  cle            ClientNeedFaitCle
  valeur         String
  statut         StatutPreuveCompetence @default(INCONNU)
  statutActivite NeedFactStatus         @default(ACTIVE)
  source         String?
