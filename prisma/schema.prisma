// Base de données Atlas Quality Partners
// Deux modules publics : Connexion (/connexion) et Inscription (/inscription)
// 3 rôles : ADMIN (créé manuellement, jamais par inscription publique),
// INGENIEUR (s'inscrit lui-même, compte en attente jusqu'à validation admin),
// CLIENT (s'inscrit lui-même, espace suivi + documents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  SALARIE
  FREELANCE
  PORTAGE
}

enum Role {
  ADMIN       // accès complet : clients, profils, hypothèses, tous les contrats, coûts internes, validation des inscriptions
  INGENIEUR   // s'inscrit lui-même ; voit uniquement ses propres missions, aucune donnée tarifaire
  CLIENT      // s'inscrit lui-même ; voit le suivi et les documents de ses propres missions uniquement
}

enum StatutDocument {
  RAPPORT_AUDIT
  CONTRAT
  FACTURE
  AUTRE
}

// Compte de connexion — un seul par email, quel que soit le rôle.
// Un compte auto-inscrit (INGENIEUR ou CLIENT) démarre avec actif=false :
// il ne peut pas se connecter tant qu'un ADMIN ne l'a pas validé.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  actif        Boolean  @default(true) // false pour tout compte auto-inscrit, en attente de validation
  createdAt    DateTime @default(now())

  profilId     String?  @unique // renseigné pour un compte INGENIEUR : relie à sa fiche Profil (tarifs)
  profil       Profil?  @relation(fields: [profilId], references: [id])

  clientId     String?  @unique // renseigné pour un compte CLIENT : relie à sa fiche Client
  client       Client?  @relation(fields: [clientId], references: [id])
}

model Client {
  id                  String    @id @default(cuid())
  nom                 String    // raison sociale
  secteur             String?
  contactReferent     String?   // nom de la personne de contact côté client
  email               String?
  telephone           String?
  identifiantEntreprise String? // RC / RNE selon le pays
  formeJuridique      String?   // SARL, SA, EURL, Auto-entrepreneur, etc.
  statutPreferere     TypeContrat?
  dateDebutPrevue     DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  missions            Mission[]
  documents           Document[]
  compte              User?     // le compte de connexion du client, une fois inscrit
}

// Fiche interne d'un profil d'ingénieur. Créée automatiquement, vide de
// tarif, quand un ingénieur s'inscrit. Le type de contrat, le montant et le
// TJM ne sont plus fixés manuellement par l'Admin à la validation : ils sont
// déterminés après import + validation du CV (voir InfoCV), sur la base de
// l'analyse du profil (séniorité, compétences) — voir lib/analyse-profil.ts.
model Profil {
  id                  String       @id @default(cuid())
  nom                 String
  type                TypeContrat?
  montantSaisi        Float?       // laissé vide jusqu'à ce qu'un contrat soit négocié

  // Import & validation du CV (voir /ingenieur/cv et /ingenieur/cv/verifier)
  cvUrl               String?      // URL du fichier CV stocké (Vercel Blob)
  cvNomFichier        String?
  cvImporteLe         DateTime?
  cvValide            Boolean      @default(false) // true une fois toutes les InfoCV validées

  // Résultat de l'analyse du profil (déduit des InfoCV validées) — voir
  // lib/analyse-profil.ts. Champs laissés vides tant que l'analyse
  // automatique (IA) n'est pas branchée ; alimentables manuellement par
  // l'Admin en attendant.
  anneesExperience    Int?
  seniorite           String?      // "Junior" | "Confirmé" | "Senior" | "Expert"
  pointsForts         String?
  tjmEstime           Float?
  typeContratSuggere  TypeContrat?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  missions            Mission[]
  infosCv             InfoCV[]
  compte              User?
}

// Une information extraite (ou saisie) du CV d'un ingénieur, validée
// individuellement (bouton "OK") avant d'alimenter son profil. Aujourd'hui
// pré-remplie à vide (saisie manuelle guidée) ; conçue pour être pré-remplie
// automatiquement dès qu'un service d'extraction IA est branché (voir
// lib/cv-extraction.ts).
model InfoCV {
  id         String   @id @default(cuid())
  profil     Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId   String
  categorie  String   // "identite" | "contact" | "profil" | "competence" | "experience" | "formation"
  libelle    String   // ex: "Nom complet", "Compétences principales"
  valeur     String
  ordre      Int      @default(0)
  valide     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Mission {
  id            String     @id @default(cuid())
  repere        String?
  client        Client     @relation(fields: [clientId], references: [id])
  clientId      String
  profil        Profil     @relation(fields: [profilId], references: [id])
  profilId      String
  nbJours       Int
  margeCible    Float      @default(0.30)
  tjmVente      Float
  statut        String     @default("En cours") // En cours / Terminée / Annulée
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
}

// Document consultable par le client dans son espace (rapport d'audit,
// contrat signé, facture...). fileUrl pointe vers un stockage externe
// (Supabase Storage, S3...) — voir lib/storage.ts.
model Document {
  id         String         @id @default(cuid())
  titre      String
  type       StatutDocument @default(AUTRE)
  fileUrl    String
  mission    Mission?       @relation(fields: [missionId], references: [id])
  missionId  String?
  client     Client         @relation(fields: [clientId], references: [id])
  clientId   String
  createdAt  DateTime       @default(now())
}

model Hypotheses {
  id                 String @id @default("singleton")
  joursAn            Int    @default(218)
  chargesSalarie     Float  @default(0.42)
  fraisFreelance     Float  @default(0.08)
  overhead           Float  @default(0.15)
  margeDefaut        Float  @default(0.30)
}
