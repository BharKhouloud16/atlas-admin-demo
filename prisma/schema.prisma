  solutionOptions    SolutionOption[]
  // A6.1 — Outcome Foundation : un OutcomeAssessment pointe vers la version
  // EXACTE du Need qu'il évalue (needVersionId), jamais la version
  // courante recalculée — voir OutcomeAssessment. Relation Prisma réelle
  // (jamais une chaîne de traçabilité pure) pour garantir qu'un Outcome ne
  // puisse jamais pointer vers un ClientNeed inexistant ; n'affecte en rien
  // la logique de fork/versioning (lib/client-need/versioning.ts, non
  // modifiée par ce lot).
  outcomeAssessments OutcomeAssessment[]
  // A8 — Capability Engine V1 : un CapabilityRequirement pointe vers la
  // version EXACTE du Need qui l'a produit (needVersionId), même principe
  // que OutcomeAssessment.needVersionId ci-dessus — jamais la version
  // courante recalculée. Relation Prisma réelle (jamais une chaîne de
  // traçabilité pure) pour garantir qu'un CapabilityRequirement ne puisse
  // jamais pointer vers un ClientNeed inexistant ; n'affecte en rien la
  // logique de fork/versioning existante.
  capabilityRequirements CapabilityRequirement[]
  // A18 — Mission Need Pinning : une Mission peut pointer vers la version
  // EXACTE de ce Need (Mission.needVersionId) — jamais le Need courant.
  // Relation Prisma réelle (même discipline que outcomeAssessments/
