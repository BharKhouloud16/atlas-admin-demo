// Base de données Atlas Quality Partners
// Deux modules publics : Connexion (/connexion) et Inscription (/inscription)
// 3 rôles : ADMIN (créé manuellement, jamais par inscription publique),
// INGENIEUR (s'inscrit lui-même, compte en attente jusqu'à validation admin),
// CLIENT (s'inscrit lui-même, espace suivi + documents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  SALARIE
  FREELANCE
  PORTAGE
}

enum Role {
  ADMIN       // accès complet : clients, profils, hypothèses, tous les contrats, coûts internes, validation des inscriptions
  INGENIEUR   // s'inscrit lui-même ; voit uniquement ses propres missions, aucune donnée tarifaire
  CLIENT      // s'inscrit lui-même ; voit le suivi et les documents de ses propres missions uniquement
}

enum StatutDocument {
  RAPPORT_AUDIT
  CONTRAT
  FACTURE
  AUTRE
}

// Compte de connexion — un seul par email, quel que soit le rôle.
// Un compte auto-inscrit (INGENIEUR ou CLIENT) démarre avec actif=false :
// il ne peut pas se connecter tant qu'un ADMIN ne l'a pas validé.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  actif        Boolean  @default(true) // false pour tout compte auto-inscrit, en attente de validation
  createdAt    DateTime @default(now())

  // Vérification de l'adresse email à l'inscription (voir lib/email.ts,
  // app/api/auth/verifier-email/route.ts). Par défaut true pour ne jamais
  // bloquer un compte déjà existant (ADMIN créé en base, ou comptes créés
  // avant l'ajout de cette fonctionnalité) : seule l'inscription publique
  // (/api/auth/signup) le met explicitement à false pour un nouveau compte
  // INGENIEUR/CLIENT, le temps que le lien envoyé par email soit cliqué.
  emailVerifie             Boolean   @default(true)
  emailVerificationToken   String?   @unique
  emailVerificationExpire  DateTime?

  // Désactivation temporaire du compte par l'ingénieur lui-même (voir
  // /ingenieur -> "Mon compte"). Un compte désactivé peut toujours se
  // reconnecter (contrairement à actif=false) mais est redirigé vers
  // /ingenieur/compte-desactive tant qu'il ne s'est pas réactivé.
  desactive    Boolean   @default(false)
  desactiveLe  DateTime?

  profilId     String?  @unique // renseigné pour un compte INGENIEUR : relie à sa fiche Profil (tarifs)
  profil       Profil?  @relation(fields: [profilId], references: [id])

  clientId     String?  @unique // renseigné pour un compte CLIENT : relie à sa fiche Client
  client       Client?  @relation(fields: [clientId], references: [id])
}

model Client {
  id                  String    @id @default(cuid())
  nom                 String    // raison sociale
  secteur             String?
  contactReferent     String?   // nom de la personne de contact côté client
  email               String?
  telephone           String?
  identifiantEntreprise String? // RC / RNE selon le pays
  formeJuridique      String?   // SARL, SA, EURL, Auto-entrepreneur, etc.
  statutPreferere     TypeContrat?
  dateDebutPrevue     DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  missions            Mission[]
  documents           Document[]
  compte              User?     // le compte de connexion du client, une fois inscrit
}

// Fiche interne d'un profil d'ingénieur. Créée automatiquement, vide de
// tarif, quand un ingénieur s'inscrit. Le type de contrat, le montant et le
// TJM ne sont plus fixés manuellement par l'Admin à la validation : ils sont
// déterminés après import + validation du CV (voir InfoCV), sur la base de
// l'analyse du profil (séniorité, compétences) — voir lib/analyse-profil.ts.
model Profil {
  id                  String       @id @default(cuid())
  nom                 String
  type                TypeContrat?
  montantSaisi        Float?       // laissé vide jusqu'à ce qu'un contrat soit négocié

  // Import & validation du CV (voir /ingenieur/cv et /ingenieur/cv/verifier)
  cvUrl               String?      // URL du fichier CV stocké (Vercel Blob)
  cvNomFichier        String?
  cvImporteLe         DateTime?
  cvValide            Boolean      @default(false) // true une fois toutes les InfoCV validées

  // Résultat de l'analyse du profil (déduit des InfoCV validées) — voir
  // lib/analyse-profil.ts. Champs laissés vides tant que l'analyse
  // automatique (IA) n'est pas branchée ; alimentables manuellement par
  // l'Admin en attendant.
  anneesExperience    Int?
  seniorite           String?      // "Junior" | "Confirmé" | "Senior" | "Expert"
  pointsForts         String?
  tjmEstime           Float?
  typeContratSuggere  TypeContrat?

  // Questionnaire de disponibilité (voir /ingenieur/disponibilite), rempli
  // juste après la validation du CV, avant l'accès à l'espace ingénieur
  // (voir app/ingenieur/page.tsx). Réponses à choix prédéfinis.
  disponibilite              String?   // "Disponible immédiatement" | "En mission actuellement chez Atlas" | "En mission actuellement chez un autre client" | "Non disponible immédiatement"
  disponibilitePrevue        String?   // prévision (date/période) donnée par l'ingénieur si disponibilite = "Non disponible immédiatement"
  changerMissionActuelle     Boolean?  // souhaite changer de mission actuelle (si en mission, Atlas ou autre client)
  missionApres               String?   // "Nouvelle mission anticipée" | "Libre juste après" | "Non concerné"
  preavis                    String?   // ex: "Aucun / immédiat", "1 mois"...
  preavisPrecision           String?   // précision libre si preavis = "Autre"
  disponibiliteRenseigneeLe  DateTime?
  questionnaireValide        Boolean   @default(false) // true une fois le questionnaire soumis

  // Localisation & régime adapté (voir lib/localisation.ts) — permet de
  // proposer un profil/contrat adapté à la situation de l'ingénieur
  // (France, Maghreb, Golfe, etc.). regimeSuggere est calculé
  // automatiquement à partir de paysResidence, à titre indicatif.
  nationalite                String?   // choisie dans une liste fermée (voir lib/localisation.ts, NATIONALITES)
  nationalitePrecision       String?   // précision libre si nationalite = "Autre"
  paysResidence              String?
  paysResidencePrecision     String?   // précision libre si paysResidence = "Autre"
  regimeSuggere              String?

  // Prétention salariale (TJM souhaité) déclarée par l'ingénieur, dans la
  // devise de son choix (internationale ou locale à son pays de
  // résidence) — voir lib/localisation.ts (DEVISES, convertirEnEur).
  // Permet à l'Admin de comparer avec tjmEstime et de proposer, à budget
  // client égal, le profil le plus compétitif selon la localisation.
  tjmSouhaite                Float?
  tjmSouhaiteDevise          String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  missions            Mission[]
  infosCv             InfoCV[]
  compte              User?
}

// Une information extraite (ou saisie) du CV d'un ingénieur, validée
// individuellement (bouton "OK") avant d'alimenter son profil. Aujourd'hui
// pré-remplie à vide (saisie manuelle guidée) ; conçue pour être pré-remplie
// automatiquement dès qu'un service d'extraction IA est branché (voir
// lib/cv-extraction.ts).
model InfoCV {
  id         String   @id @default(cuid())
  profil     Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId   String
  categorie  String   // "identite" | "contact" | "profil" | "competence" | "experience" | "formation"
  libelle    String   // ex: "Nom complet", "Compétences principales"
  valeur     String
  ordre      Int      @default(0)
  valide     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Mission {
  id            String     @id @default(cuid())
  repere        String?
  client        Client     @relation(fields: [clientId], references: [id])
  clientId      String
  profil        Profil     @relation(fields: [profilId], references: [id])
  profilId      String
  nbJours       Int
  margeCible    Float      @default(0.30)
  tjmVente      Float
  statut        String     @default("En cours") // En cours / Terminée / Annulée
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
}

// Document consultable par le client dans son espace (rapport d'audit,
// contrat signé, facture...). fileUrl pointe vers un stockage externe
// (Supabase Storage, S3...) — voir lib/storage.ts.
model Document {
  id         String         @id @default(cuid())
  titre      String
  type       StatutDocument @default(AUTRE)
  fileUrl    String
  mission    Mission?       @relation(fields: [missionId], references: [id])
  missionId  String?
  client     Client         @relation(fields: [clientId], references: [id])
  clientId   String
  createdAt  DateTime       @default(now())
}

// Demande de contact / prise de rendez-vous depuis le site public (page
// d'accueil, bouton "Reserver un appel de 30 minutes" et formulaire de
// contact -- voir app/reserver-appel/page.tsx). Volontairement en acces
// libre, SANS creation de compte : on ne recupere qu'un minimum
// d'informations, l'equipe Atlas recontacte ensuite pour caler l'appel.
// Consultee et traitee cote Admin (voir app/admin/demandes/page.tsx).
model DemandeContact {
id              String   @id @default(cuid())
nom             String
email           String
entreprise      String?
telephone       String?
message         String?
creneauSouhaite String?
traite          Boolean  @default(false)
createdAt       DateTime @default(now())
}

model Hypotheses {
  id                 String @id @default("singleton")
  joursAn            Int    @default(218)
  chargesSalarie     Float  @default(0.42)
  fraisFreelance     Float  @default(0.08)
  overhead           Float  @default(0.15)
  margeDefaut        Float  @default(0.30)
}
