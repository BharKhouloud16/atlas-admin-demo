// COMPANY ATLAS — LOT 2 : Client Need Intelligence Foundation (15/09/2026).
//
// Modèle générique de besoin, indépendant de DemandeTalent (non modifiée,
// non remplacée) — voir le rapport de revue architecturale : DemandeTalent
// est structurellement Talent-only (colonnes fixes) et ne porte qu'une
// provenance GLOBALE (analyseProvider/analyseConfiance pour toute la
// demande), jamais champ par champ. ClientNeed capture le besoin brut ;
// ClientNeedFait porte CHAQUE information individuellement, avec sa propre
// provenance — même discipline "une ligne par fait" que ProfilCompetence +
// SkillEvidence (Skill Graph), appliquée ici au besoin plutôt qu'à une
// compétence de profil.
//
// AUCUN champ de routage (Talent/ATLAS OS/Both) sur ce modèle — décision
// architecturale explicite (revue CEO) : le routage n'est pas une propriété
// d'entrée du besoin, seulement une hypothèse exploratoire parmi les faits
// (voir ClientNeedFaitCle.HYPOTHESE_DOMAINE_SOLUTION ci-dessous), jamais une
// colonne structurante qui biaiserait prématurément vers Talent (seul
// domaine réellement câblé aujourd'hui).
enum ClientNeedStatut {
  BROUILLON
  SOUMIS
  A_CLARIFIER
  VALIDE
  ARCHIVE
}

enum ClientNeedCoherenceStatut {
  COHERENT
  INCONSISTENT
  NEEDS_CLARIFICATION
  UNKNOWN
}

model ClientNeed {
  id                 String                    @id @default(cuid())
  client             Client                    @relation(fields: [clientId], references: [id])
  clientId           String
  correlationId      String
  // Jamais réécrit — la saisie originale du client reste consultable même
  // après extraction/correction (même principe que DemandeTalent.description).
  texteOriginal      String
  titre              String?
  statut             ClientNeedStatut          @default(BROUILLON)
  coherenceStatut    ClientNeedCoherenceStatut @default(UNKNOWN)
  // Liste de {regle, statut, explication} — voir lib/client-need/coherence.ts.
  coherenceDetail    Json?
  analyseProvider    String?
  analyseeLe         DateTime?
  faits              ClientNeedFait[]
  // LOT 5 : présent (non-null) une fois qu'un ADMIN a explicitement créé une
  // DemandeTalent à partir de ce besoin (voir DemandeTalent.sourceNeedId).
  // Jamais renseigné automatiquement.
  demandeTalentCreee DemandeTalent?
  // V2.1-A : options/recommandations/décisions C3 Solution Intelligence
  // rattachées à ce besoin (voir SolutionOption ci-dessous) — relation
  // requise par Prisma en contrepartie de SolutionOption.need, aucun champ
  // existant modifié.
  solutionOptions    SolutionOption[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([clientId])
}

// Vocabulaire FERMÉ des attributs représentables — un nouvel attribut
// (y compris futur ATLAS OS) s'ajoute comme une nouvelle valeur d'enum,
// jamais comme une nouvelle colonne : c'est ce qui rend ClientNeed
// évolutif sans reconstruction (voir revue architecturale, point 2).
enum ClientNeedFaitCle {
  OBJECTIF
  CONTEXTE
  PROBLEME
  RESULTAT_ATTENDU
  ROLE
  QUANTITE
  SENIORITE
  ANNEES_EXPERIENCE_MIN
  COMPETENCE
  BUDGET_MONTANT
  BUDGET_DEVISE
  BUDGET_TYPE
  BUDGET_FREQUENCE
  DUREE
  DATE_DEBUT
  DISPONIBILITE
  LOCALISATION
  REMOTE
  CONTRAINTE
  CRITERE_REUSSITE
  PRIORITE
  RISQUE
  PREFERENCE
  // Hypothèse exploratoire UNIQUEMENT (voir revue architecturale, point 1) —
  // toujours écrite avec statut INFERE, jamais consommée par une décision
  // ou une règle de cohérence dans ce lot. Le nom porte "HYPOTHESE"
  // explicitement pour ne jamais être confondue avec une décision de
  // routage réelle.
  HYPOTHESE_DOMAINE_SOLUTION
}

// Une ligne par information individuelle du besoin — jamais un formulaire
// obligatoire : un ClientNeed peut n'avoir que 2-3 ClientNeedFait si le
// texte du client n'en dit pas plus (voir §9 du besoin incomplet).
//
// `statut` réutilise StatutPreuveCompetence (VERIFIE/DECLARE/INFERE/INCONNU,
// Skill Graph, non modifié) tel quel — aucun second vocabulaire de
// provenance créé (directive explicite de la mission).
//
// `composanteId` : réservé pour une future évolution multi-composantes
// ("2 QA + 1 Lead"), TOUJOURS NULL dans ce lot — aucune logique de LOT 2 ne
// le lit ni ne l'écrit avec une valeur non-null (voir revue architecturale,
// point 3). Pas de contrainte d'unicité sur (needId, cle) : plusieurs clés
// (COMPETENCE, CONTRAINTE, CRITERE_REUSSITE, PRIORITE, RISQUE, PREFERENCE)
// sont répétables par nature — l'appliquer au niveau base figerait
// prématurément le modèle.
model ClientNeedFait {
  id           String                 @id @default(cuid())
  need         ClientNeed             @relation(fields: [needId], references: [id], onDelete: Cascade)
  needId       String
  composanteId String?
  cle          ClientNeedFaitCle
  valeur       String
  statut       StatutPreuveCompetence @default(INCONNU)
  source       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([needId])
}

// COMPANY ATLAS — V2.1-A : C3 Solution Intelligence, socle data (16/09/2026).
//
// SolutionOption porte toute la chaîne de gouvernance FAIT→SIGNAL→
// HYPOTHESE→OPTION→RECOMMANDATION→DECISION pour un ClientNeed donné — un
// seul modèle append-only, même discipline que ClientProfileFact (jamais
// d'UPDATE/DELETE, une nouvelle ligne pour chaque nouvel élément de la
// chaîne). `niveau` utilise un vocabulaire dédié (NiveauCertitudeSolution),
// volontairement PAS StatutProfilFait ni StatutPreuveCompetence ni
// ShortlistEntree.statut — même principe de séparation des domaines déjà
// appliqué pour ClientProfileFact vis-à-vis de StatutPreuveCompetence (voir
// plus haut) : la gouvernance C3 (Client-facing) ne doit jamais dépendre du
// vocabulaire de staffing interne (Admin-facing) et inversement.
//
// V2.1-A ne crée que le socle : aucune logique de calcul, de comparaison,
// d'adaptation Talent→Client ni de décision n'est implémentée ici (voir
// V2.1-B/C/D). FAIT et SIGNAL ne sont volontairement jamais persistés comme
// SolutionOption (calculés à la volée en amont, même principe que le signal
// de récurrence de ClientProfile) — seules HYPOTHESE et les niveaux
// suivants donnent lieu à une ligne.
model SolutionOption {
  id              String                  @id @default(cuid())
  need            ClientNeed              @relation(fields: [needId], references: [id], onDelete: Cascade)
  needId          String
  // Dénormalisé depuis need.clientId — vérification d'ownership directe en
  // une seule lecture, même patron que Document/Message ; ne provient et ne
  // doit jamais provenir d'une entrée utilisateur (session uniquement, côté
  // API — aucune API n'est créée dans cette étape).
  client          Client                  @relation(fields: [clientId], references: [id])
  clientId        String
  niveau          NiveauCertitudeSolution
  typeSolution    TypeSolution
  titre           String
  justification   String
  // Evidence structurée (compétences correspondantes, contraintes
  // satisfaites/non satisfaites, etc.) — jamais une copie des données
  // sources (ClientNeedFait/DemandeTalent), même rôle que
  // ShortlistEntree.motifs côté staffing interne.
  donnees         Json
  // Auto-référence traçant la chaîne (RECOMMANDATION pointe vers la ou les
  // OPTION dont elle dérive, DECISION pointe vers la RECOMMANDATION
  // décidée) — volontairement une simple colonne, pas une relation Prisma,
  // même mécanisme que ClientProfileFact.confirmeDepuis : aucune contrainte
  // FK, résolue en code applicatif (V2.1-B/D), jamais de mutation en place.
  sourceOptionId  String?
  // Référence de traçabilité pure vers une DemandeTalent existante, jamais
  // une relation Prisma complète : une relation forcerait un champ inverse
  // sur DemandeTalent, donc une modification de ce modèle, explicitement
  // exclue de ce lot. Renseigné uniquement quand typeSolution=TALENT et
  // qu'une DemandeTalent a déjà été créée par un Admin (LOT 5, inchangé) —
  // jamais créée automatiquement depuis C3.
  demandeTalentId String?
  // Renseignés uniquement quand niveau=DECISION — aucune logique de
  // décision n'est implémentée dans cette étape (voir V2.1-D).
  decideParEmail  String?
  decideLe        DateTime?
  createdAt       DateTime                @default(now())

  @@index([needId])
  @@index([clientId])
}

enum NiveauCertitudeSolution {
  FAIT
  SIGNAL
  HYPOTHESE
  OPTION
  RECOMMANDATION
  DECISION
}

// Un seul type pour cette étape — SERVICE/AUTRE seront ajoutés uniquement
// si un besoin réel (ex. ATLAS APPLICATION) le justifie, jamais par
// anticipation (voir revue architecturale, point ouvert de la conception).
enum TypeSolution {
  TALENT
}

// COMPANY ATLAS — LOT 4 : Profil Client Intelligence Foundation (15/09/2026).
//
// ClientProfile / ClientProfileFact : représentation DURABLE du client
// ("qui est ce client et comment fonctionne-t-il"), distincte de ClientNeed
// ("de quoi a-t-il besoin maintenant", LOT 2/3, jamais copié ici — les
// rubriques Besoins/Résultats du Profil lisent ClientNeed/Mission
// directement, aucune duplication). Même philosophie que ClientNeedFait :
// historique intégralement ADDITIF, jamais d'écrasement.
//
// Différence structurante avec ClientNeedFait (LOT 3) : la quasi-totalité
// des clés du Profil sont RÉPÉTABLES (plusieurs contraintes/objectifs
// valides simultanément) — "dernière valeur par clé gagne"
// (lib/client-need/faits.ts) ne s'applique donc PAS ici, sauf pour l'unique
// clé singleton CONTEXTE_ACTIVITE. Pour les clés répétables, l'état actif
// est déterminé par SUPERSESSION LOGIQUE via `confirmeDepuis` (voir
// lib/client-profile/faits.ts, instancesActivesParCle) : une ligne
// confirmée devient logiquement inactive dès qu'une ligne ultérieure la
// référence par `confirmeDepuis`, sans jamais être supprimée ni modifiée.
model ClientProfile {
  id        String              @id @default(cuid())
  client    Client              @relation(fields: [clientId], references: [id])
  clientId  String              @unique
  faits     ClientProfileFact[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// Vocabulaire FERMÉ — un nouvel attribut s'ajoute comme une nouvelle valeur
// d'enum, jamais une nouvelle colonne (même principe que ClientNeedFaitCle).
// CONTEXTE_ACTIVITE est la seule clé singleton ; les 8 autres sont
// répétables par nature.
enum ClientProfileFaitCle {
  CONTEXTE_ACTIVITE
  ENJEU
  OBJECTIF_DURABLE
  PRIORITE_DURABLE
  CONTRAINTE_DURABLE
  PREFERENCE_DURABLE
  CRITERE_REUSSITE_DURABLE
  RISQUE_DURABLE
  BESOIN_RECURRENT_CONFIRME
}

// Une ligne par information individuelle du profil — jamais un formulaire
// obligatoire. `statut` réutilise StatutPreuveCompetence tel quel (aucun
// second vocabulaire de provenance créé). `confirmeDepuis` : id de la ligne
// que CETTE ligne confirme/supersède (nullable, auto-référence) — c'est le
// seul mécanisme nécessaire pour déterminer la supersession logique (voir
// commentaire du modèle ci-dessus) ; aucune colonne de suppression/statut
// "actif" séparée. Pas de contrainte d'unicité sur (profileId, cle) :
// plusieurs instances valides simultanément pour les clés répétables.
model ClientProfileFact {
  id             String               @id @default(cuid())
  profile        ClientProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  cle            ClientProfileFaitCle
  valeur         String
  statut         StatutProfilFait     @default(INCONNU)
  source         String?
  confirmeDepuis String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([profileId])
}

enum StatutPreuveCompetence {
  VERIFIE
  DECLARE
  INFERE
  INCONNU
