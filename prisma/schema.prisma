// Base de données Atlas Quality Partners
// Deux modules publics : Connexion (/connexion) et Inscription (/inscription)
// 3 rôles : ADMIN (créé manuellement, jamais par inscription publique),
// INGENIEUR (s'inscrit lui-même, compte en attente jusqu'à validation admin),
// CLIENT (s'inscrit lui-même, espace suivi + documents)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeContrat {
  SALARIE
  FREELANCE
  PORTAGE
}

enum Role {
  ADMIN // accès complet : clients, profils, hypothèses, tous les contrats, coûts internes, validation des inscriptions
  INGENIEUR // s'inscrit lui-même ; voit uniquement ses propres missions, aucune donnée tarifaire
  CLIENT // s'inscrit lui-même ; voit le suivi et les documents de ses propres missions uniquement
}

enum StatutDocument {
  RAPPORT_AUDIT
  CONTRAT
  FACTURE
  AUTRE
}

// Compte de connexion — un seul par email, quel que soit le rôle.
// Un compte auto-inscrit (INGENIEUR ou CLIENT) démarre avec actif=false :
// il ne peut pas se connecter tant qu'un ADMIN ne l'a pas validé.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  actif        Boolean  @default(true) // false pour tout compte auto-inscrit, en attente de validation
  createdAt    DateTime @default(now())

  // Traçabilité pour la nouvelle rubrique Admin "Ingénieurs" (liste des
  // comptes validés, voir /admin/ingenieurs) : quand le compte a été validé
  // par un Admin, et sa toute première connexion réussie.
  valideLe            DateTime?
  premiereConnexionLe DateTime?

  // Vérification de l'adresse email à l'inscription (voir lib/email.ts,
  // app/api/auth/verifier-email/route.ts). Par défaut true pour ne jamais
  // bloquer un compte déjà existant (ADMIN créé en base, ou comptes créés
  // avant l'ajout de cette fonctionnalité) : seule l'inscription publique
  // (/api/auth/signup) le met explicitement à false pour un nouveau compte
  // INGENIEUR/CLIENT, le temps que le lien envoyé par email soit cliqué.
  emailVerifie            Boolean   @default(true)
  emailVerificationToken  String?   @unique
  emailVerificationExpire DateTime?

  // Reinitialisation de mot de passe oublie (B14). Colonnes nullables, jamais renseignees par defaut, a usage unique.
  resetPasswordToken  String?   @unique
  resetPasswordExpire DateTime?

  // Désactivation temporaire du compte par l'ingénieur lui-même (voir
  // /ingenieur -> "Mon compte"). Un compte désactivé peut toujours se
  // reconnecter (contrairement à actif=false) mais est redirigé vers
  // /ingenieur/compte-desactive tant qu'il ne s'est pas réactivé.
  desactive   Boolean   @default(false)
  desactiveLe DateTime?

  // Consentement RGPD au traitement des données (voir /confidentialite),
  // recueilli obligatoirement à l'inscription pour un compte INGENIEUR ou
  // CLIENT (case à cocher, voir /inscription). Sert de preuve de
  // consentement (horodatage) — n'affecte pas les comptes ADMIN, créés
  // manuellement en base.
  consentementRgpd   Boolean   @default(false)
  consentementRgpdLe DateTime?

  profilId String? @unique // renseigné pour un compte INGENIEUR : relie à sa fiche Profil (tarifs)
  profil   Profil? @relation(fields: [profilId], references: [id])

  clientId String? @unique // renseigné pour un compte CLIENT : relie à sa fiche Client
  client   Client? @relation(fields: [clientId], references: [id])

  // Verrouillage progressif après échecs de connexion successifs (voir
  // app/api/auth/login/route.ts, lib/rate-limit.ts) : ralentit un bruteforce
  // ciblé sur un compte précis sans dépendre d'un service externe type
  // Redis. Remis à zéro dès qu'une connexion réussit.
  echecsConnexion  Int       @default(0)
  verrouilleJusqua DateTime?

  // Authentification à deux facteurs (TOTP) — pour l'instant réservée au
  // rôle ADMIN (le compte le plus sensible, accès aux coûts/marges
  // internes). totpSecret reste vide tant que la configuration n'est pas
  // terminée (voir /admin -> "Sécurité", app/api/auth/2fa).
  totpSecret       String?
  totpActif        Boolean @default(false)
  totpCodesSecours String? // JSON string[] de codes à usage unique (hashés bcrypt)
}

// Throttle par IP sur les endpoints sensibles (connexion, inscription) —
// complète le verrouillage par compte ci-dessus : protège aussi contre un
// bruteforce réparti sur plusieurs emails (y compris des emails qui
// n'existent pas, contre lesquels le verrouillage par compte ne peut rien).
// Fenêtre glissante simple en base plutôt qu'un service externe (Redis...),
// suffisant pour le volume de cette démo — voir lib/rate-limit.ts.
model TentativeIp {
  id           String   @id @default(cuid())
  cle          String   @unique // ex. "login:1.2.3.4"
  compteur     Int      @default(0)
  fenetreDebut DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Journal d'audit des actions administratives sensibles (validation de
// compte, création d'un profil avec son TJM initial, rejet d'un CRA...) —
// voir lib/audit.ts. Attendu par tout client ESN/staffing sérieux : qui a
// fait quoi, et quand. Consultable dans /admin/journal.
model JournalActivite {
  id          String   @id @default(cuid())
  acteurEmail String
  acteurRole  Role
  action      String // ex. "validation_compte", "creation_profil", "rejet_cra"
  cible       String? // id de l'entité concernée (userId, profilId, feuilleId...)
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// ATLAS OS — TRUST & SECURITY INTELLIGENCE FOUNDATION (Batch 16, 08/09/2026)
// Événement de sécurité TRANSVERSE (runtime), distinct de JournalActivite
// ci-dessus : JournalActivite trace des actions MÉTIER déjà accomplies
// (validation de compte, rejet CRA...) et reste inchangé (aucune
// modification, aucune duplication). EvenementSecurite trace tout
// événement PERTINENT POUR LA SÉCURITÉ, y compris les échecs et refus
// (échec de connexion, verrouillage, refus RBAC, génération de contrat) —
// ce que JournalActivite ne capture pas aujourd'hui (il n'écrit qu'en cas
// de succès d'une action métier). Voir lib/security/events.ts.
//
// Champ par champ, respecte le modèle transverse demandé : acteur
// (acteurEmail/acteurRole/acteurId), action, ressource
// (ressourceType/ressourceId), contexte (contexteIp/contexteRoute),
// résultat, timestamp (createdAt), severite, correlationId (regroupe
// plusieurs événements liés à une même requête/tentative).
//
// Aucune donnée sensible : jamais de mot de passe, token, secret, hash —
// voir lib/security/events.ts, detail est plafonné et jamais une stack
// trace. Écriture best-effort (même discipline que journaliser() /
// lib/audit.ts) : un échec d'écriture ne bloque jamais l'action réelle.
enum ResultatEvenementSecurite {
  SUCCES
  REFUSE
  ERREUR
}

enum SeveriteEvenementSecurite {
  INFO
  ATTENTION
  ALERTE
}

model EvenementSecurite {
  id            String @id @default(cuid())
  correlationId String // regroupe les événements d'une même requête/tentative

  acteurEmail String?
  acteurRole  Role?
  acteurId    String?

  action        String // vocabulaire fermé côté lib/security/events.ts, ex. "auth.login.echec"
  ressourceType String?
  ressourceId   String?

  contexteIp    String?
  contexteRoute String?

  resultat ResultatEvenementSecurite
  severite SeveriteEvenementSecurite @default(INFO)
  detail   String? // texte court, jamais de secret/stack trace (plafonné en code)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([acteurEmail])
  @@index([correlationId])
}

// Interface de la boucle d'amélioration continue demandée (OBSERVE ->
// ANALYSE -> PROPOSE -> SIMULE -> VALIDATION HUMAINE -> CHANGE -> MESURE) :
// seuls OBSERVE (EvenementSecurite), ANALYSE (lib/security/runtime-signals.ts)
// et PROPOSE/VALIDATION HUMAINE (ce modèle + ses routes) existent à ce
// stade. AUCUN mécanisme d'application automatique (CHANGE) n'existe dans
// ce lot, et c'est volontaire — voir lib/security/runtime-risk.ts et
// app/api/security/propositions : une proposition ne modifie jamais seule
// une permission, une règle de sécurité ou une donnée. Elle reste à l'état
// PROPOSEE jusqu'à une décision humaine explicite (APPROUVEE/REJETEE),
// tracée (decideParEmail/decideLe/motifDecision) — et même APPROUVEE ne
// déclenche aujourd'hui aucune action automatique : la mise en œuvre reste
// manuelle, hors périmètre de ce lot (voir rapport final, limites).
enum StatutPropositionSecurite {
  PROPOSEE
  APPROUVEE
  REJETEE
}

model PropositionSecurite {
  id              String                    @id @default(cuid())
  origine         String // ex. "SIGNAL:acces_refuses_repetes" ou "MANUEL:admin-demo@example.com" — traçabilité de la source
  titre           String
  description     String
  statut          StatutPropositionSecurite @default(PROPOSEE)
  proposeParEmail String? // null si générée depuis un signal plutôt que saisie par un humain
  proposeLe       DateTime                  @default(now())
  decideParEmail  String?
  decideLe        DateTime?
  motifDecision   String?

  @@index([statut])
  @@index([proposeLe])
}

// ============================================================================
// COMPANY ATLAS — B19 (08/09/2026) : AGENT IDENTITY FOUNDATION.
// Première fondation technique du Control Plane (Master Architecture V1,
// section D) : donner à COMPANY ATLAS un registre d'identités techniques
// pour ses 4 agents officiels, distinctes des comptes User humains
// (ADMIN/INGENIEUR/CLIENT). Périmètre strictement limité à B19 : un
// REGISTRE, rien d'autre — pas de permissions, pas de capabilities, pas
// d'authentification agent complète (voir lib/agents/identity.ts pour la
// limite documentée). Les 4 lignes sont créées de façon déterministe par
// la migration elle-même (voir migration.sql) : AUCUNE route de création
// n'existe (pas de POST), pour garantir qu'un 5e agent ne peut jamais être
// introduit, même par erreur applicative.
enum AgentOfficiel {
  PRINCIPAL
  ATLAS_TALENT
  ATLAS_OS_SERVICES
  COMPANY_OS
}

enum AgentIdentityStatut {
  ACTIVE
  DISABLED
}

model AgentIdentity {
  id String @id // volontairement PAS @default(cuid()) : les 4 lignes sont seedées avec un identifiant déterministe fixe par la migration (voir migration.sql), jamais généré à la volée — cohérent avec le caractère fermé et non créable de ce registre.

  agent        AgentOfficiel       @unique // vocabulaire fermé, exactement les 4 agents officiels — @unique interdit toute deuxième ligne pour le même agent
  nomTechnique String // nom technique stable, ex. "atlas-talent" — usage interne/documentation, ne sert pas encore de mécanisme d'authentification (voir limite ci-dessus)
  statut       AgentIdentityStatut @default(ACTIVE)
  description  String?
  version      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions           AgentPermission[] // B20 — voir modèle ci-dessous
  rapports              RapportAgent[] // B18-FIX — voir modèle plus bas
  strategicPropositions StrategicActionProposal[] // B21 — voir modèle plus bas
  decisions             Decision[] // B22 — voir modèle plus bas
  delegations           Delegation[] // B22
  authorizationRequests AuthorizationRequest[] // B22
  auditEvents           AuditEvent[] // B22

  @@index([statut])
}

// ============================================================================
// COMPANY ATLAS — B20 (09/09/2026) : PERMISSION REGISTRY.
// Deuxième brique du Control Plane, après AgentIdentity (B19) ci-dessus,
// dans l'ordre strict IDENTITÉ -> PERMISSION -> CAPABILITY -> RISK ->
// APPROVAL -> AUTONOMY (Master Architecture V1, directive B20). Référence
// TOUJOURS un agent par sa clé étrangère agentId -> AgentIdentity.id,
// jamais par un enum agent dupliqué — AgentIdentity reste l'UNIQUE source
// de vérité pour l'identité d'un agent (directive B20, règles 1 et 2).
//
// Une permission ici est une CAPACITÉ POTENTIELLEMENT AUTORISÉE, jamais la
// preuve qu'une action a été exécutée : aucun moteur d'autorisation ne
// consomme encore ces lignes (voir lib/agents/permissions.ts). Volontai-
// rement AUCUN scope "ALL"/"GLOBAL" dans AgentPermissionScope ci-dessous :
// un agent ne peut structurellement jamais recevoir un accès global ou un
// super-pouvoir implicite (directive B20, règles 7 et 8 — le Principal ne
// doit pas devenir un super-admin technique). Seed volontairement minimal
// et justifié par le périmètre réel de chaque agent (voir migration.sql) :
// aucune permission n'est créée "au cas où".
enum AgentPermissionAction {
  READ
  WRITE
  EXECUTE
  PROPOSE
  REPORT
  ANALYZE
}

enum AgentPermissionScope {
  TALENT
  SECURITY
  COMPANY_OS
  PRINCIPAL
}

enum AgentPermissionStatut {
  ACTIVE
  DISABLED
}

model AgentPermission {
  id String @id // déterministe, seedé par la migration — même discipline que AgentIdentity.id (B19), jamais généré à la volée.

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id])

  action      AgentPermissionAction
  scope       AgentPermissionScope
  statut      AgentPermissionStatut @default(ACTIVE)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, action, scope])
  @@index([agentId])
  @@index([statut])
}

// ============================================================================
// COMPANY ATLAS — B18-FIX (10/09/2026) : AGENT IDENTITY RECONCILIATION.
// Reconstruction propre de B18 (registre structuré de rapports
// inter-agents, Charte de Gouvernance V1.0 section I) directement sur la
// base de main actuel (B19 AgentIdentity + B20 AgentPermission déjà
// fusionnés ci-dessus). La branche b18-registre-rapports d'origine
// (PR #1, ouverte le 08/09/2026, jamais fusionnée) référençait chaque
// rapport par un enum libre AgentEmetteur (4 valeurs dupliquant
// exactement AgentOfficiel/AgentIdentity de B19) — voir le rapport
// d'audit B18 pré-fix pour le détail complet de ce constat. Cette
// reconstruction n'introduit JAMAIS AgentEmetteur ni AGENTS_EMETTEURS :
// RapportAgent.agentId référence directement AgentIdentity.id (FK),
// exactement comme AgentPermission.agentId ci-dessus (B20). AgentIdentity
// reste l'UNIQUE source de vérité pour l'identité d'un agent.
//
// PAS DE BACKFILL NÉCESSAIRE (écart documenté avec la directive B18-FIX,
// signalé explicitement plutôt que décidé silencieusement) : RapportAgent
// n'a jamais existé sur main — l'ancienne branche b18-registre-rapports
// n'a jamais été fusionnée, donc aucune donnée de production ne référence
// l'ancien enum AgentEmetteur. La discipline "migration additive avec
// backfill déterministe, puis migration destructive séparée" demandée
// s'applique au scénario où B18 aurait déjà été fusionnée avec
// agentEmetteur en production — ce n'est pas le cas ici. Construire
// directement avec la FK agentId est donc la migration complète et
// correcte en une seule étape (voir prisma/migrations/.../migration.sql),
// sans dette à résorber plus tard. Voir le rapport final B18-FIX, section
// "écart avec la directive", pour la justification complète.
//
// Le reste de la conception de B18 (table séparée d'EvenementSecurite
// pour ne pas fausser les signaux runtime B16/B17, correlationId réutilisé
// tel quel, best-effort jamais bloquant, UNKNOWN explicite, plafonnement
// des champs texte) est inchangé — voir lib/gouvernance/rapports.ts.
//
// CE QUE CETTE RECONSTRUCTION NE RÉSOUT PAS : le risque d'impersonation
// déjà documenté dans l'audit B18 (POST accepte un agentId choisi par
// l'appelant ADMIN humain, sans vérifier que cet appelant EST réellement
// l'agent désigné) reste ouvert — aucune authentification agent réelle
// n'existe encore dans COMPANY ATLAS. Explicitement hors périmètre de ce
// lot B18-FIX (directive : "ne pas implémenter l'authentification réelle
// des agents dans ce lot").
enum StatutRapportAgent {
  COMPLETE
  PARTIEL
  BLOQUE
  REFUSE
}

model RapportAgent {
  id            String @id @default(cuid())
  correlationId String // regroupe les rapports d'une même chaîne d'exécution — même mécanisme que EvenementSecurite (lib/security/events.ts)

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id])

  typeRapport String // vocabulaire fermé côté lib/gouvernance/rapports.ts (TYPES_RAPPORT)
  objectif    String
  analyse     String?
  actions     String?
  risques     String?
  statut      StatutRapportAgent
  inconnu     String? // UNKNOWN explicite (Charte F.1) — jamais déduit, jamais omis silencieusement
  contexte    String?
  severite    SeveriteEvenementSecurite @default(INFO) // réutilise l'enum existant (B16) plutôt que d'en dupliquer un — même discipline que le reste de ce fichier

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([correlationId])
  @@index([agentId])
}

// ============================================================================
// COMPANY ATLAS — B21 (13/09/2026) : STRATEGIC INTELLIGENCE FOUNDATION.
// Capacité transverse aux 4 agents officiels (AgentIdentity, B19) —
// PAS un 5e agent (directive B21, règle absolue 1). Cycle cible : Veille ->
// Signal -> Analyse -> Opportunité/Menace -> Proposition -> Autorisation ->
// Action autorisée -> Contrôle -> Résultat -> Rapport -> Suivi.
// Voir lib/strategic/domain.ts pour le détail complet des règles et
// limites documentées (aucun Authorization Engine complet, aucun LLM
// autonome, aucun RAG, aucun scraping massif, aucune action externe
// autonome, jamais d'auto-autorisation).

enum StrategicCategory {
  MARKET
  COMPETITOR
  TECHNOLOGY
  CLIENT
  COMMERCIAL
  PRODUCT
  REGULATION
  SECURITY
  FINANCE
  OPERATIONS
  INNOVATION
}

enum StrategicPriority {
  P0_CRITICAL
  P1_STRATEGIC
  P2_IMPORTANT
  P3_MONITOR
}

enum StrategicSignalStatut {
  NOUVEAU
  ANALYSE
  CLOS
}

// Cycle : PROPOSEE -> [AUTORISATION_DEMANDEE] -> AUTORISEE | REFUSEE ->
// EXECUTEE -> CONTROLEE. Voir lib/strategic/propositions.ts (peutExecuter) :
// une proposition REFUSEE ou jamais autorisée ne peut jamais devenir
// EXECUTEE.
enum StrategicProposalStatut {
  PROPOSEE
  AUTORISATION_DEMANDEE
  AUTORISEE
  REFUSEE
  EXECUTEE
  CONTROLEE
}

model StrategicSignal {
  id            String @id @default(cuid())
  correlationId String // même mécanisme que EvenementSecurite/RapportAgent (lib/security/events.ts)

  categorie   StrategicCategory
  source      String // déclaratif, court (ex. "veille manuelle — communiqué concurrent X") — jamais une URL récupérée en masse (pas de scraping, directive B21)
  titre       String
  description String?
  statut      StrategicSignalStatut @default(NOUVEAU)

  createdAt DateTime @default(now())

  analyses StrategicAnalysis[]

  @@index([createdAt])
  @@index([categorie])
  @@index([correlationId])
}

model StrategicAnalysis {
  id            String @id @default(cuid())
  correlationId String

  signalId String
  signal   StrategicSignal @relation(fields: [signalId], references: [id])

  constat   String // fait observé appuyé sur le signal — evidence-first, jamais une affirmation sans preuve
  preuves   String?
  hypothese String? // hypothèse distincte du fait constaté — jamais présentée comme confirmée
  inconnu   String? // UNKNOWN explicite (Charte F.1) — jamais déduit, jamais omis silencieusement

  createdAt DateTime @default(now())

  opportunites    StrategicOpportunity[]
  menaces         StrategicThreat[]
  recommandations StrategicRecommendation[]

  @@index([createdAt])
  @@index([signalId])
  @@index([correlationId])
}

model StrategicOpportunity {
  id            String            @id @default(cuid())
  correlationId String // B21.1 (M3) — propagé depuis StrategicAnalysis.correlationId (jamais fourni par l'appelant), même mécanisme transverse que StrategicSignal/StrategicAnalysis (lib/security/events.ts)
  analysisId    String
  analysis      StrategicAnalysis @relation(fields: [analysisId], references: [id])

  description String
  priorite    StrategicPriority // toujours saisie par l'appelant humain — jamais calculée/déduite ici

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([priorite])
  @@index([correlationId])
}

model StrategicThreat {
  id            String            @id @default(cuid())
  correlationId String // B21.1 (M3) — propagé depuis StrategicAnalysis.correlationId
  analysisId    String
  analysis      StrategicAnalysis @relation(fields: [analysisId], references: [id])

  description String
  priorite    StrategicPriority

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([priorite])
  @@index([correlationId])
}

model StrategicRecommendation {
  id            String            @id @default(cuid())
  correlationId String // B21.1 (M3) — propagé depuis StrategicAnalysis.correlationId
  analysisId    String
  analysis      StrategicAnalysis @relation(fields: [analysisId], references: [id])

  recommandation String
  priorite       StrategicPriority

  createdAt DateTime @default(now())

  propositions StrategicActionProposal[]

  @@index([analysisId])
  @@index([priorite])
  @@index([correlationId])
}

model StrategicActionProposal {
  id            String @id @default(cuid())
  correlationId String

  recommendationId String
  recommendation   StrategicRecommendation @relation(fields: [recommendationId], references: [id])

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id])

  actionProposee String
  perimetre      String? // scope proposé par l'agent — n'engage rien tant qu'aucune StrategicAuthorization n'existe
  statut         StrategicProposalStatut @default(PROPOSEE)

  createdAt DateTime @default(now())

  autorisation       StrategicAuthorization?
  authorizationLinks StrategicAuthorizationLink[]

  @@index([createdAt])
  @@index([agentId])
  @@index([correlationId])
}

model StrategicAuthorization {
  id            String @id @default(cuid())
  correlationId String

  proposalId String                  @unique // une seule autorisation par proposition — jamais réutilisée pour une autre action
  proposal   StrategicActionProposal @relation(fields: [proposalId], references: [id])

  autorisateurEmail String // TOUJOURS dérivé de la session ADMIN authentifiée côté serveur (jamais du corps de la requête) — voir app/api/strategic/propositions/[id]/autoriser/route.ts. Aucun agent n'a de session (limite héritée B19/B20) : structurellement jamais un agent ici. Règle "ne jamais s'auto-autoriser" (directive B21).
  scope             String
  duree             String // durée de validité déclarée (texte court) — pas de moteur d'expiration automatique (Authorization Engine complet hors périmètre B21)
  budget            String?
  limites           String?

  dateAutorisation DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([correlationId])
}

// COMPANY ATLAS — B24 Lot A (14/09/2026) : fondation schéma uniquement pour
// la future consolidation B21 → B22 (design verrouillé B24 Phase 2/2.1/2.2 —
// audit read-only, aucune décision métier prise ici). Établit UNIQUEMENT la
// relation historique StrategicActionProposal ↔ AuthorizationRequest.
// AUCUN comportement applicatif nouveau dans ce lot (aucune route, aucun
// flux de création, B21/B22/B23 strictement inchangés dans leur logique).
//
// Cardinalité 1 → N (StrategicActionProposal 1 → N StrategicAuthorizationLink)
// : proposalId n'est PAS unique — une proposition peut accumuler plusieurs
// demandes successives au fil du temps (EXPIRED, REVOKED, DENY, ALLOW...),
// l'historique n'est jamais écrasé (directive B24 Phase 2.1, décision CEO 3).
//
// authorizationRequestId est une référence TEXTE, volontairement PAS une
// relation/FK Prisma vers AuthorizationRequest (B22) — même discipline que
// AuditEvent.objectId ("polymorphe par construction... jamais par une FK").
// Objectif : AuthorizationRequest (B22) reste totalement générique et
// indépendant de ses domaines consommateurs (directive B24 Phase 2.1,
// décision CEO 2 — "ne pas ajouter de champ spécifique strategicProposalId
// dans AuthorizationRequest, le consommateur B21 porte la relation").
// @@unique([authorizationRequestId]) : une AuthorizationRequest ne peut être
// liée qu'à une seule proposition (protection contre un lien frauduleux
// vers l'AuthorizationRequest d'une autre proposition — B24 Phase 2.2,
// section 3, question 9/11).
//
// AUCUN champ status/decision/authorizationStatus/pending/approved/rejected
// ici, et AUCUN champ action/scope/risk/maxAutonomyLevel — interdiction
// absolue de dupliquer l'état B22 (directive B24 Lot A, section 4).
// L'état réel reste exclusivement AuthorizationRequest.status/.decision —
// ce modèle établit uniquement la relation historique, jamais un second
// registre d'état.
model StrategicAuthorizationLink {
  id            String @id @default(cuid())
  correlationId String

  proposalId String
  proposal   StrategicActionProposal @relation(fields: [proposalId], references: [id])

  authorizationRequestId String

  createdAt DateTime @default(now())

  @@unique([authorizationRequestId])
  @@index([proposalId])
  @@index([authorizationRequestId])
  @@index([correlationId])
}

// ============================================================================
// COMPANY ATLAS — B22 (14/09/2026) : AUTONOMY + DECISION + DELEGATION
// CONTROL PLANE. Fondation uniquement (directive B22, section 2) : pose le
// raisonnement (Decision/DecisionOption), l'octroi de pouvoir borné
// (Delegation) et la porte d'autorisation (AuthorizationRequest), jamais un
// moteur d'exécution universel — l'exécution réelle reste dans chaque
// module métier (ex. lib/strategic/*), comme aujourd'hui.
//
// RÉUTILISE STRICTEMENT B19/B20 : AgentIdentity reste l'unique source de
// vérité d'identité, AgentPermission l'unique source de vérité de
// permission — aucun 5e agent, aucun second registre. Chaque agentId
// ci-dessous est une FK vers AgentIdentity.id. Une Delegation ne peut
// jamais accorder plus qu'une AgentPermission ACTIVE existante (vérifié à
// la création ET à chaque évaluation d'AuthorizationRequest — jamais en
// cache, voir lib/control-plane/*.ts).
//
// LIMITE ARCHITECTURALE CONNUE (documentée, pas introduite par B22) :
// l'agentId porté par une Decision/Delegation/AuthorizationRequest est
// choisi par un ADMIN authentifié — ce n'est PAS une authentification
// agent réelle (aucune session/preuve cryptographique agent n'existe,
// limite héritée B19/B20/B21). Une future authentification agent réelle
// pourra remplacer la provenance de ce champ sans créer de nouvelle table
// d'identité.
//
// RiskLevel : JAMAIS calculé automatiquement — toujours déclaré par un
// humain (Delegation) ou un agent (AuthorizationRequest) avec justification
// texte non vide (vérifié en code, même discipline que identifierRisqueManuel,
// B13). UNKNOWN n'existe PAS dans cette échelle ordonnée (voir
// EvidenceQuality pour l'état "preuve manquante", géré séparément).
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Déterminé UNIQUEMENT côté serveur par le registre fermé
// lib/control-plane/commitment.ts — jamais fourni par le client/agent.
// Action inconnue du registre -> COMMITMENT par défaut (fail-closed),
// jamais OBSERVATION.
enum ActionClass {
  OBSERVATION
  INTERNAL_ACTION
  EXTERNAL_ACTION
  COMMITMENT
}

// L5/L6 existent pour compatibilité future — aucune route B22 ne peut les
// accorder : toute AuthorizationRequest avec requestedAutonomyLevel > L4
// est refusée (400) avant toute écriture.
enum AutonomyLevel {
  L0_OBSERVE
  L1_ANALYZE
  L2_RECOMMEND
  L3_PREPARE
  L4_EXECUTE_WITH_APPROVAL
  L5_EXECUTE_WITH_GUARDRAILS
  L6_AUTONOMOUS
}

// Purement informatif — jamais consulté par la logique de décision
// d'autorisation (AuthorizationDecision ci-dessous). Aucun veto automatique
// de l'image de marque contre le CEO (directive B22, section 10).
enum BrandImpact {
  POSITIVE
  NEUTRAL
  NEGATIVE
  CRITICAL
  UNKNOWN
}

// DENY réservé aux cas où une règle réelle interdit l'action (permission
// absente/désactivée, agent inactif, délégation dépassée/expirée/révoquée,
// emergency stop actif) — jamais une simple recommandation défavorable.
enum AuthorizationDecision {
  ALLOW
  APPROVAL_REQUIRED
  RESTRICT
  DENY
}

// Purement explicatif/traçable (Why Engine) — ne remplace jamais
// AuthorizationDecision, ne décide jamais rien par lui-même.
enum HumanNecessityLevel {
  H0
  H1
  H2
  H3
  H4
}

enum EmergencyStopScope {
  GLOBAL
  AGENT
  ACTION_CLASS
  CAPABILITY
  INTEGRATION
  DELEGATION
  MISSION
}

// Ajout justifié (Phase 3-FIX, point 3) : nécessaire au matching
// déterministe de calculerHumanNecessite (lib/control-plane/human-necessity.ts)
// — un texte libre ne peut pas être filtré de façon fiable par une table de
// règles fermée. N'est PAS un score, ne produit jamais seul un ALLOW.
// UNKNOWN n'est jamais traité comme une preuve suffisante et augmente
// mécaniquement le niveau de Human Necessity requis.
enum EvidenceQuality {
  VERIFIED
  DECLARED
  UNKNOWN
}

enum DecisionStatus {
  OPEN
  RECOMMENDED
  CANCELLED
}

// Volontairement 2 valeurs seulement — "expirée" est un état CALCULÉ
// (expiresAt < now()), jamais stocké : une 3e valeur nécessiterait une
// tâche planifiée et risquerait de mentir tant qu'elle n'est pas passée.
enum DelegationStatus {
  ACTIVE
  REVOKED
}

enum AuthorizationRequestStatus {
  PENDING
  RESOLVED
  EXPIRED
  REVOKED
}

// Polymorphe par construction (directive B22, section 4) — AuditEvent ne
// référence ces objets que par (objectType, objectId), jamais par une FK
// stricte (Prisma ne supporte pas les FK polymorphes nativement).
enum AuditObjectType {
  DECISION
  DECISION_OPTION
  DELEGATION
  AUTHORIZATION_REQUEST
  EMERGENCY_STOP
  // B24 Lot A (14/09/2026) : ajout schéma-only pour la future traçabilité
  // B21 → B22 (design verrouillé B24 Phase 2.2, section 7 — Option B
  // recommandée, usage natif du mécanisme polymorphe objectType/objectId
  // déjà prévu par ce schéma). Aucun code n'émet encore cet objectType dans
  // ce lot — valeur ajoutée seule, aucun comportement nouveau.
  STRATEGIC_ACTION_PROPOSAL
}

// Le problème décisionnel. Ne possède AUCUN droit d'action — une
// Decision ne modifie jamais rien hors d'elle-même et de ses options.
model Decision {
  id            String @id @default(cuid())
  correlationId String // validé via estCorrelationIdValide (lib/strategic/domain.ts) — ≤300 inchangé, >300 refusé (400), jamais tronqué

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  objective String
  context   String?

  options             DecisionOption[] @relation("DecisionOptions")
  recommendedOptionId String?
  recommendedOption   DecisionOption?  @relation("DecisionRecommendedOption", fields: [recommendedOptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  confidence     Float? // déclaratif uniquement (0.0-1.0, validé en code) — ne transforme jamais seul une décision en ALLOW
  humanNecessity HumanNecessityLevel? // snapshot au moment de la recommandation — jamais copié vers AuthorizationRequest, toujours recalculé

  status DecisionStatus @default(OPEN)

  createdBy String // TOUJOURS session.email, jamais le corps de la requête
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizationRequests AuthorizationRequest[]

  @@index([agentId])
  @@index([correlationId])
  @@index([status])
  @@index([createdAt])
}

// Une alternative parmi plusieurs pour une Decision. Dimensions
// explicites, JAMAIS de score/rank calculé automatiquement (directive B22,
// section 7/8) — un humain lit chaque dimension séparément.
model DecisionOption {
  id            String @id @default(cuid())
  correlationId String // toujours copié serveur depuis Decision.correlationId, jamais du body

  decisionId            String
  decision              Decision   @relation("DecisionOptions", fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decisionsRecommandant Decision[] @relation("DecisionRecommendedOption")

  label       String
  description String

  businessImpact  String? // informatif, jamais un score
  financialImpact String? // informatif, jamais un montant calculé (voir Delegation.maxAmount pour le seul champ numérique qui gate réellement)
  strategicImpact String?
  clientImpact    String?
  brandImpact     BrandImpact? // informatif, jamais un veto (directive B22, section 10)

  riskLevel         RiskLevel? // déclaré + justifié, jamais calculé
  riskJustification String? // requis en code si riskLevel non nul
  reversibility     String? // qualitatif libre — volontairement pas un enum supplémentaire (non demandé explicitement, voir Phase 3)
  evidenceQuality   EvidenceQuality @default(UNKNOWN) // jamais un null implicite (Charte F.1 : UNKNOWN toujours explicite)

  createdAt DateTime @default(now())

  @@index([decisionId])
  @@index([riskLevel])
  @@index([correlationId])
}

// Un pouvoir explicitement confié par le CEO (ADMIN) à un agent, dans un
// périmètre défini — jamais automatique, jamais permanent. Ne peut JAMAIS
// accorder plus qu'une AgentPermission ACTIVE existante (vérifié à la
// création ET relu, jamais en cache, à chaque évaluation d'AuthorizationRequest
// — voir lib/control-plane/delegations.ts).
model Delegation {
  id            String @id @default(cuid())
  correlationId String

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  action      AgentPermissionAction // vocabulaire B20 réutilisé — aucun nouveau vocabulaire d'action
  scope       AgentPermissionScope // vocabulaire B20 réutilisé
  resource    String?
  objective   String
  actionClass ActionClass

  // NULL != illimité (directive B22/Phase 3-FIX, point 5) : NULL signifie
  // "cette délégation ne couvre pas cette dimension", jamais "sans limite".
  // Voir lib/control-plane/delegations.ts (estDelegationCouvrante).
  maxAmount    Float?
  maxRiskLevel RiskLevel?
  conditions   String? // texte libre — volontairement pas un moteur de règles structuré

  startsAt  DateTime         @default(now())
  expiresAt DateTime // OBLIGATOIRE — aucune délégation permanente implicite
  status    DelegationStatus @default(ACTIVE)

  createdBy String // TOUJOURS session.email, jamais le corps de la requête
  revokedAt DateTime?
  revokedBy String? // TOUJOURS session.email d'un ADMIN, jamais l'agent lui-même

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizationRequests AuthorizationRequest[]

  @@index([agentId])
  @@index([status])
  @@index([expiresAt])
  @@index([correlationId])
}

// Modèle FUSIONNÉ (directive B22 : pas de AuthorizationDecision ni
// HumanApproval séparés) — même pattern déjà en production que
// PropositionSecurite (B16) : une seule ligne, statut + champs de
// résolution inline, jamais réémise. Ne peut jamais dépasser AgentIdentity/
// AgentPermission/Delegation/EmergencyStop (voir lib/control-plane/authorization.ts).
model AuthorizationRequest {
  id            String @id @default(cuid())
  correlationId String

  agentId String
  agent   AgentIdentity @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  action      AgentPermissionAction
  actionClass ActionClass // TOUJOURS recalculé serveur (lib/control-plane/commitment.ts) — jamais accepté du client
  scope       AgentPermissionScope
  resource    String?
  objective   String
  reason      String

  riskLevel              RiskLevel? // déclaré + justifié
  riskJustification      String?
  amount                 Float? // montant demandé, uniquement si l'action porte un engagement financier — comparé à Delegation.maxAmount (NULL = jamais couvert, voir estDelegationCouvrante)
  requestedAutonomyLevel AutonomyLevel // > L4 refusé (400) avant toute écriture — voir la route

  decisionId   String?
  decisionRef  Decision?   @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delegationId String?
  delegation   Delegation? @relation(fields: [delegationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status         AuthorizationRequestStatus @default(PENDING)
  decision       AuthorizationDecision? // verdict courant — système ("system") puis, si besoin, humain (session.email) ; même champ écrasé en place, jamais réémis après RESOLVED
  decisionReason String? // requis en code si decision non nul
  humanNecessity HumanNecessityLevel? // recalculé ici, jamais copié depuis Decision
  decidedBy      String? // "system" (évaluation automatique) ou session.email (résolution humaine) — jamais un agent
  approvedBy     String? // renseigné uniquement si la résolution humaine finale est ALLOW
  approvedAt     DateTime?

  // OBLIGATOIRE, calculé serveur = requestedAt + 72h — jamais fourni par le
  // client, jamais prolongé (Phase 3-FIX, point 5). Une nouvelle fenêtre
  // exige une nouvelle AuthorizationRequest.
  expiresAt DateTime

  requestedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([decisionId])
  @@index([delegationId])
  @@index([correlationId])
  @@index([expiresAt])
}

// Mandat STRICT : trace uniquement le cycle de vie des 5 objets B22
// ci-dessus. Ne remplace NI ne duplique RapportAgent (B18-FIX)/
// EvenementSecurite (B16)/JournalActivite — chacun garde son domaine
// exclusif (directive B22, section 14). Append-only : aucune route
// PATCH/DELETE (même discipline que AgentIdentity/AgentPermission —
// aucune mutation possible en dehors de la création).
model AuditEvent {
  id            String @id @default(cuid())
  correlationId String

  objectType AuditObjectType
  objectId   String // volontairement PAS une FK — polymorphe par construction

  action   String // court, plafonné — ex. "created", "revoked", "decided:ALLOW"
  decision AuthorizationDecision?
  actor    String // "system" ou session.email — jamais une prétention d'agent
  agentId  String?
  agent    AgentIdentity?         @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reason   String?
  metadata Json? // jamais de secret/token/mot de passe — même discipline que EvenementSecurite.detail

  timestamp DateTime @default(now())

  @@index([objectType, objectId])
  @@index([correlationId])
  @@index([agentId])
  @@index([timestamp])
}

// Arrêt d'urgence — prioritaire sur toute évaluation ou approbation
// d'AuthorizationRequest, y compris une tentative humaine d'ALLOW.
// Activation/levée réservées ADMIN, jamais un agent. "Actif" ⇔
// liftedAt IS NULL — pas de champ status séparé (une seule source de
// vérité, évite toute désynchronisation).
model EmergencyStop {
  id            String @id @default(cuid())
  correlationId String

  scope    EmergencyStopScope
  targetId String? // requis en code si scope != GLOBAL (contrôle applicatif, pas une contrainte DB)
  reason   String

  activatedBy String // TOUJOURS session.email d'un ADMIN, jamais un agent
  activatedAt DateTime  @default(now())
  liftedBy    String?
  liftedAt    DateTime?

  @@index([scope, targetId])
  @@index([correlationId])
  @@index([liftedAt])
}

model Client {
  id                    String           @id @default(cuid())
  nom                   String // raison sociale
  pays                  String? // pays d'implantation du client (affiché dans l'historique de mission ingénieur, et sert à terme au calendrier de jours fériés des feuilles de temps)
  secteur               String?
  contactReferent       String? // nom de la personne de contact côté client
  email                 String?
  telephone             String?
  identifiantEntreprise String? // RC / RNE selon le pays
  formeJuridique        String? // SARL, SA, EURL, Auto-entrepreneur, etc.
  statutPreferere       TypeContrat?
  dateDebutPrevue       DateTime?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  missions              Mission[]
  documents             Document[]
  compte                User? // le compte de connexion du client, une fois inscrit
  demandesTalent        DemandeTalent[] // ATLAS TALENT (fondations, 06/09) — voir DemandeTalent
  clientNeeds           ClientNeed[] // Client Need Intelligence (LOT 2, 15/09) — voir ClientNeed
  clientProfile         ClientProfile? // Profil Client durable (LOT 4, 15/09) — voir ClientProfile
  messages              Message[] // CLIENT COMPLETION PROGRAM — C8 (16/09/2026) — voir Message
  solutionOptions       SolutionOption[] // V2.1-A — C3 Solution Intelligence (16/09/2026) — voir SolutionOption
  factures              Facture[] // V2.2-B — Billing Foundation (17/09/2026) — voir Facture
}

// Fiche interne d'un profil d'ingénieur. Créée automatiquement, vide de
// tarif, quand un ingénieur s'inscrit. Le type de contrat, le montant et le
// TJM ne sont plus fixés manuellement par l'Admin à la validation : ils sont
// déterminés après import + validation du CV (voir InfoCV), sur la base de
// l'analyse du profil (séniorité, compétences) — voir lib/analyse-profil.ts.
model Profil {
  id           String       @id @default(cuid())
  nom          String // nom de famille (avant la refonte, contenait le nom complet — voir prenom)
  prenom       String? // prénom, saisi séparément à l'inscription depuis la refonte du 4 sept.
  type         TypeContrat?
  montantSaisi Float? // laissé vide jusqu'à ce qu'un contrat soit négocié

  cvUrl        String?
  cvNomFichier String?
  cvImporteLe  DateTime?
  cvValide     Boolean   @default(false)

  anneesExperience   Int?
  seniorite          String?
  pointsForts        String?
  tjmEstime          Float?
  typeContratSuggere TypeContrat?

  disponibilite             String?
  disponibilitePrevue       String?
  changerMissionActuelle    Boolean?
  missionApres              String?
  preavis                   String?
  preavisPrecision          String?
  disponibiliteRenseigneeLe DateTime?
  questionnaireValide       Boolean   @default(false)

  nationalite            String?
  nationalitePrecision   String?
  paysResidence          String?
  paysResidencePrecision String?
  regimeSuggere          String?

  tjmSouhaite       Float?
  tjmSouhaiteDevise String?

  competences String[] @default([])

  entretiensRealises Int @default(0)

  realisations Json?

  videoUrl        String?
  videoNomFichier String?
  videoImporteLe  DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  missions         Mission[]
  infosCv          InfoCV[]
  versionsCv       VersionCv[]
  compte           User?
  shortlistEntrees ShortlistEntree[]
  competencesGraph ProfilCompetence[]
}

model VersionCv {
  id           String   @id @default(cuid())
  profil       Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId     String
  cvUrl        String
  cvNomFichier String?
  importeLe    DateTime
  createdAt    DateTime @default(now())

  @@index([profilId])
}

model InfoCV {
  id        String   @id @default(cuid())
  profil    Profil   @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId  String
  categorie String
  libelle   String
  valeur    String
  ordre     Int      @default(0)
  valide    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Mission {
  id              String           @id @default(cuid())
  repere          String?
  client          Client           @relation(fields: [clientId], references: [id])
  clientId        String
  profil          Profil           @relation(fields: [profilId], references: [id])
  profilId        String
  nbJours         Int
  margeCible      Float            @default(0.30)
  tjmVente        Float
  deviseVente     String           @default("EUR")
  statut          String           @default("En cours") // En cours / Terminée / Annulée
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  feuillesDeTemps FeuilleDeTemps[]
  evaluation      Evaluation?

  // COMPANY ATLAS — LOT 6 : Mission Context Bridge (16/09/2026).
  //
  // Traçabilité UNIQUEMENT vers la DemandeTalent d'origine — jamais une
  // copie de ses critères (ceux-ci restent exclusivement dans
  // DemandeTalent, jamais dupliqués ici). Volontairement PAS @unique :
  // une même DemandeTalent peut donner lieu à plusieurs Mission (ex.
  // deux ingénieurs affectés, ou une nouvelle mission après renouvellement)
  // — voir revue architecturale, jamais supposer 1 demande = 1 mission.
  // Nullable : la quasi-totalité des Mission existantes (créées
  // manuellement par l'Admin avant ce lot, et la plupart après) n'ont pas
  // de demande source.
  sourceDemande   DemandeTalent? @relation(fields: [sourceDemandeId], references: [id])
  sourceDemandeId String?

  // Contexte opérationnel réellement décidé pour cette intervention —
  // jamais une seconde source de vérité pour le besoin (celui-ci reste
  // dans ClientNeed/DemandeTalent). Pré-remplis depuis la DemandeTalent
  // source à la création (dateDebutSouhaitee/mobilite), mais toujours
  // modifiables par l'Admin ensuite : ce sont ici les valeurs RÉELLEMENT
  // retenues pour la mission, pas une simple recopie figée.
  dateDebut   DateTime?
  dateFin     DateTime?
  // Même vocabulaire fermé que DemandeTalent.mobilite (Remote/Hybride/Sur
  // site) — jamais un second vocabulaire. dateFin/modeTravail restent NULL
  // (UNKNOWN explicite) tant que non décidés : jamais une valeur devinée.
  modeTravail String?

  factures Facture[] // V2.2-B — Billing Foundation (17/09/2026) — voir Facture

  @@index([sourceDemandeId])
}

model FeuilleDeTemps {
  id                    String    @id @default(cuid())
  mission               Mission   @relation(fields: [missionId], references: [id])
  missionId             String
  mois                  String // format "AAAA-MM"
  joursTravailles       Float     @default(0)
  heuresSupplementaires Float     @default(0)
  commentaire           String?
  detailJours           Json?
  statut                String    @default("Brouillon")
  motifRejet            String?
  soumiseLe             DateTime?
  valideeAdminLe        DateTime?
  valideeClientLe       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // V2.2-B — Billing Foundation (17/09/2026) : une FeuilleDeTemps donne lieu
  // à au plus une Facture (voir Facture.feuilleDeTempsId, @unique côté
  // Facture) — jamais plusieurs factures pour la même période/mission.
  facture               Facture?

  @@unique([missionId, mois])
}

model Evaluation {
  id          String   @id @default(cuid())
  mission     Mission  @relation(fields: [missionId], references: [id])
  missionId   String   @unique
  note        Int
  commentaire String?
  createdAt   DateTime @default(now())
}

model Document {
  id        String         @id @default(cuid())
  titre     String
  type      StatutDocument @default(AUTRE)
  fileUrl   String
  mission   Mission?       @relation(fields: [missionId], references: [id])
  missionId String?
  client    Client         @relation(fields: [clientId], references: [id])
  clientId  String
  createdAt DateTime       @default(now())
  // V2.2-B — Billing Foundation (17/09/2026) : PDF de facture, une fois
  // généré, persisté ici comme n'importe quel autre Document (même
  // infrastructure de stockage privé, lib/storage.ts — jamais un second
  // système). Back-relation requise par Prisma pour Facture.documentId,
  // aucun champ existant modifié.
  facture   Facture?
}

// CLIENT COMPLETION PROGRAM — C8 : Communication (16/09/2026).
//
// Fil de discussion Client <-> ATLAS, scopé par client — jamais de
// threading, jamais de destinataire individuel (audit confirmé : aucun
// mécanisme de messagerie/notification/conversation n'existait avant ce
// lot, seul lib/email.ts, un canal transactionnel à sens unique). auteurRole
// est un vocabulaire fermé DÉDIÉ (jamais le Role général de User, qui inclut
// INGENIEUR) : un Ingénieur ne peut structurellement jamais être auteur d'un
// message — pas seulement une vérification applicative. Historique
// intégralement additif (aucune édition, aucune suppression en V1).
enum MessageAuteurRole {
  CLIENT
  ADMIN
}

model Message {
  id         String            @id @default(cuid())
  client     Client            @relation(fields: [clientId], references: [id])
  clientId   String
  auteurRole MessageAuteurRole
  contenu    String
  createdAt  DateTime          @default(now())

  @@index([clientId])
}

model DemandeContact {
  id              String   @id @default(cuid())
  nom             String
  email           String
  entreprise      String?
  telephone       String?
  message         String?
  creneauSouhaite String?
  traite          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Hypotheses {
  id             String @id @default("singleton")
  joursAn        Int    @default(218)
  chargesSalarie Float  @default(0.42)
  fraisFreelance Float  @default(0.08)
  overhead       Float  @default(0.15)
  margeDefaut    Float  @default(0.30)
}

// ============================================================================
