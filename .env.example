# --- Database ---
# PostgreSQL (Supabase, Neon, Render... au choix). Seule variable de
# connexion lue par Prisma (voir prisma/schema.prisma) — aucun directUrl.
DATABASE_URL="postgresql://user:password@host:5432/atlas_admin"

# --- Authentication ---
# Secret de session — générez-en un avec : openssl rand -base64 32
# Obligatoire (voir lib/session-secret.ts) : absent/vide/whitespace fait
# volontairement échouer le chargement de l'application plutôt que de
# tourner avec une clé de signature vide.
SESSION_SECRET="changez-moi-en-une-longue-chaine-aleatoire"
# Optionnel : ancienne valeur de SESSION_SECRET pendant une rotation (voir
# lib/session-secret.ts) — les sessions déjà émises restent valides jusqu'à
# expiration (8h max) le temps que SESSION_SECRET change partout.
# SESSION_SECRET_PREVIOUS=""

# --- Storage (CV / vidéo de présentation, voir lib/storage.ts) ---
# --- Variables optionnelles : la plateforme fonctionne sans, en mode dégradé ---

# Nécessite un Blob store PRIVÉ connecté au projet Vercel (Storage ->
# Create Database -> Blob -> Access: Private -> Connect to Project) : la
# variable est alors créée automatiquement, jamais à saisir manuellement.
# Sans elle, l'upload de CV/vidéo échoue explicitement ; le reste du site
# fonctionne normalement.
# BLOB_READ_WRITE_TOKEN=""

# --- AI (extraction du CV à l'import, voir lib/cv-extraction.ts) ---

# Sans clé, l'extraction échoue proprement : les champs restent vides à
# saisir manuellement, l'import du CV n'est jamais bloqué pour autant.
# ANTHROPIC_API_KEY="sk-ant-..."
# Nom du provider IA à utiliser (voir lib/ai/provider.ts) — une valeur
# inconnue retombe sur le provider local avec un simple avertissement,
# jamais une erreur.
# AI_PROVIDER="anthropic"

# --- Email transactionnel (voir lib/email.ts, lib/message-attention-email.ts) ---

# Notifications email transactionnelles — sans clé, les emails sont
# simplement affichés dans les logs (console.log) au lieu d'être réellement
# envoyés. Clé obtenue sur resend.com.
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="Atlas Quality Partners <contact@atlas-qa.com>"

# Base URL applicative utilisée pour construire les liens envoyés par email
# (vérification d'adresse, réinitialisation de mot de passe, connexion après
# validation de compte, notification de message non lu). Comportement
# fail-closed partout : absente, vide ou composée uniquement d'espaces,
# aucun email concerné n'est envoyé (jamais un lien vers un domaine de
# démonstration tiers).
# EMAIL_APP_BASE_URL="https://your-production-domain.example"

# Secret partagé protégeant POST /api/internal/interview-reminders/process
# (en-tête HTTP "x-internal-secret") — traitement des rappels d'entretien
# dus (ATLAS CANDIDATE DECISION + INTERVIEW). Absente ou vide : endpoint
# désactivé en fail-closed (403 systématique), aucun rappel n'est jamais
# envoyé. Doit être appelé périodiquement par un mécanisme de cron
# réellement configuré côté hébergement (ex. Vercel Cron) — cet endpoint ne
# déclenche rien par lui-même.
# INTERVIEW_REMINDER_INTERNAL_SECRET="generate-a-long-random-secret"

# --- Monitoring (Sentry, voir instrumentation.ts) ---

# Monitoring d'erreurs — sans DSN, Sentry reste totalement inactif (aucun
# appel réseau). DSN obtenu sur sentry.io.
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# --- Quality / GitHub (voir app/api/quality/route.ts) ---

# Dépôt GitHub interrogé par le tableau de bord Qualité. Sans ces
# variables, retombe sur le dépôt de ce projet lui-même (valeur par défaut
# codée en dur dans app/api/quality/route.ts).
# ATLAS_QUALITY_REPO_OWNER="votre-organisation-github"
# ATLAS_QUALITY_REPO_NAME="votre-repo"

# --- Rate limiting (voir lib/rate-limit.ts) ---

# Nombre maximal de tentatives de connexion par IP sur une fenêtre de 15
# minutes (toutes adresses email confondues). Défaut 20 si absente — ne
# jamais relever cette valeur en production réelle ; uniquement relevée en
# CI (voir .github/workflows/ci.yml) où toutes les requêtes de test
# partagent la même IP locale.
# RATE_LIMIT_LOGIN_MAX_IP="20"
